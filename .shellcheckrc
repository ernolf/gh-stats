#
# Both are idioms the scripts use on purpose: "a && b || c" where c is the
# fallback for either of them failing (SC2015), and jq, awk and SQL programs
# passed in single quotes so the shell leaves their $ alone (SC2016).
disable=SC2015,SC2016
