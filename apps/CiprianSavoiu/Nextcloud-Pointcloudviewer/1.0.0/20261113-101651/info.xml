<?xml version="1.0"?>
<info xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>pointcloudviewer</id>
    <name>Point Cloud Viewer</name>
    <summary>View LAS/LAZ point cloud files</summary>
    <description>A viewer for LAS and LAZ point cloud files using Three.js</description>
    <version>1.0.0</version>
    <licence>agpl</licence>
    <author>Your Name</author>
    <namespace>PointCloudViewer</namespace>
    <category>files</category>
    <website>https://github.com/yourusername/pointcloudviewer</website>
    <bugs>https://github.com/yourusername/pointcloudviewer/issues</bugs>
    <repository>https://github.com/yourusername/pointcloudviewer</repository>
    <screenshot>https://raw.githubusercontent.com/yourusername/pointcloudviewer/master/screenshots/screenshot.png</screenshot>
    <dependencies>
        <nextcloud min-version="25" max-version="30"/>
    </dependencies>
    <repair-steps>
        <post-migration>
            <step>OCA\PointCloudViewer\Migration\InstallStep</step>
        </post-migration>
    </repair-steps>

    <!-- Content Security Policy Settings -->
    <settings>
        <admin>OCA\PointCloudViewer\Settings\Admin</admin>
        <admin-section>OCA\PointCloudViewer\Settings\AdminSection</admin-section>
    </settings>

    <!-- Allow external CDN for Three.js -->
    <content-security-policy>
        <allowed-domains>
            <domain>cdnjs.cloudflare.com</domain>
        </allowed-domains>
    </content-security-policy>
</info>




