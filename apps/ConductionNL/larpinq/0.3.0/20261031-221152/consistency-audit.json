  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 0.3.0, package.json says 0.1.20.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "php-extensions",
      "lines": [
        "1 PHP extension is required by composer but not listed as <lib> in appinfo/info.xml:",
        "  iconv (symfony/polyfill-mbstring)",
        "  A Nextcloud server need not load it. The server checks <lib> before it enables the app; composer only checks where it runs. Without the <lib> the app is enabled anyway and the first call into the extension fails at runtime."
      ]
    },
    {
      "level": "warn",
      "id": "node-version",
      "lines": [
        "Node versions disagree: ^22.14 || ^24 || >=26 (package.json engines.node), 22 (.nvmrc), 24 (spec-validation.yml).",
        "  The release is built on one of them and a contributor may build on another; a different major gets a different lockfile and, with a native dependency, a different build."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.mjs), Stylelint (stylelint.config.js), Psalm (psalm.xml), PHPUnit (phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), EditorConfig (.editorconfig).",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "5 declared packages are named nowhere in the checkout: @babel/preset-env, commander, path-browserify, stylelint-config-html, terser-webpack-plugin.",
        "  Searched as literal names over 625 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence EUPL-1.2 (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "link-dead",
      "lines": [
        "The 6 links of appinfo/info.xml answer."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 32 to 34; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.3 is the floor in appinfo/info.xml and in composer.json, platform 8.3."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    }
  ],
