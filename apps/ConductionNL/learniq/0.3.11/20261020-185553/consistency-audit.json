  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 0.3.11, package.json says 0.1.0.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "node-version",
      "lines": [
        "Node versions disagree: ^22.14 || ^24 || >=26 (package.json engines.node), 22 (.nvmrc), 24 (spec-validation.yml).",
        "  The release is built on one of them and a contributor may build on another; a different major gets a different lockfile and, with a native dependency, a different build."
      ]
    },
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "src/ is read at run time and is not in the shipped file set: lib/Controller/PageController.php:125 reaches it through __DIR__.",
        "  A release ships only the paths of the keep set (the ncmake core and ncmake.mk), so the tarball lacks it and the app fails in the code that reads it, while the build and the packing pass. In ncmake.mk, keep_extra += src ships it."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.4.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.mjs), Stylelint (stylelint.config.js), Psalm (psalm.xml), PHPUnit (phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), EditorConfig (.editorconfig).",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "2 declared packages are named nowhere in the checkout: @nextcloud/password-confirmation, terser-webpack-plugin.",
        "  Searched as literal names over 1,220 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence EUPL-1.2 (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 32 to 34; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.3 is the floor in appinfo/info.xml and in composer.json, platform 8.3."
      ]
    },
    {
      "level": "ok",
