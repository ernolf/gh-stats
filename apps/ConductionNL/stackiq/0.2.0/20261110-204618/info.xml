    <dependencies>
        <!--
        App dependency (not expressible in app-info.xsd): OpenRegister — every
        Stackiq entity is an OpenRegister object, and src/manifest.json
        lists "openregister" as a required dependency.

        min-version is therefore 32, NOT 28: openregister declares min-version="32"
        because its lib/ContextChat/ContentProvider.php implements
        OCP\ContextChat\IContentProvider, an interface core does not have before
        Nextcloud 32. On NC 28-31 openregister refuses to install ("cannot be
        installed because it is not compatible with this version of the server"), so
        the app cannot function there. Declaring 28 advertised a range this app
        cannot deliver. Same defect as openconnector#1173.

        CI already tests stable32 only, so this changes the advertised app-store
        range and nothing about what runs.
        -->
        <php min-version="8.3" min-int-size="64"/>
        <database min-version="10">pgsql</database>
        <database>sqlite</database>
        <database min-version="8.0">mysql</database>
        <nextcloud min-version="32" max-version="34"/>
    </dependencies>

	<background-jobs>
		<job>OCA\Stackiq\BackgroundJob\OrganizationContactSyncJob</job>
		<job>OCA\Stackiq\BackgroundJob\ContractStatusJob</job>
		<job>OCA\Stackiq\BackgroundJob\FederationSyncJob</job>
		<job>OCA\Stackiq\BackgroundJob\EolSyncJob</job>
	</background-jobs>

	<repair-steps>
		<post-migration>
			<!--
				APP-ID RENAME (stackiq -> stackiq). These three MUST stay
				first in this block and in <install> below.

				Nextcloud namespaces `oc_appconfig` and `oc_preferences` BY APP ID
				and offers no in-place app-id upgrade, so every row written under
				`stackiq` becomes unreachable the moment the id moves. No
				reader errors — every one of them supplies a default — so admin
				settings and per-user preferences silently revert to their defaults
				instead of failing loudly.

				Ordering is load-bearing: InitializeSettings and the backfills below
				WRITE config themselves. If they ran first, the copy step would find
				a value already present in the new namespace, skip the key as
				"already migrated", and strand the operator's real value in the old
				one forever.
			-->
			<step>OCA\Stackiq\Repair\MigrateAppConfigKeys</step>
			<step>OCA\Stackiq\Repair\MigrateUserPreferences</step>
			<!--
				`oc_jobs` stores the background job's CLASS NAME as a string. The
				namespace rename orphans all four rows: the class no longer exists,
				so the job never runs again and nothing reports it.
			-->
			<step>OCA\Stackiq\Repair\MigrateBackgroundJobClasses</step>
			<!--
				REGISTER-SLUG RENAME (voorzieningen -> stackiq). MUST run ahead of
				every step below that resolves a register by slug, and ahead of the
				register import InitializeSettings triggers.

				OpenRegister resolves a register by SLUG and by nothing else, and
				the not-found branch is not an error path — it is the "create a new
				one" path. Shipping the renamed slug in the register JSON without
				renaming the ROW first therefore renames nothing: the import finds
				no match, CREATES A SECOND, EMPTY REGISTER, and every stored object
				stays behind on the old row, reachable by nothing. Nothing errors;
				the app just looks new.

				It moves no data. An object is bound to its register by NUMERIC id
				— `_register` holds the id and the shard tables are named
				`oc_openregister_table_<registerId>_<schemaId>` — so the slug
				appears nowhere in the physical layout and this is a one-column
				UPDATE on one row.

				`vng-gemma` is deliberately NOT in its map: that register holds VNG
				GEMMA reference data, is not this app's own store, and is addressed
				by that name outside this repository.
			-->
			<step>OCA\Stackiq\Repair\MigrateRegisterSlug</step>
			<!--
				MUST stay ahead of InitializeSettings, and AFTER MigrateRegisterSlug
				above — this step scopes its work to the register slugs it names, so
				it has to run once the row already carries the new one.
				OpenRegister's import matches a schema to an
				existing row by SLUG, so a renamed slug in the register JSON does
				not rename anything: the import finds no match, creates a SECOND
				schema, and every stored object keeps pointing at the old one —
				data stranded behind a schema nothing reads, which presents as an
				app with no records rather than as an error. Renaming the slug on
				the existing row first makes the import recognise it and update it.
				InitializeSettings is what triggers that import, via
				SettingsService::initialize().
			-->
			<step>OCA\Stackiq\Repair\RenameDutchSchemaSlugs</step>
			<!--
				A DIFFERENT COLUMN FROM THE STEP ABOVE, AND NEITHER COVERS THE
				OTHER: RenameDutchSchemaSlugs rewrites
				`openregister_schemas.slug`, this one rewrites
				`openregister_schemas.application`. It is also the THIRD store
				keyed by app id — `oc_appconfig` and `oc_preferences` are
				Nextcloud's, this one is OpenRegister's — so the two Migrate*
				steps at the top of this block do not cover it either.

				OpenRegister resolves the two halves of a configuration by
				DIFFERENT keys: a REGISTER by slug alone, a SCHEMA by the PAIR
				(application, slug) via findByApplicationAndSlug(). This app now
				passes `appId: Application::APP_ID` = `stackiq`, while every
				schema it already owns still carries
				`application = softwarecatalog` — so the pair matches nothing,
				and the import's not-found branch is not an error path, it is
				the "create a new one" path. The import then builds a SECOND,
				EMPTY schema set while every stored object stays bound to the
				old rows. Nothing errors; the app renders empty collections.
				Measured before this step existed: 21 schemas under
				`softwarecatalog`, zero under `stackiq`, zero collisions.

				POSITION IS LOAD-BEARING IN BOTH DIRECTIONS. After
				RenameDutchSchemaSlugs, so the collision check is judged against
				the slugs the rows will actually carry; before
				InitializeSettings, which is what triggers the register import.

				Refuses rather than merges where a slug already has a twin under
				the new application id, never deletes a schema, and never throws
				— an escaping exception in <install> aborts the install.
			-->
			<step>OCA\Stackiq\Repair\MigrateSchemaApplicationId</step>
			<!--
				Before InitializeSettings, and separate from RenameDutchSchemaSlugs
				above: this one ends a CROSS-APP collision rather than translating a
				word. `contract` was claimed by shillinq, pipelinq and this app, and
				all three carry `contractNumber`, so shillinq owns the lifecycle and
				this becomes the catalogue facet.
			-->
			<step>OCA\Stackiq\Repair\RenameCollidingSchemaSlugs</step>
			<step>OCA\Stackiq\Repair\InitializeSettings</step>
			<step>OCA\Stackiq\Repair\MigrateContactsToNc</step>
			<step>OCA\Stackiq\Repair\BackfillContractApprovalState</step>
			<!--
				Must run AFTER the register sync that adds the English columns, so it
				can tell the rename case from the back-fill case. Scoped by SCHEMA,
				not by register: element/relation/view hold the GEMMA/GGM import and
				their Dutch property names are that import's wire format.
				Idempotent, non-destructive, and refuses ambiguous renames.
			-->
			<step>OCA\Stackiq\Repair\RenameDutchCatalogColumns</step>
			<!--
				After the column rename, and late for the same reason: the schema
				edit changes the DECLARATION, but every row already written still
				holds the Dutch string. A filter on the new value then returns
				null rather than an error, so the feature reports "nothing found"
				instead of failing.
			-->
			<step>OCA\Stackiq\Repair\RenameDutchCatalogValues</step>
		</post-migration>
		<!--
			FRESH INSTALL. Nextcloud does NOT run post-migration on a first install:
			`Installer::installAppLastSteps()` guards both the pre-migration and
			post-migration blocks with `if ($previousVersion !== '')`, and only
			`repair-steps/install` runs unconditionally afterwards. Until this block
			existed a brand-new Stackiq install ran NONE of the steps above,
			so InitializeSettings never fired and the register was never imported —
			despite that step's own docblock saying it initialises settings "on
			install/upgrade".

			⚠️ An APP-ID RENAME PRESENTS AS A FRESH INSTALL, not as an upgrade:
			Nextcloud has never seen `stackiq` before, so `$previousVersion` is ''
			and <post-migration> above does not run at all. This block is therefore
			the ONLY hook that fires on the very upgrade the migration steps exist
			for, which is why all three of them are repeated here — first, and ahead
			of InitializeSettings for the ordering reason given above.

			The remaining upgrade steps stay out. MigrateContactsToNc,
			BackfillContractApprovalState and RenameDutchCatalogColumns are all
			migrations or backfills over data a fresh install does not yet have, so
			they stay upgrade-only rather than running against an empty database.
		-->
		<install>
			<step>OCA\Stackiq\Repair\MigrateAppConfigKeys</step>
			<step>OCA\Stackiq\Repair\MigrateUserPreferences</step>
			<step>OCA\Stackiq\Repair\MigrateBackgroundJobClasses</step>
			<!--
				The register-slug rename repeats here for the same reason the app-id
				steps do: an app-id rename presents as a FRESH INSTALL, so
				<post-migration> never fires on the very upgrade this step exists
				for. It must sit ahead of InitializeSettings, which triggers the
				register import that resolves the register by slug.

				The schema step follows the register step, not the other way
				round: it resolves each schema by the (application, slug) PAIR,
				and the slug it matches on is the one MigrateRegisterSlug has
				just corrected. Run it first and it matches against the old slug.
			-->
			<step>OCA\Stackiq\Repair\MigrateRegisterSlug</step>
			<!--
				RenameDutchSchemaSlugs repeats here because MigrateSchemaApplicationId
				below documents it as a prerequisite: "After RenameDutchSchemaSlugs,
				so the collision check is judged against the slugs the rows will
				actually carry." <post-migration> runs the two in that order; this
				block did not, and on the fresh-install path — which is exactly what
				an app-id rename presents as — the collision check was judged against
				the pre-rename slugs.
			-->
			<step>OCA\Stackiq\Repair\RenameDutchSchemaSlugs</step>
			<step>OCA\Stackiq\Repair\MigrateSchemaApplicationId</step>
			<!--
				Before InitializeSettings, and separate from RenameDutchSchemaSlugs
				above: this one ends a CROSS-APP collision rather than translating a
				word. `contract` was claimed by shillinq, pipelinq and this app, and
				all three carry `contractNumber`, so shillinq owns the lifecycle and
				this becomes the catalogue facet.
			-->
			<step>OCA\Stackiq\Repair\RenameCollidingSchemaSlugs</step>
			<step>OCA\Stackiq\Repair\InitializeSettings</step>
		</install>
	</repair-steps>

	<settings>
		<admin>OCA\Stackiq\Settings\StackiqAdmin</admin>
		<admin-section>OCA\Stackiq\Sections\StackiqAdmin</admin-section>
	</settings>

