  "findings": [
    {
      "level": "warn",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 13 to 13; the oldest maintained major is 33 (the Maintenance and Release Schedule of nextcloud/server), the newest released 35 (the release tags of nextcloud/server).",
        "  max-version 13 is below the oldest maintained major (33, the Maintenance and Release Schedule of nextcloud/server), so the release covers only servers that no longer receive fixes.",
        "  min-version 13 reaches below the oldest maintained major (33), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "warn",
      "id": "license-drift",
      "lines": [
        "Licence Apache License 2.0 (appinfo/info.xml, composer.json).",
        "  No SPDX id: Apache License 2.0 (appinfo/info.xml, composer.json). Only an SPDX id says which licence is meant, and for a GNU licence whether -only or -or-later.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "info",
      "id": "php-support",
      "lines": [
        "PHP floor stated once: appinfo/info.xml min-version 5.6; composer.json states no php requirement.",
        "  Nothing contradicts anything here. Stating it in both places is what keeps a composer install from resolving packages for a PHP the server will not run."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 7.1.99.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "No Node version is stated: no engines.node, no .nvmrc, and no node-version in the installed workflows.",
        "  Whoever builds the app uses whatever Node they have, and a build that works on one machine is then not evidence for the next."
      ]
    },
    {
      "level": "info",
      "id": "lockfiles",
      "lines": [
        "composer.json without composer.lock.",
        "  An app ships its vendor tree, so the versions in it are part of the release; committing the lockfile is what makes that tree reproducible."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: none of the configurations this audit looks for.",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHPUnit configuration: there is no test harness in the checkout, so nothing can be run against a change.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "link-dead",
      "lines": [
        "The 6 links of appinfo/info.xml answer."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set."
      ]
    }
