<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>movies</id>
	<name>Movies</name>
	<summary>Lets you see and watch the Movies on your system</summary>
	<description>This App finds the movies you have in your nextcloud, gathers additional information about the movies from open data sources and displays your collection in a nice Overview</description>
	<version>0.0.0</version>
	<licence>agpl</licence>
	<author mail="georg.plaz@gmail.com" homepage="">Georg Plaz</author>
	<namespace>Movies</namespace>
	<category>multimedia</category>
	<bugs>https://github.com/FancyNeuron/NextcloudMovies/issues</bugs>
	<dependencies>
		<nextcloud min-version="30" max-version="32"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>movies</id>
			<name>Movies</name>
			<route>movies.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
