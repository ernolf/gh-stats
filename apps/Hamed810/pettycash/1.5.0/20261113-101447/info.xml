<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>pettycash</id>
    <name>Project Petty Cash</name>
    <summary>Project petty-cash submission, approval, evidence, and accounting reports.</summary>
    <description>
        Project Petty Cash provides purchaser expense capture, category-aware validation,
        manager approvals, accounting reporting, Persian/Jalali support, and a future
        asynchronous Persian/English OCR pipeline.
    </description>
    <version>0.4.3</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Project Petty Cash Team</author>
    <namespace>PettyCash</namespace>
    <category>office</category>

    <dependencies>
        <php min-version="8.3" max-version="8.5"/>
        <lib>intl</lib>
        <lib>fileinfo</lib>
        <nextcloud min-version="34" max-version="35"/>
    </dependencies>

    <navigations>
        <navigation>
            <id>pettycash</id>
            <name>Petty Cash</name>
            <route>pettycash.page.index</route>
            <icon>app.svg</icon>
            <type>link</type>
        </navigation>
    </navigations>

    <settings>
        <admin>OCA\PettyCash\Settings\AdminSettings</admin>
        <admin-section>OCA\PettyCash\Sections\AdminSection</admin-section>
    </settings>
</info>
