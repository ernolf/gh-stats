<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>workoutcalendar</id>
    <name>Workout Calendar</name>
    <summary>Garmin Connect activities as calendar events</summary>
    <description><![CDATA[Imports your Garmin Connect activities into a Nextcloud calendar and keeps them in sync.

Garmin offers no official API for personal use. The app uses the same unofficial endpoints as the Garmin Connect mobile app, so Garmin may change or block them at any time.

Use at your own risk. This app is not affiliated with or endorsed by Garmin.]]></description>
    <version>1.0.0</version>
    <licence>agpl</licence>
    <author>HoMS1987</author>
    <namespace>WorkoutCalendar</namespace>
    <category>organization</category>
    <website>https://github.com/HoMS1987/workoutcalendar</website>
    <bugs>https://github.com/HoMS1987/workoutcalendar/issues</bugs>
    <repository type="git">https://github.com/HoMS1987/workoutcalendar.git</repository>
    <donation type="other" title="GitHub Sponsors">https://github.com/sponsors/HoMS1987</donation>
    <dependencies>
        <php min-version="8.2"/>
        <lib>curl</lib>
        <nextcloud min-version="33" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\WorkoutCalendar\BackgroundJob\SyncJob</job>
    </background-jobs>
    <settings>
        <personal>OCA\WorkoutCalendar\Settings\Personal</personal>
        <personal-section>OCA\WorkoutCalendar\Settings\Section</personal-section>
    </settings>
</info>
