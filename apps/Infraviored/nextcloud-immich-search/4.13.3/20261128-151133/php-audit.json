      "id": "job-time-sensitivity",
      "level": "info",
      "places": [
        "lib/BackgroundJob/IndexVideoScenes.php OCA\\Glimpse\\BackgroundJob\\IndexVideoScenes",
        "lib/BackgroundJob/PruneSmallImages.php OCA\\Glimpse\\BackgroundJob\\PruneSmallImages"
