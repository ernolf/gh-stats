  "findings": [
    {
      "level": "info",
      "id": "version-drift",
      "lines": [
        "Version 0.2.1 in appinfo/info.xml; package.json states no version.",
        "  Nothing is inconsistent then, and nothing has to be kept in step either. Stating it in both places is what makes a release bump reviewable in the diff."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is gloss, the checkout directory is gloss-nextcloud.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "php-support",
      "lines": [
        "PHP floor stated once: composer.json requires php >=8.2; appinfo/info.xml declares no php dependency.",
        "  Nothing contradicts anything here. Stating it in both places is what keeps a composer install from resolving packages for a PHP the server will not run."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node 24 stated in ci.yml.",
        "  Not stated in engines.node in package.json, .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: PHPUnit (phpunit.xml).",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "script-without-workflow",
      "lines": [
        "package.json declares the script test, which no installed workflow runs.",
        "  The template node-test of nextcloud/.github runs test: make workflows-install W=node-test",
        "  A check that no workflow runs on a pull request catches only what the contributor who remembers to run it catches."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "link-dead",
      "lines": [
        "The 2 links of appinfo/info.xml answer."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 33 to 34; the oldest maintained major is 33 (the Maintenance and Release Schedule of nextcloud/server), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set."
      ]
