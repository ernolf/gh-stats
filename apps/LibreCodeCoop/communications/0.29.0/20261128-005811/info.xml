<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>communications</id>
	<name>Communications</name>
	<summary>Publish and deliver institutional messages across Nextcloud channels</summary>
	<description>Send institutional announcements, contextual messages and notifications to eligible recipients using a unified inbox and event-driven delivery.</description>
	<version>0.29.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>LibreCode Coop</author>
	<namespace>Communications</namespace>
	<category>tools</category>
	<bugs>https://github.com/LibreCodeCoop/communications/issues</bugs>
	<repository type="git">https://github.com/LibreCodeCoop/communications</repository>
	<dependencies>
		<nextcloud min-version="36" max-version="36"/>
	</dependencies>
	<background-jobs>
		<job>OCA\Communications\BackgroundJob\CleanupJob</job>
		<job>OCA\Communications\BackgroundJob\BoardPublishJob</job>
	</background-jobs>
	<commands>
		<command>OCA\Communications\Command\Campaign</command>
		<command>OCA\Communications\Command\PublishDue</command>
	</commands>
	<activity>
		<settings>
			<setting>OCA\Communications\Activity\BoardSetting</setting>
		</settings>
		<providers>
			<provider>OCA\Communications\Activity\BoardProvider</provider>
		</providers>
	</activity>
</info>
