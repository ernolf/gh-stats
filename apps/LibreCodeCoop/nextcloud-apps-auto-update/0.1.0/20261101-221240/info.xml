<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>apps_auto_update</id>
    <name>Atualização automática de aplicativos</name>
    <summary>Atualiza os aplicativos do Nextcloud em um horário configurável</summary>
    <description><![CDATA[Agenda a atualização dos aplicativos do Nextcloud, sem atualizar o core, e executa as rotinas de manutenção do banco de dados.]]></description>
    <version>0.1.0</version>
    <licence>agpl</licence>
    <author mail="dev@librecode.coop">LibreCode coop</author>
    <namespace>AppsAutoUpdate</namespace>
    <category>tools</category>
    <dependencies>
        <nextcloud min-version="31" max-version="34"/>
    </dependencies>
    <settings>
        <admin>OCA\AppsAutoUpdate\Settings\AdminSettings</admin>
    </settings>
    <background-jobs>
        <job>OCA\AppsAutoUpdate\BackgroundJob\AppsUpdateJob</job>
    </background-jobs>
    <commands>
        <command>OCA\AppsAutoUpdate\Command\RunUpdate</command>
    </commands>
</info>
