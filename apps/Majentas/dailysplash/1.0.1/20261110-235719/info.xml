<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>dailysplash</id>
    <name>DailySplash</name>
    <summary>A new picture of the day as login background, served by your own Nextcloud</summary>
    <description>DailySplash shows the Bing or Wikimedia Commons picture of the day as the background of the login page (and optionally the dashboard). Images are downloaded once a day by a background job and served by Nextcloud itself, so visitors' browsers never contact third-party sites. DailySplash is a modified fork of the "Splash" app (unsplash) by Jan-Christoph Borchardt, Marius Wieschollek and Felix Nüsse.</description>
    <version>1.0.1</version>
    <licence>agpl</licence>
    <author mail="hey@jancborchardt.net" homepage="https://jancborchardt.net">Jan-Christoph Borchardt</author>
    <author homepage="https://github.com/marius-wieschollek">Marius Wieschollek</author>
    <author homepage="https://github.com/newhinton">Felix Nüsse</author>
    <namespace>DailySplash</namespace>
    <documentation>
        <admin>https://github.com/Majentas/dailysplash#readme</admin>
    </documentation>
    <category>customization</category>
    <website>https://github.com/Majentas/dailysplash</website>
    <bugs>https://github.com/Majentas/dailysplash/issues</bugs>
    <repository type="git">https://github.com/Majentas/dailysplash.git</repository>
    <screenshot small-thumbnail="https://raw.githubusercontent.com/Majentas/dailysplash/main/screenshots/login-small.jpg">https://raw.githubusercontent.com/Majentas/dailysplash/main/screenshots/login.jpg</screenshot>
    <dependencies>
        <php min-version="8.2"/>
        <nextcloud min-version="35" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\DailySplash\Cron\ImageProviderBackgroundFetch</job>
    </background-jobs>
    <commands>
        <command>OCA\DailySplash\Command\Fetch</command>
    </commands>
    <settings>
        <admin>OCA\DailySplash\Settings\AdminSettings</admin>
    </settings>
</info>
