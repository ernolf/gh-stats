<?xml version="1.0"?>
<info>
	<id>templario</id>
	<name>Templario</name>
	<summary>Dokument-Generator mit Vorlagen, Datenquellen und Synchronisation</summary>
	<description><![CDATA[
Vorlagen verwalten, mit Datenquellen (REST/JSON, Nextcloud) mappen und dokumente
versioniert erzeugen und aktualisieren. Vorlage → Datenquelle → Mapping → Dokument
→ Ausgabe → später aktualisieren.
]]></description>
	<version>0.7.0</version>
	<licence>agpl</licence>
	<author>templario contributors</author>
	<namespace>Templario</namespace>
	<category>files</category>
	<category>organization</category>
	<website>https://example.com/templario</website>
	<bugs>https://example.com/templario/issues</bugs>
	<repository type="git">https://example.com/templario.git</repository>
	<dependencies>
		<nextcloud min-version="31" max-version="35"/>
	</dependencies>
	<commands>
		<command>OCA\Templario\Command\AddTemplate</command>
		<command>OCA\Templario\Command\ListTemplates</command>
		<command>OCA\Templario\Command\Generate</command>
		<command>OCA\Templario\Command\AddDataSource</command>
		<command>OCA\Templario\Command\ListDataSources</command>
		<command>OCA\Templario\Command\FetchDataSource</command>
		<command>OCA\Templario\Command\BatchGenerate</command>
	</commands>
	<navigations>
		<navigation>
			<name>Templario</name>
			<route>templario.page.index</route>
			<order>78</order>
		</navigation>
	</navigations>
	<settings>
		<admin-section>OCA\Templario\Settings\Section</admin-section>
		<admin>OCA\Templario\Settings\AdminSettings</admin>
	</settings>
</info>
