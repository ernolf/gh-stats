  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 1.0.6, package.json says 1.0.5.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "vendor-bin/ is read at run time and is not in the shipped file set: lib/AppInfo/Telemetry.php:19 reaches it through __DIR__.",
        "  A release ships only the paths of the keep set (the ncmake core and ncmake.mk), so the tarball lacks it and the app fails in the code that reads it, while the build and the packing pass. In ncmake.mk, keep_extra += vendor-bin ships it."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is files_external_ethswarm, the checkout directory is nextcloud-swarm-plugin.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node 24 stated in lint.yml, release.yml.",
        "  Not stated in engines.node in package.json, .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: PHPUnit (tests/phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), EditorConfig (.editorconfig).",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "2 declared packages are named nowhere in the checkout: @nextcloud/typings, @biomejs/biome.",
        "  Searched as literal names over 117 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence agpl (appinfo/info.xml), AGPL-3.0-or-later (package.json).",
        "  agpl in appinfo/info.xml is a deprecated App Store value, shown there as AGPLv3+, which is AGPL-3.0-or-later. With min-version 33 info.xml can state an SPDX id instead.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 33 to 35; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "pnpm-lock.yaml and composer.lock in the checkout, packageManager pnpm@10.28.2."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    }
  ]
