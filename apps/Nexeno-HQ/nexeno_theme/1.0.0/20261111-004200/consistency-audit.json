  "findings": [
    {
      "level": "info",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 32 to 35; the oldest maintained major is 33 (the Maintenance and Release Schedule of nextcloud/server), the newest released 35 (the release tags of nextcloud/server).",
        "  min-version 32 reaches below the oldest maintained major (33), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as ^22.14 || ^24 (package.json engines.node).",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.mjs), Stylelint (stylelint.config.mjs), Psalm (psalm.xml), PHPUnit (tests/phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), REUSE (REUSE.toml).",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "script-without-workflow",
      "lines": [
        "package.json declares the scripts lint, stylelint, which no installed workflow runs.",
        "  The template lint-eslint of nextcloud/.github runs lint: make workflows-install W=lint-eslint",
        "  The template lint-stylelint of nextcloud/.github runs stylelint: make workflows-install W=lint-stylelint",
        "  A check that no workflow runs on a pull request catches only what the contributor who remembers to run it catches."
      ]
    },
    {
      "level": "ok",
      "id": "versions-agree",
      "lines": [
        "Version 1.0.0 in appinfo/info.xml, package.json and package-lock.json."
      ]
