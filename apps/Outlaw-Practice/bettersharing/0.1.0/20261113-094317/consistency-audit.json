  "findings": [
    {
      "level": "warn",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml states no <repository>.",
        "  <repository> is the only machine-readable link from a published release back to the source it was built from. Without it nothing that reads the release can tell where its source is.",
        "  <website> is not set either."
      ]
    },
    {
      "level": "info",
      "id": "link-redirect",
      "lines": [
        "A link of appinfo/info.xml has moved permanently:",
        "  <bugs> https://outlawpractice.com",
        "    now https://www.outlawpractice.com/",
        "  The old address works only as long as the redirect is kept; the new one can be stated directly."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as >=22 (package.json engines.node).",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: PHPUnit (phpunit.xml).",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "script-without-workflow",
      "lines": [
        "package.json declares the script test, which no installed workflow runs.",
        "  The template node-test of nextcloud/.github runs test: make workflows-install W=node-test",
        "  A check that no workflow runs on a pull request catches only what the contributor who remembers to run it catches."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence agpl (appinfo/info.xml), AGPL-3.0-or-later (package.json, composer.json).",
        "  agpl in appinfo/info.xml is a deprecated App Store value, shown there as AGPLv3+, which is AGPL-3.0-or-later. With min-version 35 info.xml can state an SPDX id instead.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "versions-agree",
      "lines": [
        "Version 0.1.0 in appinfo/info.xml, package.json and package-lock.json."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
