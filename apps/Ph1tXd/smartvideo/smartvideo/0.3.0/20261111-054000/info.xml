<?xml version="1.0" encoding="utf-8"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>smartvideo</id>
    <name>Smart Video</name>
    <summary>Automatic transcripts, subtitles, summaries and chapters for videos.</summary>
    <description>Processes uploaded videos with an external GigaAM v3 and LM Studio worker and displays chapters directly in Nextcloud.</description>
    <version>0.3.0</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Gled</author>
    <namespace>SmartVideo</namespace>
    <types>
        <filesystem />
    </types>
    <category>multimedia</category>
    <website>https://github.com/Ph1tXd/smartvideo</website>
    <bugs>https://github.com/Ph1tXd/smartvideo/issues</bugs>
    <repository type="git">https://github.com/Ph1tXd/smartvideo.git</repository>
    <dependencies>
        <php min-version="8.1" />
        <nextcloud min-version="30" max-version="30" />
    </dependencies>
    <settings>
        <admin>OCA\SmartVideo\Settings\AdminSettings</admin>
        <admin-section>OCA\SmartVideo\Settings\AdminSection</admin-section>
    </settings>
</info>
