  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 0.0.4, package.json says 1.0.0, package-lock.json says 1.0.0, package-lock.json packages[\"\"] says 1.0.0.",
        "  make version of ncmake bumps info.xml, composer.json and package.json and re-syncs package-lock.json in one step, so they cannot drift apart. ncmake's lint-version workflow fails a push or a pull request on exactly this drift. The App Store and the server read info.xml, npm and composer read their own manifest. Whichever is behind, a release ends up carrying more than one version number, and only one of them reaches the user."
      ],
      "covers": [
        "lint-version/version-drift"
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node 22 stated in ci.yml, within package.json engines.node >=20.19.",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: Psalm (psalm.xml), PHPUnit (tests/phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php).",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "script-without-workflow",
      "lines": [
        "package.json declares the script playwright, which no installed workflow runs.",
        "  The template playwright of nextcloud/.github runs playwright: make workflows-install W=playwright",
        "  A check that no workflow runs on a pull request catches only what the contributor who remembers to run it catches."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence agpl (appinfo/info.xml), AGPL-3.0-or-later (package.json, composer.json).",
        "  agpl in appinfo/info.xml is a deprecated App Store value, shown there as AGPLv3+, which is AGPL-3.0-or-later. With min-version 33 info.xml can state an SPDX id instead.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "link-dead",
      "lines": [
        "The 6 links of appinfo/info.xml answer."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 33 to 35; the oldest maintained major is 33 (the Maintenance and Release Schedule of nextcloud/server), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.2 is the floor in appinfo/info.xml and in composer.json."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set."
      ]
    },
    {
      "level": "ok",
      "id": "unreferenced-dependencies",
      "lines": [
        "All 12 declared packages are named somewhere in the checkout, 1 of them by convention."
      ]
    }
