  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 4.6.4, package.json says 1.0.18.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "license-drift",
      "lines": [
        "The licence is stated differently: agpl (appinfo/info.xml, package.json), GPL-3.0-or-later (composer.json).",
        "  Whoever redistributes the app has to pick one of them, and the App Store shows the one from info.xml.",
        "  agpl in appinfo/info.xml is a deprecated App Store value, shown there as AGPLv3+, which is AGPL-3.0-or-later. An SPDX id there needs a <nextcloud> min-version of 31 or higher.",
        "  No SPDX id: agpl (package.json). Only an SPDX id says which licence is meant, and for a GNU licence whether -only or -or-later.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is sendent, the checkout directory is Sendent-App-for-Nextcloud.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 30 to 35; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server).",
        "  min-version 30 reaches below the oldest maintained major (32), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "info",
      "id": "php-support",
      "lines": [
        "PHP floor stated once: composer.json requires php >=8.1 <8.6; appinfo/info.xml declares no php dependency.",
        "  Nothing contradicts anything here. Stating it in both places is what keeps a composer install from resolving packages for a PHP the server will not run."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (.eslintrc.js, superseded form), Psalm (psalm.xml), PHPUnit (phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), EditorConfig (.editorconfig).",
        " ESLint is configured in .eslintrc.js: ESLint 9 reads the flat config only; the eslintrc form, an .eslintrc file or the eslintConfig key in package.json, is ignored unless the run is pinned to ESLint 8.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "node-version",
      "lines": [
        "Node 22 stated in .nvmrc, lint.yml, release.yml, static.yml, within package.json engines.node >=20."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    },
    {
      "level": "ok",
      "id": "unreferenced-dependencies",
      "lines": [
        "All 19 declared packages are named somewhere in the checkout, 1 of them by convention."
      ]
    }
  ]
