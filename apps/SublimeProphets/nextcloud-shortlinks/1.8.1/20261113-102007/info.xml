<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>shortlinks</id>
	<name>Shortlinks</name>
	<summary>Create, share, protect, and analyse short links</summary>
	<description><![CDATA[Shortlinks provides private link management, folders, tags, access controls, privacy-preserving analytics, import/export, a bookmarklet, QR codes, and a versioned OCS API.]]></description>
	<version>1.8.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>Shortlinks Contributors</author>
	<namespace>Shortlinks</namespace>
	<category>organization</category>
	<category>tools</category>
	<dependencies>
		<php min-version="8.3" max-version="8.5"/>
		<nextcloud min-version="34" max-version="35"/>
	</dependencies>
	<navigations>
		<navigation>
			<id>shortlinks</id>
			<name>Shortlinks</name>
			<route>shortlinks.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
	<settings>
		<admin>OCA\Shortlinks\Settings\AdminSettings</admin>
		<admin-section>OCA\Shortlinks\Settings\AdminSection</admin-section>
	</settings>
	<background-jobs>
		<job>OCA\Shortlinks\BackgroundJob\AggregateStatsJob</job>
		<job>OCA\Shortlinks\BackgroundJob\CleanupJob</job>
		<job>OCA\Shortlinks\BackgroundJob\RotateVisitorSecretJob</job>
	</background-jobs>
	<commands>
		<command>OCA\Shortlinks\Command\HealthCommand</command>
		<command>OCA\Shortlinks\Command\StatsAggregateCommand</command>
		<command>OCA\Shortlinks\Command\StatsCleanupCommand</command>
		<command>OCA\Shortlinks\Command\StatsRebuildCommand</command>
		<command>OCA\Shortlinks\Command\ImportCommand</command>
		<command>OCA\Shortlinks\Command\ExportCommand</command>
		<command>OCA\Shortlinks\Command\GeoIpCheckCommand</command>
		<command>OCA\Shortlinks\Command\OwnerTransferCommand</command>
		<command>OCA\Shortlinks\Command\SeedCommand</command>
	</commands>
</info>
