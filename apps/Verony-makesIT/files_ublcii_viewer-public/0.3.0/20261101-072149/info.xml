<info>
    <id>files_ublcii_viewer</id>
    <name>UBL/CII Viewer</name>
    <summary>Viewer for UBL and CII invoices</summary>
    <description>
        Displays UBL and CII invoice XML files with on-demand EPC/SEPA payment QR codes.
        Optionally extracts supported embedded CII XML from Factur-X/ZUGFeRD PDFs.
    </description>
    <version>0.3.0</version>

    <licence>AGPL-3.0-or-later</licence>

    <author>Verony</author>

    <namespace>FilesUblciiViewer</namespace>

    <category>files</category>

