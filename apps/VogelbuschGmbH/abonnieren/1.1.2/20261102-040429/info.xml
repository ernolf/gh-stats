<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>abonnieren</id>
	<name>Abonnieren</name>
	<summary>File and folder subscriptions with email notifications</summary>
	<description>Subscribe to files and folders and receive email notifications for downloads, uploads, modifications and deletions. Rules can be managed per object in the Files sidebar or from the subscription overview.</description>
	<version>1.1.2</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="contact@ti2m.dev">Timm Meisinger</author>
	<namespace>Abonnieren</namespace>
	<category>files</category>
	<website>https://github.com/VogelbuschGmbH/abonnieren</website>
	<bugs>https://github.com/VogelbuschGmbH/abonnieren/issues</bugs>
	<repository type="git">https://github.com/VogelbuschGmbH/abonnieren.git</repository>
	<dependencies>
		<php min-version="8.2"/>
		<nextcloud min-version="34" max-version="34"/>
	</dependencies>
	<activity>
		<settings>
			<setting>OCA\Abonnieren\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\Abonnieren\Activity\Provider</provider>
		</providers>
	</activity>
	<navigations>
		<navigation>
			<id>abonnieren</id>
			<name>Abonnieren</name>
			<route>abonnieren.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
