  "findings": [
    {
      "level": "warn",
      "id": "php-extensions",
      "lines": [
        "1 PHP extension is required by composer but not listed as <lib> in appinfo/info.xml:",
        "  iconv (sabberworm/php-css-parser)",
        "  A Nextcloud server need not load it. The server checks <lib> before it enables the app; composer only checks where it runs. Without the <lib> the app is enabled anyway and the first call into the extension fails at runtime."
      ]
    },
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "data/ is read at run time and is not in the shipped file set: lib/Service/BuiltinProcedurePackSeeder.php:49 reaches it through dirname(__DIR__, 2).",
        "  A release ships only the paths of the keep set (the ncmake core and ncmake.mk), so the tarball lacks it and the app fails in the code that reads it, while the build and the packing pass. In ncmake.mk, keep_extra += data ships it."
      ]
    },
    {
      "level": "info",
      "id": "version-drift",
      "lines": [
        "Version 1.3.4 in appinfo/info.xml; package.json states no version.",
        "  Nothing is inconsistent then, and nothing has to be kept in step either. Stating it in both places is what makes a release bump reviewable in the diff."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is maintenancecheck, the checkout directory is nextcloud-maintenancecheck.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as ^20.0.0 || ^22.0.0 (package.json engines.node).",
        "  Not stated in .nvmrc, node-version in the workflows, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: PHPUnit (phpunit.xml).",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
