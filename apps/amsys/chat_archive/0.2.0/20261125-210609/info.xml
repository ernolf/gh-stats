<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>chat_archive</id>
    <name>Chat Archive</name>
    <summary>Browse your WhatsApp backup inside Nextcloud</summary>
    <description><![CDATA[Reads the encrypted backup the phone uploads to Nextcloud and turns it into a searchable chat archive. Media stay where the phone put them; the archive keeps pointers by file id, so files can be moved anywhere in Nextcloud and still open from the chat. Built for more than one source: WhatsApp and WhatsApp Business now, other protocols later.]]></description>
    <version>0.2.0</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Martin</author>
    <namespace>ChatArchive</namespace>
    <category>social</category>
    <website>https://github.com/amsys/chat_archive</website>
    <bugs>https://github.com/amsys/chat_archive/issues</bugs>
    <repository>https://github.com/amsys/chat_archive</repository>
    <dependencies>
        <php min-version="8.1"/>
        <lib>pdo_sqlite</lib>
        <lib>openssl</lib>
        <lib>zlib</lib>
        <nextcloud min-version="32" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\ChatArchive\Cron\ImportJob</job>
        <job>OCA\ChatArchive\Cron\SyncJob</job>
    </background-jobs>
    <commands>
        <command>OCA\ChatArchive\Command\Import</command>
        <command>OCA\ChatArchive\Command\Sync</command>
    </commands>
    <settings>
        <admin>OCA\ChatArchive\Settings\Admin</admin>
        <admin-section>OCA\ChatArchive\Settings\PersonalSection</admin-section>
        <personal>OCA\ChatArchive\Settings\Personal</personal>
        <personal-section>OCA\ChatArchive\Settings\PersonalSection</personal-section>
    </settings>
    <fulltextsearch>
        <provider>OCA\ChatArchive\FullTextSearch\ChatProvider</provider>
    </fulltextsearch>
    <navigations>
        <navigation>
            <name>Chat Archive</name>
            <route>chat_archive.page.index</route>
            <icon>app.svg</icon>
            <order>20</order>
        </navigation>
    </navigations>
</info>
