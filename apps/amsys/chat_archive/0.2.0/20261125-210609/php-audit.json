        "  lib/FullTextSearch/ChatProvider.php:129 OC\\FullTextSearch\\Model\\IndexDocument",
        "  lib/FullTextSearch/ChatProvider.php:172 OC\\FullTextSearch\\Model\\DocumentAccess"
      ]
