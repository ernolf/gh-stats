    <licence>AGPL-3.0-or-later</licence>
    <author>Songbook contributors</author>
    <namespace>Songbook</namespace>
    <category>multimedia</category>
    <bugs>https://github.com/andrewiens/Nextcloud-songbook/issues</bugs>
    <repository type="git">https://github.com/andrewiens/Nextcloud-songbook.git</repository>
    <dependencies>
        <php min-version="8.3" max-version="8.5"/>
        <nextcloud min-version="35" max-version="35"/>
    </dependencies>
