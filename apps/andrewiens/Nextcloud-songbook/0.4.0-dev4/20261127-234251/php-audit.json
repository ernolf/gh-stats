        }
      ]
    },
    {
      "id": "openapi-missing",
      "level": "info",
      "places": [],
      "lines": [
        "The app has 17 OCS routes and no openapi.json. Clients of OCS are generated from such a specification, and nothing else tells them what these routes take and return."
      ]
    },
    {
      "id": "migration-not-checked",
