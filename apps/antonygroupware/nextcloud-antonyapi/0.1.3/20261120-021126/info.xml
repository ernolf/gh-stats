    <id>antonyapi</id>
    <name>Antony Api</name>
    <summary>antony Groupware Nextcloud Modul Plugin</summary>
    <description><![CDATA[Dieses Plugin erweitert die Funktionen des antony Cloud Office.
Administratoren können damit den Zielpfad (Mount-Point) eines an einen Benutzer geteilten Ordners
umbenennen oder in einen Unterordner verschieben, z. B. wenn mehrere gleichnamige Projektordner
("Fotos") an denselben Benutzer geteilt werden.]]></description>
    <version>0.1.3</version>
    <licence>agpl</licence>
    <author mail="info@die-groupware.de" homepage="https://www.die-groupware.de">antony Groupware GmbH</author>
    <namespace>AntonyApi</namespace>
    <category>integration</category>
    <bugs>https://github.com/antonygroupware/nextcloud-antonyapi/issues</bugs>
    <dependencies>
        <nextcloud min-version="28" max-version="34"/>
    </dependencies>
    <settings>
        <admin>OCA\AntonyApi\Settings\AdminSettings</admin>
        <admin-section>OCA\AntonyApi\Settings\AdminSection</admin-section>
    </settings>
    <commands>
        <command>OCA\AntonyApi\Command\RefreshAppStore</command>
    </commands>
</info>
