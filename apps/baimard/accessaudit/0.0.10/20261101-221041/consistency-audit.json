  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 0.0.10, package.json says 1.0.0.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "app-name",
      "lines": [
        "The app name Nextcloud Access Audit in appinfo/info.xml uses Nextcloud.",
        "  The App Store publishing rules say apps must not use Nextcloud in their name; a name that does reads as an app of Nextcloud itself."
      ]
    },
    {
      "level": "warn",
      "id": "node-version",
      "lines": [
        "Node versions disagree: ^24.0.0 (package.json engines.node), 20 (.nvmrc).",
        "  20 (.nvmrc) lies outside engines.node ^24.0.0.",
        "  The release is built on one of them and a contributor may build on another; a different major gets a different lockfile and, with a native dependency, a different build."
      ]
    },
    {
      "level": "warn",
      "id": "script-without-config",
      "lines": [
        "package.json script stylelint calls stylelint, and no Stylelint configuration is in the checkout.",
        "  stylelint src/**/*.vue src/**/*.scss src/**/*.css",
        "  The command is there to be run, so whoever runs it gets a tool that has nothing to go by - and CI, if it runs the script, reports the failure as the change under test."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (.eslintrc.cjs, superseded form), Psalm (psalm.xml), PHPUnit (tests/phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php).",
        " ESLint is configured in .eslintrc.cjs: ESLint 9 reads the flat config only; the eslintrc form, an .eslintrc file or the eslintConfig key in package.json, is ignored unless the run is pinned to ESLint 8.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "4 declared packages are named nowhere in the checkout: @nextcloud/vue, @nextcloud/stylelint-config, @nextcloud/vite-config, @vue/tsconfig.",
        "  Searched as literal names over 51 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "link-dead",
      "lines": [
        "The 2 links of appinfo/info.xml answer."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 33 to 36; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.2 is the floor in appinfo/info.xml and in composer.json, platform 8.2."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    }
