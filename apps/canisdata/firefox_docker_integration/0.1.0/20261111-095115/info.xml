<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>firefox_docker_integration</id>
    <name>Firefox Browser</name>
    <summary>Open a per-user self-hosted Firefox browser session inside Nextcloud.</summary>
    <description><![CDATA[Firefox Browser embeds a private jlesage/docker-firefox session in Nextcloud. The broker starts or reuses one dedicated Firefox container per Nextcloud user with a persistent /config volume.]]></description>
    <version>0.1.0</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>canisdata</author>
    <namespace>FirefoxDockerIntegration</namespace>
    <category>integration</category>
    <dependencies>
        <nextcloud min-version="33" max-version="34" />
    </dependencies>
    <settings>
        <admin>OCA\FirefoxDockerIntegration\Settings\Admin</admin>
        <admin-section>OCA\FirefoxDockerIntegration\Settings\AdminSection</admin-section>
        <personal>OCA\FirefoxDockerIntegration\Settings\Personal</personal>
        <personal-section>OCA\FirefoxDockerIntegration\Settings\PersonalSection</personal-section>
    </settings>
    <navigations>
        <navigation>
            <name>Firefox Browser</name>
            <route>firefox_docker_integration.page.index</route>
            <icon>app.svg</icon>
            <order>55</order>
        </navigation>
    </navigations>
</info>
