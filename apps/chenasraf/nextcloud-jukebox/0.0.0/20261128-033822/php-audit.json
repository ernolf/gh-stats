    {
      "id": "config-without-lexicon",
      "level": "info",
      "places": [
        "lib/Service/MusicScannerService.php:68 getValueString()",
        "lib/Service/SettingsService.php:28 setValueString()",
        "lib/Service/SettingsService.php:33 getValueString()",
