<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">

    <id>exchange_connector</id>
    <name>Exchange Connector</name>

    <summary>Synchronize calendars, contacts and tasks between Nextcloud and Microsoft Exchange Server or Exchange Online using EWS</summary>

    <description><![CDATA[
Exchange Connector provides bidirectional synchronization
between Nextcloud and Microsoft Exchange Server or Exchange Online
using Exchange Web Services (EWS).

Supported synchronization areas include calendars, contacts and tasks.
    ]]></description>

    <version>1.1.2</version>
    <licence>AGPL-3.0-or-later</licence>

    <author homepage="https://github.com/ksainc/">Sebastian Krupinski</author>
    <author mail="exchange-connector@engel-projekte.de" homepage="https://codeberg.org/pengel">Pascal Engel</author>

    <namespace>ExchangeConnector</namespace>

    <category>integration</category>

    <website>https://codeberg.org/pengel/exchange-connector</website>
    <discussion>https://codeberg.org/pengel/exchange-connector/issues</discussion>
    <bugs>https://codeberg.org/pengel/exchange-connector/issues</bugs>
    <repository>https://codeberg.org/pengel/exchange-connector</repository>

    <dependencies>
        <php min-version="8.1" min-int-size="64"/>
        <database>pgsql</database>
        <database>sqlite</database>
        <database>mysql</database>

        <command>php</command>
        <command>ps</command>
        <command>kill</command>

        <lib>curl</lib>
        <lib>soap</lib>

        <nextcloud min-version="33" max-version="35"/>
    </dependencies>

    <commands>
        <command>OCA\ExchangeConnector\Commands\Connect</command>
        <command>OCA\ExchangeConnector\Commands\Correlate</command>
        <command>OCA\ExchangeConnector\Commands\Disconnect</command>
        <command>OCA\ExchangeConnector\Commands\Harmonize</command>
        <command>OCA\ExchangeConnector\Commands\HarmonizationThread</command>
        <command>OCA\ExchangeConnector\Commands\SharedCalendar</command>
    </commands>

    <settings>
        <admin>OCA\ExchangeConnector\Settings\AdminSettings</admin>
        <admin-section>OCA\ExchangeConnector\Settings\AdminSection</admin-section>
        <personal>OCA\ExchangeConnector\Settings\UserSettings</personal>
        <personal-section>OCA\ExchangeConnector\Settings\UserSection</personal-section>
    </settings>

</info>
