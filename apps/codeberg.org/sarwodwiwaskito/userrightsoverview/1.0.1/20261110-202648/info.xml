<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>userrightsoverview</id>
	<name>User Rights Overview</name>
	<summary>Security Dashboard for User Rights Overview</summary>
	<description>A Nextcloud app for administrators to get a comprehensive overview of user rights, permissions, and access control within their instance. Monitor group memberships, team folder access, administrative rights, and user activity in one place.</description>
	<version>1.0.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="tito@almende.org" homepage="https://codeberg.org/sarwodwiwaskito/userrightsoverview">Sarwo Dwi Waskito</author>
	<namespace>UserRightsOverview</namespace>
	<types>
		<admin/>
	</types>

	<category>monitoring</category>
	<category>tools</category>

	<website>https://codeberg.org/sarwodwiwaskito/userrightsoverview</website>
	<bugs>https://codeberg.org/sarwodwiwaskito/userrightsoverview/issues</bugs>

	<screenshot>https://codeberg.org/sarwodwiwaskito/userrightsoverview/raw/branch/main/screenshots/sh-userrightsoverview-1.png</screenshot>

	<dependencies>
		<nextcloud min-version="31" max-version="34"/>
	</dependencies>

	<background-jobs>
		<job>OCA\UserRightsOverview\BackgroundJob\MonthlyReportJob</job>
	</background-jobs>

	<navigations>
		<navigation role="admin">
			<id>userrightsoverview</id>
			<name>User Rights Overview</name>
			<route>userrightsoverview.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
