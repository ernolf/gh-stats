    <!-- Die <database>-Deklaration ist PFLICHT (Lehre rechnungswerk #118):
         Ohne sie nimmt NC an, die App unterstuetze auch Oracle, und erzwingt
         auf NC <= 32 Oracle-Namenslimits bei Migrationen (Tabellenname ohne
         oc_-Praefix max. 22 Zeichen). Genau deshalb lautet das Tabellen-
         praefix dieser App `pwerk_` und nicht `projektwerk_`.
         Element-Reihenfolge laut Store-XSD: php -> database -> nextcloud. -->

    <!--
        Der Nachlauf zum Mailversand.

        **Hier und nicht im `Application::register()`.** Dort stand bis zum
        2026-08-12 ein `$context->registerBackgroundJob(...)` — diese Methode
        gibt es in `IRegistrationContext` **nicht**. Die Folge war kein stiller
        Ausfall des Auftrags, sondern ein Abbruch der gesamten
        App-Registrierung: Nextcloud faengt den Fehler in `Coordinator::register()`
        ab, protokolliert „Error during app service registration" und liefert
        danach auf **jeden** Aufruf der App 503 aus.

        Der von der Plattform vorgesehene Weg ist dieses Element; die
        mitgelieferten Apps (activity, admin_audit) machen es genauso.
    -->
    <background-jobs>
        <job>OCA\Projektwerk\BackgroundJob\MailRetryJob</job>
        <job>OCA\Projektwerk\BackgroundJob\ReplyIntakeJob</job>
        <job>OCA\Projektwerk\BackgroundJob\IdemCleanupJob</job>
        <job>OCA\Projektwerk\BackgroundJob\ForgetRetryJob</job>
        <job>OCA\Projektwerk\BackgroundJob\LicenseRefreshJob</job>
    </background-jobs>

    <!--
        Das Netz fuer einen abgebrochenen Anhang-Umzug (#188): Bricht ein
        Sichtbarkeitswechsel zwischen Datei-Move und DB-Schreiben ab, zeigt der
        Anhang „fehlt", bis er nachgezogen wird. Der Schritt heilt das beim
        Upgrade; von Hand geht es ueber `projektwerk:attachments:relocate`.
    -->
    <repair-steps>
        <post-migration>
            <step>OCA\Projektwerk\Repair\RelocateAttachments</step>
            <!--
                „Was ist neu?"-Fenster (#315): merkt beim Update einer
                Bestandsinstallation, dass sie schon vor dem Fenster bestand.
                post-migration laeuft nur beim Update, nie bei Neuinstallation —
                so bleibt das Fenster bei frischen Installationen still.
            -->
            <step>OCA\Projektwerk\Repair\WhatsNewBootstrap</step>
        </post-migration>
    </repair-steps>

	<!--
		Der Papierkorb dieser App liegt auf der Kommandozeile: Eine Ansicht
		geloeschter Vorgaenge in der Oberflaeche waere ein zweiter Ort, an dem
		Tickets leben — und damit ein zweiter Ort, an dem die
		Sichtbarkeitsregel stimmen muesste.
	-->
	<commands>
		<command>OCA\Projektwerk\Command\TicketRestore</command>
		<command>OCA\Projektwerk\Command\AttachmentsRelocate</command>
		<command>OCA\Projektwerk\Command\AttachmentsVerify</command>
		<command>OCA\Projektwerk\Command\ProjectSetManager</command>
	</commands>

