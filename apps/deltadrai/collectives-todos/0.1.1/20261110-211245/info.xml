<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>collectives_todos</id>
    <name>Collectives Todos</name>
    <summary>See all your to-dos from your collectives in one place</summary>
    <description>See all your to-dos from your collectives in one place. Check something off in the Todos page and it is also checked off on the page it came from.</description>
    <version>0.1.1</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Markus Winter @ deltadrai gmbh</author>
    <namespace>CollectiveTodos</namespace>
    <types>
        <filesystem/>
    </types>
    <category>office</category>
    <website>https://deltadrai.github.io/collectives-todos/</website>
    <bugs>https://github.com/deltadrai/collectives-todos/issues</bugs>
    <repository>https://github.com/deltadrai/collectives-todos</repository>
    <screenshot>https://raw.githubusercontent.com/deltadrai/collectives-todos/main/screenshots/Screenshot--2026-10-10--181052-an.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/deltadrai/collectives-todos/main/screenshots/Screenshot--2026-10-10--181350-an.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/deltadrai/collectives-todos/main/screenshots/Screenshot--2026-10-10--181551-an.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/deltadrai/collectives-todos/main/screenshots/Screenshot--2026-10-10--181728-an.png</screenshot>
    <dependencies>
        <nextcloud min-version="27" max-version="34" />
    </dependencies>
    <commands>
        <command>OCA\CollectiveTodos\Command\InitCollectivesCommand</command>
    </commands>
    <settings>
        <admin>OCA\CollectiveTodos\Settings\Admin</admin>
        <admin-section>OCA\CollectiveTodos\Settings\Section</admin-section>
    </settings>
</info>
