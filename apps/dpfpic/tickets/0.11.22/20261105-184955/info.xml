<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>tickets</id>
    <name>Tickets</name>
    <summary>A simple request desk managed by a dedicated group</summary>
    <description><![CDATA[
Simple ticket management app: users submit requests and members of a
manager group track, prioritize and respond to them from a dedicated
dashboard. Which Nextcloud groups can submit or manage requests, and the
list of ticket categories, are fully configurable from the admin settings.
    ]]></description>
    <version>0.11.22</version>
    <licence>agpl</licence>
    <author>DPFPIC</author>
    <namespace>Tickets</namespace>
    <category>organization</category>
    <website>https://github.com/dpfpic/tickets</website>
    <bugs>https://github.com/dpfpic/tickets/issues</bugs>
    <dependencies>
        <nextcloud min-version="27" max-version="34"/>
    </dependencies>
    <navigations>
        <navigation>
            <id>tickets</id>
            <name>Tickets</name>
            <route>tickets.page.index</route>
            <icon>app.svg</icon>
            <order>10</order>
        </navigation>
    </navigations>
    <settings>
        <admin>OCA\Tickets\Settings\AdminSettings</admin>
        <admin-section>OCA\Tickets\Settings\AdminSection</admin-section>
    </settings>
</info>
