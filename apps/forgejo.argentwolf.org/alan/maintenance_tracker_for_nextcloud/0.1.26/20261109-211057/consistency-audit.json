  "findings": [
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "fitment/ is read at run time and is not in the shipped file set: lib/Service/FitmentPackValidator.php:33 reaches it through dirname(__DIR__, 2).",
        "profiles/ is read at run time and is not in the shipped file set: lib/Service/ProfileCatalog.php:59 reaches it through dirname(__DIR__, 2).",
        "  A release ships only the paths of the keep set, so the tarball lacks them and the app fails in the code that reads them, while the build and the packing pass. In ncmake.mk, keep_extra += fitment profiles ships them."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is maintenance_tracker, the checkout directory is maintenance_tracker_for_nextcloud.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.mjs), Stylelint (stylelint.config.mjs), PHPUnit (tests/phpunit.xml).",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "script-without-workflow",
      "lines": [
        "package.json declares the scripts lint, stylelint, which no installed workflow runs.",
        "  The template lint-eslint of nextcloud/.github runs lint: make workflows-install W=lint-eslint",
        "  The template lint-stylelint of nextcloud/.github runs stylelint: make workflows-install W=lint-stylelint",
        "  A check that no workflow runs on a pull request catches only what the contributor who remembers to run it catches."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "versions-agree",
