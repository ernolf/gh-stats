  "findings": [
    {
      "level": "warn",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml states no <repository>.",
        "  <repository> is the only machine-readable link from a published release back to the source it was built from, and <bugs> is where the App Store page sends a report. Without them a user of the release has no way back to the project."
      ]
    },
    {
      "level": "info",
      "id": "version-drift",
      "lines": [
        "Version 4.1.0 in appinfo/info.xml; package.json states no version.",
        "  Nothing is inconsistent then, and nothing has to be kept in step either. Stating it in both places is what makes a release bump reviewable in the diff."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.js), Stylelint (package.json stylelint key), PHP-CS-Fixer (.php-cs-fixer.dist.php).",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHPUnit configuration: there is no test harness in the checkout, so nothing can be run against a change.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 32 to 33; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.1 is the floor in appinfo/info.xml and in composer.json, platform 8.1."
      ]
    },
    {
      "level": "ok",
      "id": "node-version",
      "lines": [
        "Node 24 stated in .nvmrc, within package.json engines.node ^24.0.0."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    },
    {
      "level": "ok",
      "id": "unreferenced-dependencies",
      "lines": [
        "All 29 declared packages are named somewhere in the checkout, 3 of them by convention."
      ]
    }
