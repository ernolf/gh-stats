    {
      "id": "route-duplicate",
      "level": "warn",
      "places": [
        "GET /index.php/apps/spiresearch/: spiresearch.page.index at lib/Controller/PageController.php:38, spiresearch.search.home at lib/Controller/SearchController.php:37"
      ],
      "lines": [
        "1 verb and path or route name is declared more than once. The server keeps one route per name and takes the first that matches a request, so the other one is never reached.",
        "  GET /index.php/apps/spiresearch/: spiresearch.page.index at lib/Controller/PageController.php:38, spiresearch.search.home at lib/Controller/SearchController.php:37"
      ]
    },
