        "  psr/http-message 2.0, in 3rdparty/ of Nextcloud 33 to 34",
        "  ralouphie/getallheaders 3.0.3, in 3rdparty/ of Nextcloud 33 to 34",
        "  symfony/deprecation-contracts v3.7.1, in 3rdparty/ of Nextcloud 33 to 34"
      ],
      "folds": [
