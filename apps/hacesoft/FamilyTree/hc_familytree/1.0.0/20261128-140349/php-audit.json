      "id": "transaction-manual",
      "level": "info",
      "places": [
        "lib/Service/GenealogyService.php:51",
        "lib/Service/GenealogyService.php:84",
        "lib/Service/GenealogyService.php:117",
        "lib/Service/ResearchImportService.php:459"
