      "id": "config-without-lexicon",
      "level": "info",
      "places": [
        "lib/Controller/PublicVoteController.php:522 getValueInt()",
        "lib/Controller/PublicVoteController.php:524 setValueInt()",
        "lib/Service/Limits.php:111 getValueInt()"
