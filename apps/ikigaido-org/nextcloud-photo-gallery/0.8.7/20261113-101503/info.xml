<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
 <id>photo_gallery</id>
 <name>Photo Gallery</name>
 <summary>Öffentliche Photos-Galerie mit Foto-/Video-Viewer</summary>
 <description>Fotoalben aus Ordnern direkt im Dateien-Menü erstellen. Öffentliche Albumübersicht, eigene Albumseiten mit lightGallery und konfigurierbarem Metadatenpanel. Liest bestehende Photos-Albumfreigaben direkt, ohne Crawling. Veröffentlichung, Kontenauswahl und Gestaltung in den Administrationseinstellungen. Proof of concept für Nextcloud 33.</description>
 <version>0.8.7</version>
 <licence>AGPL-3.0-only</licence>
 <author>Ikigaido Galerie</author>
 <namespace>PhotoGallery</namespace>
 <category>multimedia</category>
 <types><authentication /><prevent_group_restriction /></types>
 <website>https://github.com/ikigaido-org/nextcloud-photo-gallery</website>
 <bugs>https://github.com/ikigaido-org/nextcloud-photo-gallery/issues</bugs>
 <dependencies>
  <php min-version="8.2" />
  <nextcloud min-version="33" max-version="33" />
 </dependencies>
 <settings>
  <admin>OCA\PhotoGallery\Settings\Admin</admin>
  <admin-section>OCA\PhotoGallery\Settings\Section</admin-section>
 </settings>

 <repair-steps><uninstall><step>OCA\PhotoGallery\Repair\EndSwitches</step></uninstall></repair-steps>
</info>
