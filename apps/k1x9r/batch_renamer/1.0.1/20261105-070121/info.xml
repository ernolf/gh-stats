    <licence>agpl</licence>
    <author>k1x9r</author>
    <namespace>BatchRenamer</namespace>
    <category>tools</category>
    <bugs>https://github.com/k1x9r/batch_renamer/issues</bugs>
    <repository type="git">https://github.com/k1x9r/batch_renamer.git</repository>
    <dependencies>
        <nextcloud min-version="28" max-version="35" />
    </dependencies>
