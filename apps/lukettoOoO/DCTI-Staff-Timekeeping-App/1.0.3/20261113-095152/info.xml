<?xml version="1.0"?>
<!-- 
This file is the metadata file for the app.
-->
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd"> <!-- this tells the Nextcloud instance to validate this xml file against the Nextcloud apps info schema, if the xml file is not valid, the app will not be installed or it will be disabled-->
	<id>dctistafftimekeepingapp</id> <!-- must be the same as the app folder name (dctistafftimekeepingapp), and it should be unique across all Nextcloud apps -->
	<name>DCTI Staff Timekeeping App</name> <!-- name of the app that will be displayed in the Nextcloud Apps page-->
	<summary>Nextcloud plugin for DCTI staff timekeeping application, fully integrated using Nextcloud APIs.</summary>
	<description>The project aims at developing a Nextcloud plugin for implementing the timekeeping application for the staff of the Department of Computer and Information Technology. The application is fully integrated into the Nextcloud platform according to the Nextcloud documentation and using Nextcloud dedicated APIs.</description>
	<version>1.0.3</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="luca.mihut@student.upt.ro" homepage="https://github.com/lukettoOoO">Luca-Adrian Mihut</author>
	<namespace>DCTIStaffTimekeepingApp</namespace> <!-- used for php autoloading, maps the \OCA\DCTIStaffTimekeepingApp prefix to the lib/ directory-->
	<category>files</category>
	<category>monitoring</category>
	<category>organization</category>
	<category>tools</category>
	<bugs>https://gitlab.upt.ro/luca.mihut/dcti-staff-timekeeping-app</bugs>
	<dependencies>
		<nextcloud min-version="31" max-version="33"/> <!-- specifies the minimum and maximum versions of Nextcloud that the app is compatible with; in case a user tries to install the app on a Nextcloud instance with a version outside this range, the app will not be installed or it will be disabled-->
	</dependencies>
	<navigations>
		<navigation>
			<id>dctistafftimekeepingapp</id>
			<name>Timekeeping</name>
			<route>dctistafftimekeepingapp.page.index</route> <!-- this is the route that will be called when the user clicks on the app icon, it basically calls the index function in the page controller; this route is defined in routes.php-->
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
