{
  "findings": [
    {
      "id": "autoloader-generic",
      "level": "warn",
      "places": [],
      "lines": [
        "The app ships no composer/autoload.php, so the server registers its generic loader for lib/ and looks every class up in the file system.",
        "  A composer/composer.json with config.vendor-dir \".\", config.optimize-autoloader true, a config.autoloader-suffix and autoload.psr-4 {\"OCA\\\\EmployeePortal\\\\\": \"../lib/\"} makes composer dump-autoload write composer/autoload.php with a class map; the code of the app does not change."
      ]
    },
    {
      "id": "autoloader-authoritative",
      "level": "warn",
      "places": [
        "composer.json: config.classmap-authoritative"
      ],
      "lines": [
        "The Composer autoloader is optimized beyond level 1. The manual allows only config.optimize-autoloader: an authoritative class map breaks the upgrade of the app, and APCu is no required extension.",
        "  composer.json: config.classmap-authoritative"
      ]
    },
    {
      "id": "frontend-url-without-route",
      "level": "warn",
      "places": [
        "src/services/pages.js:51 /apps/employee_portal/api/v1/pages/{site}/{page}"
      ],
      "lines": [
        "The frontend or a template builds 1 URL below /apps/employee_portal/ that no route of the app matches. The request fails at run time.",
        "  src/services/pages.js:51 /apps/employee_portal/api/v1/pages/{site}/{page}"
      ]
    },
    {
      "id": "openapi-missing",
      "level": "info",
      "places": [],
      "lines": [
        "The app has 9 OCS routes and no openapi.json. Clients of OCS are generated from such a specification, and nothing else tells them what these routes take and return."
      ]
    }
  ],
