<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>mail_fulltextsearch</id>
	<name>Full Text Search - Mail</name>
	<summary>Index the content of your mail</summary>
	<description><![CDATA[Extension to the Full Text Search app to index your users' mail.]]></description>
	<version>2.0.2</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="info@madbob.org" homepage="">Roberto Guido</author>
	<namespace>Mail_FullTextSearch</namespace>
	<category>search</category>
	<bugs>https://github.com/madbob/mail_fulltextsearch</bugs>

	<dependencies>
		<nextcloud min-version="34" max-version="35"/>
		<app>mail</app>
		<app>fulltextsearch</app>
	</dependencies>

	<fulltextsearch>
		<provider>OCA\Mail_FullTextSearch\Provider\MailProvider</provider>
	</fulltextsearch>
</info>
