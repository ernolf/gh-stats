<?xml version="1.0"?>
<info>
  <id>ironclaw_talk_bridge</id>
  <name>Ironclaw Talk Bridge</name>
  <summary>Bot-free Nextcloud Talk inbound bridge for Ironclaw</summary>
  <description>Listens to Talk chat events, applies synchronous room-type and mention gating, and forwards signed events to Ironclaw.</description>
  <version>0.2.0</version>
  <licence>agpl</licence>
  <author mail="ops@kiga-gramschatz.de" homepage="https://kiga-gramschatz.de">Kiga</author>
  <namespace>IronclawTalkBridge</namespace>
  <settings>
    <admin-section>OCA\IronclawTalkBridge\Settings\AdminSection</admin-section>
    <admin>OCA\IronclawTalkBridge\Settings\AdminSettings</admin>
  </settings>
  <commands>
    <command>OCA\IronclawTalkBridge\Command\ShowBridgeMetrics</command>
  </commands>
  <dependencies>
    <nextcloud min-version="31" max-version="35"/>
  </dependencies>
</info>
