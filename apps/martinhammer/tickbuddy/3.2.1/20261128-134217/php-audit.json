        "  GET /ocs/v2.php/apps/tickbuddy/api/notes/bounds  ocs.tickbuddy.note.bounds  lib/Controller/NoteController.php:96",
        "  POST /ocs/v2.php/apps/tickbuddy/api/notes/append  ocs.tickbuddy.note.append  lib/Controller/NoteController.php:165",
        "  GET /ocs/v2.php/apps/tickbuddy/api/ticks/bounds  ocs.tickbuddy.tick.bounds  lib/Controller/TickController.php:97"
      ]
    }
