<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>travelmanager</id>
	<name>Travel Manager</name>
	<summary>Easily manage your travel itineraries</summary>
	<description><![CDATA[
Travel Manager automatically extracts relevant information from emails using LLM, and lets you easily manage all your travel itineraries.
	]]></description>
	<version>1.18.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="me@martinhammer.com" homepage="https://github.com/martinhammer">Martin Hammer</author>
	<namespace>TravelManager</namespace>
	<category>ai</category>
	<category>organization</category>
	<category>tools</category>
	<website>https://github.com/martinhammer/travelmanager</website>
	<bugs>https://github.com/martinhammer/travelmanager</bugs>
	<dependencies>
		<nextcloud min-version="33" max-version="36"/>
	</dependencies>
	<background-jobs>
		<job>OCA\TravelManager\BackgroundJob\DispatcherJob</job>
	</background-jobs>
	<settings>
		<admin>OCA\TravelManager\Settings\AdminSettings</admin>
		<admin-section>OCA\TravelManager\Settings\AdminSection</admin-section>
		<personal>OCA\TravelManager\Settings\PersonalSettings</personal>
		<personal-section>OCA\TravelManager\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
		<navigation>
			<id>travelmanager</id>
			<name>Travel Manager</name>
			<route>travelmanager.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
