<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>nct</id>
    <name>NCT</name>
    <summary>Send and receive your phone's text messages from Nextcloud</summary>
    <description>Read and reply to text messages on your Android phone via Nextcloud.</description>
    <version>0.1.0</version>
    <licence>AGPL-3.0-or-later</licence>
    <author mail="haircut@gmail.com" homepage="https://adammonsen.com">Adam Monsen</author>
    <namespace>Nct</namespace>
    <category>social</category>
    <bugs>https://selfhostbook.com/contact/</bugs>
    <dependencies>
        <nextcloud min-version="34" max-version="36"/>
    </dependencies>
    <commands>
        <command>OCA\Nct\Command\RegisterWebhook</command>
        <command>OCA\Nct\Command\RefreshContacts</command>
        <command>OCA\Nct\Command\InspectContactsCache</command>
    </commands>
    <navigations>
        <navigation>
            <name>NCT</name>
            <route>nct.page.index</route>
            <icon>app.svg</icon>
            <order>50</order>
        </navigation>
    </navigations>
</info>
