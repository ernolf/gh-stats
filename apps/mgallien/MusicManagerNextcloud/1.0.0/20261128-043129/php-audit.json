{
  "findings": [
    {
      "id": "autoloader-generic",
      "level": "warn",
      "places": [],
      "lines": [
        "The app ships no composer/autoload.php, so the server registers its generic loader for lib/ and looks every class up in the file system.",
        "  A composer/composer.json with config.vendor-dir \".\", config.optimize-autoloader true, a config.autoloader-suffix and autoload.psr-4 {\"OCA\\\\MusicManager\\\\\": \"../lib/\"} makes composer dump-autoload write composer/autoload.php with a class map; the code of the app does not change."
      ]
    },
    {
      "id": "namespace-mismatch",
      "level": "warn",
      "places": [
        "lib/Hooks/MusicManagerFilesHooks.php:15 OCA\\Elisa\\Hooks\\ElisaFilesHooks, by its path OCA\\MusicManager\\Hooks\\MusicManagerFilesHooks",
        "lib/Hooks/MusicManagerFilesHooksStatic.php:13 OCA\\Elisa\\Hooks\\ElisaFilesHooksStatic, by its path OCA\\MusicManager\\Hooks\\MusicManagerFilesHooksStatic"
      ],
      "lines": [
        "2 classes in lib/ whose name does not follow PSR-4 below OCA\\MusicManager, the namespace the server derives from <namespace> of info.xml. The loader of the server does not find such a class.",
        "  lib/Hooks/MusicManagerFilesHooks.php:15 OCA\\Elisa\\Hooks\\ElisaFilesHooks, by its path OCA\\MusicManager\\Hooks\\MusicManagerFilesHooks",
        "  lib/Hooks/MusicManagerFilesHooksStatic.php:13 OCA\\Elisa\\Hooks\\ElisaFilesHooksStatic, by its path OCA\\MusicManager\\Hooks\\MusicManagerFilesHooksStatic"
      ]
    },
    {
