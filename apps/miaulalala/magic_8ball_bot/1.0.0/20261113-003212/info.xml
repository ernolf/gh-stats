<info xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>magic_8ball_bot</id>
	<name>Magic 8-Ball</name>
	<summary><![CDATA[Ask the Magic 8-Ball a yes/no question in Talk using /8ball]]></summary>
	<description><![CDATA[Use the /8ball slash command in any Talk conversation to ask a yes/no question and receive a mystical answer.]]></description>

	<version>1.0.0</version>
	<licence>agpl</licence>

	<author>Anna Larch</author>

	<namespace>Magic8BallBot</namespace>

	<types>
		<prevent_group_restriction />
	</types>

	<category>social</category>

	<website>https://github.com/miaulalala/magic_8ball_bot</website>
	<bugs>https://github.com/miaulalala/magic_8ball_bot/issues</bugs>

	<dependencies>
		<nextcloud min-version="33" max-version="34" />
	</dependencies>

	<repair-steps>
		<install>
			<step>OCA\Magic8BallBot\Migration\InstallBot</step>
		</install>
	</repair-steps>
</info>
