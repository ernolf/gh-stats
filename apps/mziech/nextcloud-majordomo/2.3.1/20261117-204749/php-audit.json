    {
      "id": "job-time-sensitivity",
      "level": "info",
      "places": [
        "lib/Job/ProcessInboxJob.php OCA\\Majordomo\\Job\\ProcessInboxJob",
        "lib/Job/ReadCurrentListMembersJob.php OCA\\Majordomo\\Job\\ReadCurrentListMembersJob",
        "lib/Job/WritePendingChangesJob.php OCA\\Majordomo\\Job\\WritePendingChangesJob"
      ],
      "lines": [
        "3 timed jobs do not say whether they are time sensitive. A job that sets TIME_INSENSITIVE with setTimeSensitivity() is moved to the maintenance window of the server; whether a job is heavy enough for that only its maintainer knows.",
        "  lib/Job/ProcessInboxJob.php OCA\\Majordomo\\Job\\ProcessInboxJob",
        "  lib/Job/ReadCurrentListMembersJob.php OCA\\Majordomo\\Job\\ReadCurrentListMembersJob",
        "  lib/Job/WritePendingChangesJob.php OCA\\Majordomo\\Job\\WritePendingChangesJob"
      ]
    },
