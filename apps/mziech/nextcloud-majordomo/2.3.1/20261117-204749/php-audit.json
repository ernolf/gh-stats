    {
      "id": "template-inline-style",
      "level": "info",
      "places": [
        "templates/index.php:2 style= attribute"
      ],
      "lines": [
        "1 inline style in templates/. The default Content Security Policy of the server allows inline style; a response whose policy disallows it drops them. A stylesheet added with OCP\\Util::addStyle() holds in both cases.",
        "  templates/index.php:2 style= attribute"
      ]
    },
    {
      "id": "transaction-manual",
      "level": "info",
      "places": [
        "lib/Service/InboundService.php:135",
        "lib/Service/MailingListService.php:167",
        "lib/Service/MailingListService.php:183",
        "lib/Service/OutboundService.php:103",
        "lib/Service/OutboundService.php:132"
      ],
      "lines": [
        "5 transactions are opened and closed by hand. The trait TTransactional has atomic() since Nextcloud 24 and atomicRetry() since Nextcloud 27, which repeats a transaction that ran into a deadlock, as the manual recommends.",
        "  lib/Service/InboundService.php:135",
        "  lib/Service/MailingListService.php:167",
        "  lib/Service/MailingListService.php:183",
        "  lib/Service/OutboundService.php:103",
