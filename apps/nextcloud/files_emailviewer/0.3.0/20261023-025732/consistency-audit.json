  "findings": [
    {
      "level": "warn",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml states no <repository>.",
        "  <repository> is the only machine-readable link from a published release back to the source it was built from, and <bugs> is where the App Store page sends a report. Without them a user of the release has no way back to the project."
      ]
    },
    {
      "level": "info",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 28 to 35; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server).",
        "  min-version 28 reaches below the oldest maintained major (32), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as ^24.0.0 (package.json engines.node).",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it.",
        "  The workflows read node-version from a variable, which is not resolved here, so whether CI builds on that major is not decidable from the checkout."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (eslint.config.mjs), Psalm (psalm.xml), PHPUnit (tests/phpunit.xml), PHP-CS-Fixer (.php-cs-fixer.dist.php), REUSE (REUSE.toml).",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "ok",
      "id": "versions-agree",
      "lines": [
        "Version 0.3.0 in appinfo/info.xml and package.json."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.2 is the floor in appinfo/info.xml and in composer.json, platform 8.2."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    },
    {
      "level": "ok",
      "id": "unreferenced-dependencies",
