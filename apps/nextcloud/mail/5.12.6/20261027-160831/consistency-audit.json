  "findings": [
    {
      "level": "warn",
      "id": "php-extensions",
      "lines": [
        "2 PHP extensions are required by composer but not listed as <lib> in appinfo/info.xml:",
        "  iconv (bytestream/horde-stringprep, sabberworm/php-css-parser)",
        "  intl (bytestream/horde-stringprep)",
        "  A Nextcloud server need not load them. The server checks <lib> before it enables the app; composer only checks where it runs. Without the <lib> the app is enabled anyway and the first call into a missing one fails at runtime."
      ]
    },
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "resources/ is read at run time and is not in the shipped file set: lib/Dns/Resolver.php:23 reaches it through __DIR__.",
        "  A release ships only the paths of the keep set (the ncmake core and ncmake.mk), so the tarball lacks it and the app fails in the code that reads it, while the build and the packing pass. In ncmake.mk, keep_extra += resources ships it."
      ]
    },
    {
      "level": "warn",
      "id": "license-drift",
      "lines": [
        "The licence is stated differently: agpl (appinfo/info.xml), AGPL-3.0-only (package.json).",
        "  Whoever redistributes the app has to pick one of them, and the App Store shows the one from info.xml.",
        "  agpl in appinfo/info.xml is a deprecated App Store value, shown there as AGPLv3+, which is AGPL-3.0-or-later. With min-version 32 info.xml can state an SPDX id instead."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as ^24.0.0 (package.json engines.node), false (test.yml).",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "2 declared packages are named nowhere in the checkout: autoprefixer, url-loader.",
        "  Searched as literal names over 1,509 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "ok",
