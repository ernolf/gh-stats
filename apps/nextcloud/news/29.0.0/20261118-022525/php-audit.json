    {
      "id": "route-duplicate",
      "level": "warn",
      "places": [
        "POST /index.php/apps/news/items/{itemId}/share/{shareRecipientId}: news.item.share at appinfo/routes.php:16 routes, news.item.share at appinfo/routes.php:16 routes",
        "news.item.share: news.item.share at appinfo/routes.php:16 routes, news.item.share at appinfo/routes.php:16 routes",
        "news.feed_api.update: news.feed_api.update at appinfo/routes.php:16 routes, news.feed_api.update at appinfo/routes.php:16 routes"
      ],
      "lines": [
        "3 verbs and paths or route names are declared more than once. The server keeps one route per name and takes the first that matches a request, so the other one is never reached.",
        "  POST /index.php/apps/news/items/{itemId}/share/{shareRecipientId}: news.item.share at appinfo/routes.php:16 routes, news.item.share at appinfo/routes.php:16 routes",
        "  news.item.share: news.item.share at appinfo/routes.php:16 routes, news.item.share at appinfo/routes.php:16 routes",
        "  news.feed_api.update: news.feed_api.update at appinfo/routes.php:16 routes, news.feed_api.update at appinfo/routes.php:16 routes"
      ]
    },
    {
      "id": "dev-tools-in-root",
      "level": "info",
      "places": [],
      "lines": [
        "phpunit/phpunit is in require-dev of composer.json. The manual recommends a vendor-bin/ of bamarni/composer-bin-plugin per tool, so that the dependencies of a tool cannot conflict with those of the app."
      ]
    },
    {
      "id": "ocp-deprecated",
      "level": "info",
      "places": [
        "lib/Controller/PageController.php:66 OCP\\Util::getVersion(): deprecated since Nextcloud 31; Use \\OCP\\ServerVersion::getVersion",
        "lib/Controller/PageController.php:134 OCP\\AppFramework\\Http\\ContentSecurityPolicy: deprecated since Nextcloud 14; Use one of our stricter CSP policies"
      ],
      "lines": [
        "2 uses in 1 file of the public API that is deprecated in Nextcloud 33 to 35. The text of the tag names the replacement where it has one.",
        "  lib/Controller/PageController.php:66 OCP\\Util::getVersion(): deprecated since Nextcloud 31; Use \\OCP\\ServerVersion::getVersion",
        "  lib/Controller/PageController.php:134 OCP\\AppFramework\\Http\\ContentSecurityPolicy: deprecated since Nextcloud 14; Use one of our stricter CSP policies"
      ]
    },
