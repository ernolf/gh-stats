  "findings": [
    {
      "level": "warn",
      "id": "php-extensions",
      "lines": [
        "1 PHP extension is required by composer but not listed as <lib> in appinfo/info.xml:",
        "  pdo (composer.json)",
        "  A Nextcloud server need not load it. The server checks <lib> before it enables the app; composer only checks where it runs. Without the <lib> the app is enabled anyway and the first call into the extension fails at runtime."
      ]
    },
    {
      "level": "warn",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "assets/ is read at run time and is not in the shipped file set: lib/TemplateManager.php:208 reaches it through __DIR__.",
        "  A release ships only the paths of the keep set (the ncmake core and ncmake.mk), so the tarball lacks it and the app fails in the code that reads it, while the build and the packing pass. In ncmake.mk, keep_extra += assets ships it."
      ]
    },
    {
      "level": "info",
