    {
      "id": "autoloader-not-optimized",
      "level": "warn",
      "places": [],
      "lines": [
        "composer/autoload.php is there, but composer.json does not set config.optimize-autoloader, so no class map is dumped at release time and every class is looked up in the file system."
      ]
    },
    {
      "id": "namespace-mismatch",
      "level": "warn",
      "places": [
        "lib/Vendor/Office365/Runtime/ClientObjectCollection.php:14 OCA\\SharePoint\\Vendor\\Office365\\Runtime\\PageInfo, by its path OCA\\SharePoint\\Vendor\\Office365\\Runtime\\ClientObjectCollection"
      ],
      "lines": [
        "1 class in lib/ whose name does not follow PSR-4 below OCA\\SharePoint, the namespace the server derives from <namespace> of info.xml. The loader of the server does not find such a class.",
