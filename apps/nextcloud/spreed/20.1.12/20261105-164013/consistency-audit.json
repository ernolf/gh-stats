      "post-update-cmd": [
        "@composer bin all update --ansi",
        "\"vendor/bin/mozart\" compose",
        "composer dump-autoload"
      ],
      "test:unit": "vendor/bin/phpunit -c tests/php/phpunit.xml --colors=always --fail-on-warning --fail-on-risky"
    },
