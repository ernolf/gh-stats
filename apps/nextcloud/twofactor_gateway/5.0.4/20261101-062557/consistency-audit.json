        "mkdir -p lib/Vendor"
      ],
      "post-install-cmd": [
        "@composer bin all install --ansi",
        "php -d error_reporting=E_ALL\\&~E_DEPRECATED\\&~E_USER_DEPRECATED vendor-bin/php-scoper/vendor/humbug/php-scoper/bin/php-scoper add-prefix --force && > lib/Vendor/.gitkeep",
