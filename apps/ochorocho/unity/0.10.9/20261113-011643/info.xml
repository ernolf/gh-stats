<?xml version="1.0"?>
<info>
    <id>unity</id>
    <name>Unity</name>
    <summary>Unified issue and ticket tracking across Jira, GitLab, Redmine, GitHub and Asana</summary>
    <description><![CDATA[Unity brings your issues from Jira, GitLab, Redmine, GitHub and Asana into a single,
sortable, cached view inside Nextcloud. Search across all your trackers, read issue details and comments,
add comments, and log time — using your own API tokens configured per user.]]></description>
    <version>0.10.9</version>
    <licence>agpl</licence>
    <author>Jochen Roth</author>
    <namespace>Unity</namespace>
    <category>integration</category>
    <category>tools</category>
    <website>https://github.com/ochorocho/unity</website>
    <bugs>https://github.com/ochorocho/unity/issues</bugs>
    <repository type="git">https://github.com/ochorocho/unity.git</repository>
    <screenshot>https://raw.githubusercontent.com/ochorocho/unity/main/screenshots/main.png</screenshot>
    <dependencies>
        <nextcloud min-version="31" max-version="34"/>
    </dependencies>
    <background-jobs>
        <job>OCA\Unity\BackgroundJob\SyncIssuesJob</job>
    </background-jobs>
    <settings>
        <personal>OCA\Unity\Settings\Personal</personal>
        <personal-section>OCA\Unity\Settings\PersonalSection</personal-section>
    </settings>
    <navigations>
        <navigation>
            <id>unity</id>
            <name>Unity</name>
            <route>unity.page.index</route>
            <icon>app.svg</icon>
            <order>10</order>
        </navigation>
    </navigations>
</info>
