	<summary>Management of people, training, finances and events for the leader team</summary>
	<summary lang="de">Verwaltung von Adressen, Schulungen, Finanzen und Veranstaltungen für die Leiterrunde</summary>
	<description><![CDATA[Interne Verwaltungs-App der Leiterrunde: Adressen, Schulungsnachweise (inkl. Führungszeugnisse), Finanzen (Kontoauszüge, Zahlungsverpflichtungen, Auslagen) sowie Veranstaltungen mit Anmelde-Sync zur öffentlichen Website.]]></description>
	<version>0.0.3</version>
	<licence>agpl</licence>
	<author>Leiterrunde</author>
	<namespace>Leiterrunde</namespace>
	<category>organization</category>
	<bugs>https://github.com/ollimaz/leiterrunde/issues</bugs>
	<repository>https://github.com/ollimaz/leiterrunde</repository>
	<dependencies>
		<php min-version="8.1"/>
		<nextcloud min-version="29" max-version="36"/>
	</dependencies>
	<repair-steps>
		<post-migration>
			<step>OCA\Leiterrunde\Migration\MigrateNotifyRoles</step>
			<step>OCA\Leiterrunde\Migration\DeriveBirthYear</step>
		</post-migration>
		<install>
			<step>OCA\Leiterrunde\Migration\MigrateNotifyRoles</step>
			<step>OCA\Leiterrunde\Migration\DeriveBirthYear</step>
		</install>
	</repair-steps>
	<settings>
		<admin>OCA\Leiterrunde\Settings\RolesPage</admin>
		<admin>OCA\Leiterrunde\Settings\StoragePage</admin>
