<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>leiterrunde_veranstaltungen</id>
	<name>Events</name>
	<name lang="de">Veranstaltungen</name>
	<summary>Events and registrations for the leader team</summary>
	<summary lang="de">Veranstaltungen und Anmeldungen für die Leiterrunde</summary>
	<description><![CDATA[Events module of the Leiterrunde suite – requires the Leiterrunde app. Events with team, budget, registrations and registration sync to the public website.]]></description>
	<version>0.0.3</version>
	<licence>agpl</licence>
	<author>Leiterrunde</author>
	<namespace>LeiterrundeVeranstaltungen</namespace>
	<category>organization</category>
	<bugs>https://github.com/ollimaz/leiterrunde_veranstaltungen/issues</bugs>
	<repository>https://github.com/ollimaz/leiterrunde_veranstaltungen</repository>
	<dependencies>
		<nextcloud min-version="29" max-version="36"/>
	</dependencies>
	<background-jobs>
		<job>OCA\LeiterrundeVeranstaltungen\BackgroundJob\SyncRetryJob</job>
	</background-jobs>
	<repair-steps>
		<post-migration>
			<step>OCA\LeiterrundeVeranstaltungen\Migration\MigrateConfig</step>
		</post-migration>
		<install>
			<step>OCA\LeiterrundeVeranstaltungen\Migration\MigrateConfig</step>
		</install>
	</repair-steps>
	<settings>
		<admin>OCA\LeiterrundeVeranstaltungen\Settings\SyncPage</admin>
	</settings>
	<navigations>
		<navigation>
			<name>Events</name>
			<route>leiterrunde_veranstaltungen.page.index</route>
			<icon>leiterrunde_veranstaltungen.svg</icon>
		</navigation>
	</navigations>
