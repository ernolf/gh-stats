<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>olvid</id>
	<name>Olvid</name>
	<summary>Use Nextcloud as an Olvid directory.</summary>
	<description>Use your Nextcloud instance as an Olvid directory.

- 📑 Directory: Start an Olvid discussion with any other Nextcloud user in one click
- 👥 Groups: Associate an Olvid discussion with a Nextcloud group
- 🪄 Magic Links: easily bind your Olvid identity to your Nextcloud account
- ✉️ Security: Your messages are still exchanged using Olvid cryptographic protocols, your Nextcloud server cannot access it.
	</description>
	<version>0.0.7</version>
	<licence>agpl</licence>
	<author mail="nextcloud@olvid.io" homepage="https://olvid.io">Olvid</author>
	<namespace>Olvid</namespace>
	<documentation>
		<user>https://github.com/olvid-io/Nextcloud-App</user>
		<developer>https://github.com/olvid-io/Nextcloud-App</developer>
	</documentation>
	<category>integration</category>
	<category>social</category>
	<website>https://olvid.io</website>
	<bugs>https://github.com/olvid-io/Nextcloud-App/issues</bugs>
	<repository >https://github.com/olvid-io/Nextcloud-App</repository>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-profile-1.png</screenshot>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-profile-2.png</screenshot>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-users-1.png</screenshot>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-users-2.png</screenshot>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-groups-1.png</screenshot>
	<screenshot>https://github.com/olvid-io/Nextcloud-App/raw/main/img/screenshots/screenshot-olvid.png</screenshot>
	<dependencies>
		<nextcloud min-version="30" max-version="35"/>
	</dependencies>

	<background-jobs>
		<job>OCA\Olvid\Cron\SyncCronTask</job>
	</background-jobs>
	<repair-steps>
		<post-migration><step>OCA\Olvid\Migration\RepairStep</step></post-migration>
		<install><step>OCA\Olvid\Migration\InstallRepairStep</step></install>
		<uninstall><step>OCA\Olvid\Migration\UninstallRepairStep</step></uninstall>
	</repair-steps>
	<commands>
		<command>OCA\Olvid\Command\SyncCommand</command>
	</commands>
	<settings>
		<admin-section>OCA\Olvid\Settings\AdminSection</admin-section>
	</settings>
	<navigations>
		<navigation>
			<id>olvid</id>
			<name>Olvid</name>
			<route>olvid.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
