  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 2.53.0, package.json says 2.30.2.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "script-without-config",
      "lines": [
        "composer.json script psalm calls psalm, and no Psalm configuration is in the checkout.",
        "  psalm --threads=1",
        "composer.json scripts cs:check, cs:fix call php-cs-fixer, and no PHP-CS-Fixer configuration is in the checkout.",
        "  php-cs-fixer fix --dry-run --diff",
        "  The command is there to be run, so whoever runs it gets a tool that has nothing to go by - and CI, if it runs the script, reports the failure as the change under test."
      ]
    },
    {
      "level": "info",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 30 to 35; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server).",
        "  min-version 30 reaches below the oldest maintained major (32), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node stated as >=22 (package.json engines.node).",
        "  Not stated in .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (.eslintrc.js, superseded form), PHPUnit (tests/phpunit.xml).",
        " ESLint is configured in .eslintrc.js: ESLint 9 reads the flat config only; the eslintrc form, an .eslintrc file or the eslintConfig key in package.json, is ignored unless the run is pinned to ESLint 8.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "1 declared package is named nowhere in the checkout: style-loader.",
        "  Searched as literal names over 736 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, package.json, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.1 is the floor in appinfo/info.xml and in composer.json, platform 8.1."
      ]
    },
    {
      "level": "ok",
      "id": "php-extensions",
      "lines": [
        "appinfo/info.xml lists every PHP extension composer requires beyond a standard server as <lib>: bcmath."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines).",
        "  make reads GNUmakefile and never Makefile; it runs only with make -f <name>."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    }
  ]
