  "findings": [
    {
      "id": "autoloader-generic",
      "level": "warn",
      "places": [],
      "lines": [
        "The app ships no composer/autoload.php, so the server registers its generic loader for lib/ and looks every class up in the file system.",
        "  A composer/composer.json with config.vendor-dir \".\", config.optimize-autoloader true, a config.autoloader-suffix and autoload.psr-4 {\"OCA\\\\QOwnNotesAPI\\\\\": \"../lib/\"} makes composer dump-autoload write composer/autoload.php with a class map; the code of the app does not change."
      ]
    },
    {
      "id": "namespace-mismatch",
      "level": "warn",
      "places": [
        "lib/capabilities.php:21 OCA\\QOwnNotesAPI\\Capabilities, by its path OCA\\QOwnNotesAPI\\capabilities"
      ],
      "lines": [
        "1 class in lib/ whose name does not follow PSR-4 below OCA\\QOwnNotesAPI, the namespace the server derives from <namespace> of info.xml. The loader of the server does not find such a class.",
        "  lib/capabilities.php:21 OCA\\QOwnNotesAPI\\Capabilities, by its path OCA\\QOwnNotesAPI\\capabilities"
      ]
