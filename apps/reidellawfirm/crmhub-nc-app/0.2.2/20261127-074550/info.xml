<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>crmhub_nc_app</id>
	<name>Reidel CRM Hub</name>
	<summary>Lightweight CRM that links Nextcloud Contacts, Files, Deck, Mail and Activity into a unified client record</summary>
	<description><![CDATA[**Reidel CRM Hub** turns Nextcloud into a relational CRM for client and project work without replacing any existing app.

It maintains a local cache of contact records linked to Nextcloud Contacts vCards, attaches projects (with their case folder in Files and their card in Deck), records a unified activity timeline, and exposes a Dashboard widget for at-a-glance review.

Heavy email/funnel automation is offloaded to Windmill via a small REST surface; a Groundhogg importer keeps existing CRM contacts in sync.
	]]></description>
	<version>0.2.1</version>
	<licence>GPL-3.0-or-later</licence>
    <author mail="schuyler@reidellawfirm.com">Schuyler "Rocky" Reidel, Reidel Law Firm</author>
	<namespace>ReidelCrm</namespace>
	<category>organization</category>
	<category>integration</category>
	<website>https://github.com/Reidel-Law-Firm/crmhub-nc-app</website>
	<bugs>https://github.com/Reidel-Law-Firm/crmhub-nc-app/issues</bugs>
    <repository type="git">https://github.com/Reidel-Law-Firm/crmhub-nc-app</repository>
	<dependencies>
		<nextcloud min-version="28" max-version="34"/>
		<php min-version="8.1"/>
	</dependencies>

	<navigations>
		<navigation>
			<name>Hugo Preview App</name>
			<route>crmhub_nc_app.page.hugo</route>
			<order>100</order>
		</navigation>
	</navigations>

	<background-jobs>
		<job>OCA\ReidelCrm\BackgroundJob\SyncGroundhoggJob</job>
		<job>OCA\ReidelCrm\BackgroundJob\PurgeSyncLogJob</job>
		<job>OCA\ReidelCrm\BackgroundJob\MailPollingJob</job>
		<job>OCA\ReidelCrm\BackgroundJob\ActivityLogPruningJob</job>
		<job>OCA\ReidelCrm\BackgroundJob\OverdueProjectJob</job>
		<job>OCA\ReidelCrm\BackgroundJob\CalendarSyncJob</job>
	</background-jobs>
	<commands>
		<command>OCA\ReidelCrm\Command\SyncGroundhogg</command>
	</commands>
	<activity>
		<settings>
			<setting>OCA\ReidelCrm\Activity\Setting</setting>
		</settings>
		<filters>
			<filter>OCA\ReidelCrm\Activity\Filter</filter>
		</filters>
		<providers>
			<provider>OCA\ReidelCrm\Activity\Provider</provider>
		</providers>
	</activity>
	<settings>
		<admin>OCA\ReidelCrm\Settings\Admin</admin>
		<admin-section>OCA\ReidelCrm\Settings\AdminSection</admin-section>
	</settings>
</info>
