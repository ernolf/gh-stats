<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>projectmanager</id>
	<name>Project Manager</name>
	<summary>Track project hours and progress across points, leaves and days</summary>
	<description><![CDATA[Multi-project hour and progress tracker. Break work into estimated
Points, log day-to-day work as Leaves, and let the app compute done/remaining hours
automatically from a largest-remainder percentage split per point and day. Includes
Features (proposal vs. status) and Tests (validation log) views, plus .xlsx export.]]></description>
	<version>1.1.3</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="ricardo@grangeia.pt">Ricardo</author>
	<author mail="ricardograngeia@gmail.com">Ricardo</author>
	<namespace>ProjectManager</namespace>
	<category>organization</category>
	<bugs>https://github.com/ricgrangeia/nextcloud-projectmanager/issues</bugs>
	<repository type="git">https://github.com/ricgrangeia/nextcloud-projectmanager.git</repository>
	<website>https://github.com/ricgrangeia/nextcloud-projectmanager</website>
	<dependencies>
		<php min-version="8.2" max-version="8.5"/>
		<database min-version="8.0">mysql</database>
		<database>pgsql</database>
		<database>sqlite</database>
		<nextcloud min-version="34" max-version="34"/>
	</dependencies>
