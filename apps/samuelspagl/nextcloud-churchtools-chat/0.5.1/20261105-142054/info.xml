<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>churchtools_chat</id>
    <name>ChurchTools Chat</name>
    <summary>ChurchTools chat inside Nextcloud (experimental)</summary>
    <description><![CDATA[A chat-only Nextcloud app for ChurchTools Chat with person search, direct conversations, a native Vue interface, Markdown rendering and Smart Picker support. This app is experimental: it may change, be incomplete, or behave unexpectedly, and should be used with care.]]></description>
    <version>0.5.1</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Samuel Spagl</author>
    <namespace>ChurchToolsChat</namespace>
    <category>social</category>
    <website>https://github.com/samuelspagl/nextcloud-churchtools-chat</website>
    <bugs>https://github.com/samuelspagl/nextcloud-churchtools-chat/issues</bugs>
    <repository type="git">https://github.com/samuelspagl/nextcloud-churchtools-chat.git</repository>
    <documentation>
        <user>https://github.com/samuelspagl/nextcloud-churchtools-chat#readme</user>
        <admin>https://github.com/samuelspagl/nextcloud-churchtools-chat#readme</admin>
        <developer>https://github.com/samuelspagl/nextcloud-churchtools-chat#readme</developer>
    </documentation>
    <dependencies>
        <php min-version="8.1"/>
        <nextcloud min-version="31" max-version="34"/>
    </dependencies>
    <navigations>
        <navigation>
            <name>ChurchTools Chat</name>
            <route>churchtools_chat.page.index</route>
            <icon>app.svg</icon>
            <order>6</order>
        </navigation>
    </navigations>
    <settings>
        <personal-section>OCA\ChurchToolsChat\Settings\PersonalSection</personal-section>
        <personal>OCA\ChurchToolsChat\Settings\Personal</personal>
        <admin-section>OCA\ChurchToolsChat\Settings\AdminSection</admin-section>
        <admin>OCA\ChurchToolsChat\Settings\Admin</admin>
    </settings>
</info>
