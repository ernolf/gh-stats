<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>hidden_groups</id>
    <name>Hidden groups</name>
    <summary>Keep groups that are only meant for configuration out of sharing</summary>
    <description><![CDATA[Some groups are only meant for configuration, such as enabling an app for everyone, and are far too large to share with.

Admins can hide such groups in the sharing settings. Nobody can share files or folders with a hidden group, and hidden groups do not show up in sharing suggestions. Existing shares with a hidden group keep working, but cannot get more permissions.]]></description>
    <version>1.0.1</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>tosa</author>
    <namespace>HiddenGroups</namespace>
    <types>
        <prevent_group_restriction/>
    </types>
    <category>security</category>
    <bugs>https://github.com/sara-nl/nextcloud-hidden-groups/issues</bugs>
    <repository type="git">https://github.com/sara-nl/nextcloud-hidden-groups.git</repository>
    <screenshot>https://raw.githubusercontent.com/sara-nl/nextcloud-hidden-groups/main/screenshots/settings.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/sara-nl/nextcloud-hidden-groups/main/screenshots/share-dialog.png</screenshot>

    <dependencies>
        <php min-version="8.2"/>
        <nextcloud min-version="34.0.2" max-version="35"/>
    </dependencies>

    <settings>
        <admin>OCA\HiddenGroups\Settings\Admin</admin>
    </settings>

    <collaboration>
        <plugins>
            <plugin type="collaborator-search" share-type="SHARE_TYPE_GROUP">OCA\HiddenGroups\Collaboration\HideGroupsPlugin</plugin>
        </plugins>
    </collaboration>
</info>
