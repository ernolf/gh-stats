  "findings": [
    {
      "level": "warn",
      "id": "version-drift",
      "lines": [
        "Version drift: appinfo/info.xml says 0.5.43-beta.1, package.json says 0.5.43.",
        "  The App Store and the server read info.xml; everything on the node side reads package.json. Whichever is behind, a release ends up carrying two version numbers, and only one of them reaches the user."
      ]
    },
    {
      "level": "warn",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml states no <repository>.",
        "  <repository> is the only machine-readable link from a published release back to the source it was built from, and <bugs> is where the App Store page sends a report. Without them a user of the release has no way back to the project."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is noteberg, the checkout directory is NoteBerg.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 30 to 36; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server).",
        "  min-version 30 reaches below the oldest maintained major (32), which means the code has to keep working with APIs that are no longer tested upstream."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "Node 24 stated in build-android.yml, build-linux.yml, build-macos.yml, build-windows.yml, ci.yml, release.yml.",
        "  Not stated in engines.node in package.json, .nvmrc, so nothing keeps the other places from drifting away from it."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: ESLint (.eslintrc.json, superseded form).",
        " ESLint is configured in .eslintrc.json: ESLint 9 reads the flat config only; the eslintrc form, an .eslintrc file or the eslintConfig key in package.json, is ignored unless the run is pinned to ESLint 8.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHPUnit configuration: there is no test harness in the checkout, so nothing can be run against a change.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "2 declared packages are named nowhere in the checkout: @tauri-apps/plugin-shell, @testing-library/user-event.",
        "  Searched as literal names over 435 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence MIT (appinfo/info.xml, package.json).",
        "  MIT in appinfo/info.xml is a deprecated App Store value, shown there as MIT. An SPDX id there needs a <nextcloud> min-version of 31 or higher.",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    }
  ]
