  "findings": [
    {
      "level": "warn",
      "id": "script-without-config",
      "lines": [
        "package.json scripts lint, lint:fix call eslint, and no ESLint configuration is in the checkout.",
        "  eslint --ext .js,.vue src",
        "  The command is there to be run, so whoever runs it gets a tool that has nothing to go by - and CI, if it runs the script, reports the failure as the change under test."
      ]
    },
    {
      "level": "info",
      "id": "app-id",
      "lines": [
        "The app id is linkboard, the checkout directory is linkboard-nextcloud.",
        "  The server finds an app by its directory name, so the installed directory has to be named after the id. A checkout can be named anything, which is why this is a note and not a defect - but a tarball built from this directory name would not load."
      ]
    },
    {
      "level": "info",
      "id": "php-support-max",
      "lines": [
        "appinfo/info.xml caps PHP at max-version 8.5.",
        "  A server on a newer PHP refuses to enable the app, so this cap has to be raised deliberately with every PHP release, not left where it was."
      ]
    },
    {
      "level": "info",
      "id": "node-version",
      "lines": [
        "No Node version is stated: no engines.node, no .nvmrc, and no node-version in the installed workflows.",
        "  Whoever builds the app uses whatever Node they have, and a build that works on one machine is then not evidence for the next."
      ]
    },
    {
      "level": "info",
      "id": "tooling",
      "lines": [
        "Tooling in the checkout: none of the configurations this audit looks for.",
        " No ESLint configuration: nothing checks the frontend sources, so a wrong import is found by the build or not at all.",
        " No Stylelint configuration: stylesheets are unchecked, and a mistake in CSS fails silently instead of loudly.",
        " No Psalm configuration: the PHP side has no static analysis, which is what catches a wrong type before the server does.",
        " No PHPUnit configuration: there is no test harness in the checkout, so nothing can be run against a change.",
        " No PHP-CS-Fixer configuration: no coding standard is applied to the PHP sources, so formatting is settled in review instead of by a command.",
        " No REUSE configuration: licensing is not machine-checkable, which the App Store and every distribution ask for.",
        " No EditorConfig configuration: indentation is whatever each contributor's editor does."
      ]
    },
    {
      "level": "info",
      "id": "unreferenced-dependencies",
      "lines": [
        "3 declared packages are named nowhere in the checkout: @nextcloud/babel-config, @nextcloud/eslint-config, @nextcloud/stylelint-config.",
        "  Searched as literal names over 406 files, package.json excluded apart from its non-dependency fields, lockfiles excluded; then as an ESLint shorthand, as what TypeScript takes from a tsconfig, and as a peer of an installed package in package-lock.json. A package loaded some other way is not named anywhere either, so this is a list to check, not a list to remove."
      ]
    },
    {
      "level": "info",
      "id": "license-drift",
      "lines": [
        "Licence AGPL-3.0-or-later (appinfo/info.xml, composer.json).",
        "  No LICENSES/ directory, so the licence text itself is not in the checkout, which is what REUSE and the distributions check for."
      ]
    },
    {
      "level": "ok",
      "id": "versions-agree",
      "lines": [
        "Version 1.11.2 in appinfo/info.xml and package.json."
      ]
    },
    {
      "level": "ok",
      "id": "repository-link",
      "lines": [
        "appinfo/info.xml links its repository and its bug tracker."
      ]
    },
    {
      "level": "ok",
      "id": "nextcloud-support",
      "lines": [
        "Declares Nextcloud 32 to 34; the oldest maintained major is 32 (as of 2026-09), the newest released 35 (the release tags of nextcloud/server)."
      ]
    },
    {
      "level": "ok",
      "id": "php-support",
      "lines": [
        "PHP 8.2 is the floor in appinfo/info.xml and in composer.json."
      ]
    },
    {
      "level": "ok",
      "id": "lockfiles",
      "lines": [
        "package-lock.json (lockfileVersion 3) and composer.lock in the checkout."
      ]
    },
    {
      "level": "ok",
      "id": "ncmake-bootstrap",
      "lines": [
        "The ncmake bootstrap stub is in place (21 lines)."
      ]
    },
    {
      "level": "ok",
      "id": "runtime-dirs-not-shipped",
      "lines": [
        "Every directory the shipped PHP reaches through __DIR__ and the frontend through linkTo is in the shipped file set (the ncmake core and ncmake.mk)."
      ]
    }
  ]
