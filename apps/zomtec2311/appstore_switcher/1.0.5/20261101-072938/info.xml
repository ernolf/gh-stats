<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>appstore_switcher</id>
    <name>App Store Switcher</name>
    <summary>Switch between official and custom app stores</summary>
    <description><![CDATA[**Allows administrators to dynamically switch the app store between the official Nextcloud app store and a custom app store without having to manually edit the config file.**

- 🛡️ Only accessible for administration.
- ✏️ No manual editing of the config file
- 👉 Note that this app does not have a direct link, but can be accessed via the administration settings after installation]]></description>
    <version>1.0.5</version>
    <licence>agpl</licence>
    <author mail="wtoedt@gmail.com" homepage="https://github.com/zomtec2311/appstore_switcher">Wolfgang Tödt</author>
    <namespace>AppStoreSwitcher</namespace>
    <category>tools</category>
    <category>integration</category>
    <category>organization</category>
    <bugs>https://github.com/zomtec2311/appstore_switcher/issues</bugs>
    <screenshot small-thumbnail="https://raw.githubusercontent.com/zomtec2311/appstore_switcher/refs/heads/main/custom-appstore.png">https://raw.githubusercontent.com/zomtec2311/appstore_switcher/refs/heads/main/appstore_switcher1.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/zomtec2311/appstore_switcher/refs/heads/main/appstore_switcher1.png</screenshot>
	<website>https://github.com/zomtec2311/appstore_switcher</website>
	<repository type="git">https://github.com/zomtec2311/appstore_switcher</repository>
    <dependencies>
        <nextcloud min-version="32" max-version="35"/>
    </dependencies>
    <settings>
        <admin-section>OCA\AppStoreSwitcher\Settings\AdminSection</admin-section>
        <admin>OCA\AppStoreSwitcher\Settings\AdminSettings</admin>
    </settings>
</info>
