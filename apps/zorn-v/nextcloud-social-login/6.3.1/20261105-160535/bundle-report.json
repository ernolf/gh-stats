  "findings": [
    {
      "level": "info",
      "id": "stylesheets-outside-the-build",
      "lines": [
        "css holds 2 stylesheets, 5,649 B, and no page of this build loads any of them: no entry in js is named after one, and none is reached from an entry that is.",
        "  Loaded from PHP: hide_default_login.css (lib/AlternativeLogin/DefaultLoginShow.php), styles.css (lib/AppInfo/Application.php).",
        "  Each is loaded from PHP or built into the bundle, so none is left without a loader. Where the build writes its stylesheets somewhere else, --css=DIR names that directory."
      ]
    },
