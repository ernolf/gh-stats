#!/usr/bin/env -S LC_CTYPE=C.UTF-8 LC_MESSAGES=C bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz <raphael.gradenwitz@googlemail.com>
# SPDX-License-Identifier: MIT
#
# gh-nc-appslist - write an app list for 'gh-nc-appsdiag -l' from the Nextcloud App
# Store catalogue: one line "owner/repo version" per source repository, or
# "host/<path> version" for one on another host, with the newest
# stable version the App Store ships for it. Which repositories qualify is
# decided by gh-nc-appstore-targets (releases, recent enough), so this list and
# the sampler's targets agree. With --lines, the newest version of each of as
# many release lines before the newest is listed as well. A release that is no
# release asset is listed under the repository and tag gh-nc-sources found for
# it. The list is written to a file that is meant to be trimmed by hand, so an
# existing one is only replaced when that is asked for.

# == Config ==
# The same site config gh-nc-appstore-targets reads, with the same precedence:
# built-in default < gh-stats.env < environment.
GH_STATS_ENV="${GH_STATS_ENV:-/etc/gh-stats/gh-stats.env}"
# shellcheck disable=SC1090 # the site config is a run-time path
if [ -r "$GH_STATS_ENV" ]; then
	_env_snapshot="$(export -p)"
	set -a; . "$GH_STATS_ENV"; set +a
	eval "$_env_snapshot"
	unset _env_snapshot
fi

# The list lands where gh-nc-appsdiag keeps its logs, unless -o says otherwise.
APPSDIAG_DIR="${NC_APPSDIAG_DIR:-${HOME}/Projekte/appstorestats}"
APPLIST_FILE="${APPLIST_FILE:-${APPSDIAG_DIR}/apps-all.txt}"

APPSTORE_TARGETS="${APPSTORE_TARGETS:-gh-nc-appstore-targets}"
APPSTORE_SOURCE="${APPSTORE_SOURCE:-download}"
APPSTORE_CACHE="${APPSTORE_CACHE:-/var/lib/gh-stats/apps.json}"
APPSTORE_APPDATA_FILE="${APPSTORE_APPDATA_FILE:-}"
APPSTORE_EBTB_DB="${APPSTORE_EBTB_DB:-}"
APPSTORE_SINCE_YEAR="${APPSTORE_SINCE_YEAR:-$(($(date -u +%Y) - 1))}"
# Release lines before the newest whose newest version is listed as well.
APPLIST_LINES="${APPLIST_LINES:-0}"
# Repositories that publish the releases of an app developed in another one, as
# a whole owner or as owner/repo. Such an app is listed under the repository it
# is developed in, taken from its issue tracker or website. Space- or
# comma-separated.
APPLIST_RELEASE_REPOS="${APPLIST_RELEASE_REPOS:-nextcloud-releases christianlupus-nextcloud/cookbook-releases}"
# The repository and the tag of each release that is no release asset, as
# gh-nc-sources writes them; without the file no such release is listed.
SOURCES_CACHE="${SOURCES_CACHE:-$(dirname "$APPSTORE_CACHE")/sources.json}"

SQLITE="${SQLITE_BIN:-/usr/bin/sqlite3}"
JQ="${JQ_BIN:-jq}"

set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

usage() {
	cat <<'EOF'
Usage: gh-nc-appslist [-f] [-s <year>] [-L <n>] [-v <file>] [-o <file>|-]

Writes the list of apps for 'gh-nc-appsdiag -l' from the Nextcloud App Store
catalogue, one line per repository an app is developed in:

  # App Store, ebtb source, releases since 2025, 2026-10-03: 564 repositories
  nextcloud/calendar 6.6.2
  nextcloud/cookbook 0.11.10
  codeberg.org/someone/someapp 1.2.0
  ...

The repositories are the ones gh-nc-appstore-targets picks: every app whose
releases are downloaded from GitHub, or from a Forgejo or Gitea host, which the
line then names in front, and whose newest release is from <year> or later. Each one is listed once, with the newest stable version the App Store
ships for it - nightlies and versions with a suffix such as -beta.1 or -rc.1 do
not count. Where several apps come from one repository, the newest version among
them stands for it. A repository without a single stable release is left out.

With -L the repository has a line for each of its newest release lines as
well: the newest stable version of each of the <n> lines before the newest, a
release line being the major.minor of a version. With 0.7.5, 0.7.6, 0.8.0 and
0.8.1 in the catalogue, -L 1 lists 0.8.1 and 0.7.6.
The list is meant to be trimmed by hand before 'gh-nc-appsdiag -l' runs it, so an
existing file is not replaced without -f.

Some apps are developed in one repository and publish their releases from
another. The release repository carries the same tags on the same commits, so
gh-nc-appsdiag could measure either; the list names the one the app is developed
in, which is where its issues go and under which its earlier runs were logged.
APPLIST_RELEASE_REPOS names the release repositories, each as a whole owner
(every repository of that owner) or as owner/repo, separated by spaces or
commas. For an app whose release comes from one of them, the repository it is
developed in is taken from the app's issue tracker URL in the catalogue, or from
its website if the issue tracker is not on GitHub; if neither names a GitHub
repository, the release repository itself is listed. Setting the variable
replaces the default, so a repository is added by repeating the default with it:

  APPLIST_RELEASE_REPOS="nextcloud-releases christianlupus-nextcloud/cookbook-releases someone/app-releases" gh-nc-appslist -f

A release that is no release asset, downloaded from a host of its own, a
package registry or a file in a repository, names no repository the targets
hold. It is listed under the repository gh-nc-sources found for it in
SOURCES_CACHE, the host in front unless it is GitHub, as long as that
repository has a tag for it and the newest such release of the app is from
<year> or later. Where the App Store lists one tag under several versions, the
newest of them stands for the tag, which is measured once.

With -v the list holds the versions a file names instead of the newest one of
each app: one "<app-id> <version>" per line, # starts a comment. Each of them is
listed under its repository as above, once per repository and version; one the
catalogue does not ship as a stable release from a listed repository is left out.
A version built from the tag of a newer version is listed as that one.

  -o, --output <file>    write the list to <file>, - for stdout
                         (default: $NC_APPSDIAG_DIR/apps-all.txt)
  -f, --force            replace an existing list file
  -s, --since <year>     keep repositories with a release from <year> or later
                         (default: last year)
  -L, --lines <n>        list the newest version of <n> release lines before
                         the newest as well (default: 0)
  -v, --versions <file>  list the versions <file> names
  -h, --help             this text

Environment (or /etc/gh-stats/gh-stats.env):
  APPLIST_RELEASE_REPOS  release repositories, as above (default:
                         nextcloud-releases christianlupus-nextcloud/cookbook-releases)
  APPLIST_FILE           the list file, as -o
  APPLIST_LINES          as -L
  NC_APPSDIAG_DIR        base directory (default: $HOME/Projekte/appstorestats)
  APPSTORE_SINCE_YEAR    as -s
  APPSTORE_TARGETS       the gh-nc-appstore-targets command
  APPSTORE_SOURCE        where the catalogue comes from: download, appdata or
                         ebtb, as for gh-nc-appstore-targets
  APPSTORE_CACHE         the catalogue of the download source
  APPSTORE_APPDATA_FILE  the catalogue of the appdata source
  APPSTORE_EBTB_DB       the nc-apps database of the ebtb source
  SOURCES_CACHE          sources.json of gh-nc-sources, optional
                         (default: next to APPSTORE_CACHE)
EOF
}

force=0
versions=""
while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		-f|--force) force=1 ;;
		-v|--versions) [ $# -ge 2 ] || die "$1 needs a file"; versions="$2"; shift ;;
		-o|--output) [ $# -ge 2 ] || die "$1 needs a file"; APPLIST_FILE="$2"; shift ;;
		-s|--since)
			[ $# -ge 2 ] || die "$1 needs a year"
			[[ "$2" =~ ^[0-9]{4}$ ]] || die "not a year: $2"
			APPSTORE_SINCE_YEAR="$2"; shift ;;
		-L|--lines) [ $# -ge 2 ] || die "$1 needs a number"; APPLIST_LINES="$2"; shift ;;
		*) echo "unknown argument: $1" >&2; exit 1 ;;
	esac
	shift
done

if [ "$APPLIST_FILE" != - ] && [ -e "$APPLIST_FILE" ] && [ "$force" -eq 0 ]; then
	die "$APPLIST_FILE exists; -f replaces it, -o writes another file"
fi
[ -z "$versions" ] || [ -r "$versions" ] || die "cannot read $versions"
[[ "$APPLIST_LINES" =~ ^[0-9]+$ ]] || die "not a number of lines: $APPLIST_LINES"

# == Repositories ==
# gh-nc-appstore-targets writes its result to a file; point it at a scratch one. A
# lone comma as whole-owner list leaves no owner whole (an empty value would
# fall back to the default), so every owner comes back as owner/repo pairs with
# the recency cutoff applied. Its report names the scratch file, so it is only
# shown when the call fails.
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
APPSTORE_TARGETS_FILE="$work/targets.json" APPSTORE_WHOLE_OWNERS="," \
	APPSTORE_SINCE_YEAR="$APPSTORE_SINCE_YEAR" "$APPSTORE_TARGETS" 2>"$work/targets.log" \
	|| { cat "$work/targets.log" >&2; die "$APPSTORE_TARGETS failed"; }

# == Catalogue ==
# The copy gh-nc-appstore-targets just evaluated. The download source has refreshed
# the cache by now, so all three only need resolving.
case "$APPSTORE_SOURCE" in
	download) apps_json="$APPSTORE_CACHE" ;;
	appdata)
		apps_json="$APPSTORE_APPDATA_FILE"
		[ -n "$apps_json" ] || die "appdata source needs APPSTORE_APPDATA_FILE here" ;;
	ebtb)
		[ -r "$APPSTORE_EBTB_DB" ] || die "ebtb apps.db not readable: '$APPSTORE_EBTB_DB'"
		apps_json="$("$SQLITE" "$APPSTORE_EBTB_DB" "SELECT json_data_file FROM apps WHERE platform='all'")" ;;
	*) die "unknown APPSTORE_SOURCE: '$APPSTORE_SOURCE'" ;;
esac
[ -r "$apps_json" ] || die "catalogue not readable: '$apps_json'"

# == List ==
read -r -a _release <<< "${APPLIST_RELEASE_REPOS//,/ }"
release_json="$(printf '%s\n' "${_release[@]}" | "$JQ" -R . | "$JQ" -sc 'map(select(length>0))')"
# The asked versions as a set of "<app-id> <version>" keys, null without -v.
want_json=null
if [ -n "$versions" ]; then
	want_json="$("$JQ" -R -n -c '[inputs | sub("#.*"; "") | [splits("[ \t]+") | select(length > 0)]
		| select(length >= 2) | {key: "\(.[0]) \(.[1])", value: true}] | from_entries' "$versions")"
fi
sources_json="$SOURCES_CACHE"
if [ ! -r "$sources_json" ]; then
	sources_json="$work/sources.json"
	echo '{}' >"$sources_json"
fi

# Only stable releases count: no nightly, no version with a pre-release suffix.
# Of each app id only the newest of them counts, with -L the newest of each of
# its newest lines: an app that moved to another repository keeps its old
# releases in the catalogue, and the repository it left would stay listed with
# a version nobody installs any more. Several app ids can come from one
# repository; per line the newest version among them stands for it. With -v
# every asked version counts instead, once per repository.
# A release that is no release asset takes its repository and tag from
# sources.json, and the recency cutoff from its own newest such release, as the
# targets know nothing of it. The App Store can list one tag under several
# versions; each of them becomes the newest version built from that tag, so the
# tag is measured once and its result is filed under the version that names it.
list="$("$JQ" -r --slurpfile t "$work/targets.json" --slurpfile s "$sources_json" \
	--argjson release "$release_json" --argjson want "$want_json" \
	--argjson lines "$APPLIST_LINES" --arg since "$APPSTORE_SINCE_YEAR" '
	def gh: (. // "") | capture("^https?://github\\.com/(?<o>[^/#?]+)/(?<r>[^/#?]+)")
		| "\(.o)/\(.r | sub("\\.git$"; ""))";
	def vkey: split(".") | map(tonumber);
	def newest_lines: group_by(.version | vkey | .[0:2]) | map(max_by(.version | vkey))
		| sort_by(.version | vkey) | reverse | .[0:$lines + 1];
	def asset: (.download | split("/")) as $p
		| $p[5] == "releases" and ($p[2] == "github.com" or $p[6] == "download");
	$t[0].targets as $targets
	| ([ $s[0].apps[]? | select(.repo != null) | . as $x | .versions[] | select(.tag != null)
	     | { key: "\($x.id) \(.version)",
	         value: { src: ((if $x.host == "github.com" then "" else $x.host + "/" end) + $x.repo),
	                  tag } } ] | from_entries) as $tagged
	| (if type == "array" then . else .data end)
	| [ .[] | . as $a
	    | [ .releases[]?
	        | select(.download != null and (.isNightly | not)
	                 and (.version | test("^[0-9]+(\\.[0-9]+)*$"))) ] as $stable
	    | ($stable | map(select(asset | not))) as $other
	    | (($other | max_by(.version | vkey)) // {} | (.created // "")[0:4] >= $since) as $recent
	    | (if $want == null then $stable | newest_lines[]
	       else $stable[] | select($want["\($a.id) \(.version)"]) end)
	    | if asset then
	        (.download | split("/")) as $p
	        | ($p[2] | ascii_downcase) as $host
	        | ($p[3] + "/" + $p[4]) as $gh
	        | ((if $host == "github.com" then "" else $host + "/" end) + $gh) as $dl
	        | select($targets | index($dl))
	        | { version, tag: null,
	            src: (if $host == "github.com" and (($release | index($p[3])) or ($release | index($gh)))
	                  then ([$a.issueTracker, $a.website | gh] | first // $dl)
	                  else $dl end) }
	      else
	        $tagged["\($a.id) \(.version)"] as $src
	        | select($src != null and $recent)
	        | { version: ([ $other[].version | select($tagged["\($a.id) \(.)"].tag == $src.tag) ]
	                      | max_by(vkey)),
	            src: $src.src, tag: $src.tag }
	      end ]
	| if $want == null then group_by(.src | ascii_downcase)
	    | map(group_by(if .tag then [.tag] else [null, .version] end)
	          | map(max_by(.version | vkey)) | newest_lines[])
	  else unique_by([(.src | ascii_downcase), (.version | vkey)]) end
	| sort_by((.src | ascii_downcase), (.version | vkey))
	| .[] | "\(.src) \(.version)"
' "$apps_json")"

n="$(printf '%s\n' "$list" | grep -c .)" || true
what=repositories
[ -z "$versions" ] && [ "$APPLIST_LINES" -eq 0 ] || what=versions
{
	printf '# App Store, %s source, releases since %s, %s: %s %s\n' \
		"$APPSTORE_SOURCE" "$APPSTORE_SINCE_YEAR" "$(date -u +%Y-%m-%d)" "$n" "$what"
	[ "$n" -eq 0 ] || printf '%s\n' "$list"
} >"$work/list.txt"

if [ "$APPLIST_FILE" = - ]; then
	cat "$work/list.txt"
else
	mkdir -p "$(dirname "$APPLIST_FILE")"
	mv "$work/list.txt" "$APPLIST_FILE"
	echo "gh-nc-appslist: wrote $n $what to $APPLIST_FILE" >&2
fi
