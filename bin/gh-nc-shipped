#!/usr/bin/env -S LC_CTYPE=C.UTF-8 LC_MESSAGES=C bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz <raphael.gradenwitz@googlemail.com>
# SPDX-License-Identifier: MIT
#
# gh-nc-shipped - list the apps the Nextcloud server ships, with the version of
# each in the release archive of every release of the maintained server majors
# and of the newest end-of-life major, and in the daily archive of master. The
# archive is a zip with its directory at the end, so ranges read the directory,
# core/shipped.json, version.php and the appinfo/info.xml of every shipped app
# without downloading the archive. The result replaces its previous copy, from
# which a release already read and master with an unchanged ETag are taken over
# instead of being read again.
#
# With -x it unpacks apps/<id>/ of one server release archive instead, from a
# single range, so that what a release ships of an app can be compared with what
# its source builds.

# == Config ==
# Optional site config shared with gh-stats and gh-release-sampler. If
# /etc/gh-stats/gh-stats.env exists it is sourced here, so its assignments feed
# the ${VAR:-default} reads below. Precedence is built-in default <
# gh-stats.env < environment. Point GH_STATS_ENV at another path to use a
# different file.
GH_STATS_ENV="${GH_STATS_ENV:-/etc/gh-stats/gh-stats.env}"
# shellcheck disable=SC1090 # the site config is a run-time path
if [ -r "$GH_STATS_ENV" ]; then
	_env_snapshot="$(export -p)"
	set -a; . "$GH_STATS_ENV"; set +a
	eval "$_env_snapshot"
	unset _env_snapshot
fi

STATE_DIR="${GH_STATS_DIR:-/var/lib/gh-stats}"
SHIPPED_FILE="${SHIPPED_FILE:-${STATE_DIR}/shipped.json}"

GITHUB_URL="${GITHUB_URL:-https://github.com}"
GITHUB_RAW_URL="${GITHUB_RAW_URL:-https://raw.githubusercontent.com}"
SERVER_REPO="${SERVER_REPO:-nextcloud/server}"
# The owner under which a shipped app with a repository of its own lives.
SERVER_APPS_OWNER="${SERVER_APPS_OWNER:-${SERVER_REPO%%/*}}"
SERVER_SCHEDULE_URL="${SERVER_SCHEDULE_URL:-${GITHUB_RAW_URL}/wiki/${SERVER_REPO}/Maintenance-and-Release-Schedule.md}"
SERVER_DOWNLOAD_URL="${SERVER_DOWNLOAD_URL:-https://download.nextcloud.com/server}"
SERVER_RELEASES_URL="${SERVER_DOWNLOAD_URL}/releases"
SERVER_MASTER_ARCHIVE="${SERVER_DOWNLOAD_URL}/daily/latest-master.zip"
# The directory every path of the archive starts with.
ARCHIVE_ROOT="nextcloud"
# How often a request that times out or fails transiently is repeated.
RETRIES=10
# How many archives a run reads before it leaves the older releases not yet
# read to the next run; one takes about a minute. The newest release of each
# major and master are read whatever the count.
SHIPPED_MAX_READS="${SHIPPED_MAX_READS:-5}"
# The app types the server never restricts to groups, its
# AppManager::$protectedAppTypes.
PROTECTED_APP_TYPES="filesystem prelogin authentication logging prevent_group_restriction"

JQ="${JQ_BIN:-jq}"
GIT="${GIT_BIN:-git}"

set -euo pipefail
# A repository that does not exist or is private must fail, not ask for a login.
export GIT_TERMINAL_PROMPT=0

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARNING: $*" >&2; }

usage() {
	cat <<'EOF'
Usage: gh-nc-shipped [-f <file>]
       gh-nc-shipped -x <server-version|master> <app-id> <dir>

Writes the apps the Nextcloud server ships to <file>, as JSON:

  {
    "releases": [
      {"major": 36, "version": "36.0.0 dev", "ref": "master",
       "archive": "https://download.nextcloud.com/server/daily/latest-master.zip",
       "etag": "...", "published": "2026-10-24T23:30:00Z", "latest": true,
       "apps": [{"id": "activity", "name": "Activity", "version": "...",
                 "repo": "nextcloud/activity", "path": "", "ref": "master",
                 "enabled": "default", "restrictable": true}, ...]},
      {"major": 35, "version": "35.0.2", "ref": "v35.0.2", "latest": true, ...},
      {"major": 35, "version": "35.0.1", "ref": "v35.0.1", "latest": false, ...},
      ...
    ],
    "since": {"activity": 9, ...},
    "initial": {"9": ["activity", ...], ...}
  }

The releases are every release of each major the server's maintenance
schedule lists as supported and of the newest major it lists as end of life,
and master from its daily archive. latest is true for the newest release of
each of these majors and for master. A release stays once its major has left
the schedule, with latest false. Each archive's core/shipped.json names the
apps it ships, its version.php the server version, and the appinfo/info.xml of
each app its name and version.

enabled is always for an app the core/shipped.json of the archive lists under
alwaysEnabled, which cannot be disabled, default for one it lists under
defaultEnabled only, which a new installation enables, and optional for any
other. It is null where that shipped.json lacks one of the two lists.

restrictable is false for an app whose <types> in its appinfo/info.xml hold a
type the server never restricts to groups: filesystem, prelogin,
authentication, logging or prevent_group_restriction. It is true for any other.

An app of the server tree has the server repository with the path apps/<id> at
the tag of the release, or at master. An app with a repository of its own under
the owner of the server has that repository at the tag of the server release,
or at its default branch for master. An app whose source is in neither is left
out.

since is the lowest server major whose first release, M.0.0, or one of the
archives read lists the app, for each app of a release with latest. initial
keeps the shipped.json of every M.0.0, an empty list where the tag has none, so
each one is fetched only once.

A release whose archive the previous <file> holds is taken over from it
unread, master only while its ETag is unchanged, unless an app of its entry has
no enabled or restrictable yet. The newest release of each major and master are read whatever
the count; an older release only while the run has read fewer than
SHIPPED_MAX_READS archives, the newest first, so the rest is left to the next
run. A major whose newest tag has no archive yet has the release before it as
its newest, and master without an archive keeps its previous entry.

-x unpacks apps/<app-id>/ of the archive of that server release, 35.0.2 or
v35.0.2, or of the daily archive of master, into <dir>/<app-id>/ and prints the
URL of the archive. Nothing else is read or written.

Options:
  -f, --file <file>  the file to read and replace (default: $GH_STATS_DIR/shipped.json)
  -x, --extract <server-version|master> <app-id> <dir>
                     unpack the app from the server release archive
  -h, --help         this text

Environment (or /etc/gh-stats/gh-stats.env):
  SHIPPED_FILE           as -f
  GH_STATS_DIR           state directory (default: /var/lib/gh-stats)
  SERVER_REPO            the server repository (default: nextcloud/server)
  SERVER_APPS_OWNER      the owner of the apps with a repository of their own
                         (default: the owner of SERVER_REPO)
  SERVER_SCHEDULE_URL    the maintenance schedule (default: the page
                         Maintenance-and-Release-Schedule of the server wiki)
  SERVER_DOWNLOAD_URL    the download base, with releases/ and daily/ below it
                         (default: https://download.nextcloud.com/server)
  SHIPPED_MAX_READS      the archives a run reads before it leaves the older
                         releases to the next run (default: 5)
EOF
}

x_server=""
while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		-f|--file) [ $# -ge 2 ] || die "$1 needs a file"; SHIPPED_FILE="$2"; shift ;;
		-x|--extract)
			[ $# -ge 4 ] || die "$1 needs a server version, an app id and a directory"
			x_server="${2#v}" x_id="$3" x_dir="$4"
			shift 3
			;;
		*) echo "unknown argument: $1" >&2; exit 1 ;;
	esac
	shift
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

prev='{}'
[ ! -r "$SHIPPED_FILE" ] || prev="$("$JQ" -c . "$SHIPPED_FILE")"

# == Zip reading ==
# The bytes of a file as one string of lowercase hex pairs.
hex() { od -An -v -tx1 "$1" | tr -d ' \n'; }

# le <hex> <offset> <bytes>: the little-endian number at that byte offset.
le() {
	local v=0 i
	for ((i = $2 + $3 - 1; i >= $2; i--)); do v=$((v * 256 + 16#${1:i*2:2})); done
	echo "$v"
}

# fetch <url> <etag> <first> <last> <file>: bytes first to last of an archive.
# If-Match refuses them once the archive is another build than the ETag names,
# so a rebuilt master cannot mix two builds; --max-filesize stops a server that
# ignores the range from sending the whole archive.
fetch() {
	local n=$(($4 - $3 + 1))
	curl -fsS --retry "$RETRIES" --max-time 120 --max-filesize "$n" -r "$3-$4" -H "If-Match: $2" -o "$5" "$1"
	[ "$(stat -c %s "$5")" = "$n" ] || die "$1: $n bytes asked from $3, $(stat -c %s "$5") received"
}

# header <name> <file>: the value of the last such header in a curl -I dump,
# which with redirects holds one block per response.
header() {
	tr -d '\r' < "$2" | awk -v k="$1" 'tolower(substr($0, 1, length(k) + 1)) == k ":" { v = substr($0, length(k) + 2); sub(/^ +/, "", v) } END { print v }'
}

# directory <file> [<app-id> <file>]: the central directory entries of the
# files this script reads, one line each: name, compression method, compressed
# size, offset of the local header, and the CRC-32 and uncompressed size as the
# little-endian hex the gzip trailer takes. The directory is read as a stream of
# bytes, so it is never held whole.
# With an app id, the entries below apps/<id>/ instead, with the name as hex
# after the other fields, so that a byte outside ASCII or a space in it is kept;
# the second file gets the offset of the first entry that follows the last of
# them in the archive, nothing when none follows.
directory() {
	od -An -v -tx1 "$1" | awk -v root="$ARCHIVE_ROOT" -v app="${2:-}" -v next_file="${3:-}" '
		BEGIN {
			for (i = 0; i < 16; i++) d[substr("0123456789abcdef", i + 1, 1)] = i
			for (i = 32; i < 127; i++) c[sprintf("%02x", i)] = sprintf("%c", i)
			info = "^" root "/apps/[^/]+/appinfo/info\\.xml$"
			prefix = root "/apps/" app "/"
			last = -1
		}
		function le(o, n,   v, j) {
			v = 0
			for (j = o + n - 1; j >= o; j--) v = v * 256 + d[substr(h[j], 1, 1)] * 16 + d[substr(h[j], 2, 1)]
			return v
		}
		{
			for (f = 1; f <= NF; f++) {
				if (phase == 0) {
					h[got++] = $f
					if (got < 46) continue
					if (h[0] h[1] h[2] h[3] != "504b0102") { bad = 1; exit }
					namelen = le(28, 2); skip = le(30, 2) + le(32, 2)
					off = le(42, 4); offs[n++] = off
					name = ""; raw = ""; got = 0; phase = 1
				} else if (phase == 1) {
					name = name (($f in c) ? c[$f] : "?")
					raw = raw $f
					if (++got < namelen) continue
					if (app == "") {
						if (name == root "/version.php" || name == root "/core/shipped.json" || name ~ info)
							printf "%s %d %.0f %.0f %s %s\n", name, le(10, 2), le(20, 4), off, h[16] h[17] h[18] h[19], h[24] h[25] h[26] h[27]
					} else if (index(name, prefix) == 1) {
						printf "%d %.0f %.0f %s %s %s\n", le(10, 2), le(20, 4), off, h[16] h[17] h[18] h[19], h[24] h[25] h[26] h[27], raw
						if (off > last) last = off
					}
					got = 0; phase = skip ? 2 : 0
				} else if (++got == skip) {
					got = 0; phase = 0
				}
			}
		}
		END {
			if (bad) { print "not a zip central directory" > "/dev/stderr"; exit 1 }
			if (next_file == "") exit
			for (i = 0; i < n; i++) if (offs[i] > last && (nxt == "" || offs[i] < nxt)) nxt = offs[i]
			printf "%s", (nxt == "" ? "" : sprintf("%.0f", nxt)) > next_file
		}'
}

# inflate <url> <name> <method> <crc> <isize> <file>: the data of one entry,
# as it lies in the archive, to stdout. Deflated data becomes a gzip stream with
# a fixed header and the CRC-32 and size of the directory as its trailer, so
# gzip inflates it and checks it.
inflate() {
	local t i
	case "$3" in
		0) cat "$6" ;;
		8)
			{
				printf '\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x03'
				cat "$6"
				t="$4$5"
				for ((i = 0; i < ${#t}; i += 2)); do
					printf '%b' "\\x${t:i:2}"
				done
			} | gzip -dc
			;;
		*) die "$1: $2 has compression method $3" ;;
	esac
}

# extract <url> <etag> <directory line> <file>: one file of the archive.
extract() {
	local name method csize off crc isize lh start
	read -r name method csize off crc isize <<<"$3"
	fetch "$1" "$2" "$off" $((off + 29)) "$tmp/local"
	lh="$(hex "$tmp/local")"
	[ "${lh:0:8}" = 504b0304 ] || die "$1: no local header for $name"
	start=$((off + 30 + $(le "$lh" 26 2) + $(le "$lh" 28 2)))
	if [ "$csize" = 0 ]; then
		: > "$4"
		return
	fi
	fetch "$1" "$2" "$start" $((start + csize - 1)) "$tmp/data"
	inflate "$1" "$name" "$method" "$crc" "$isize" "$tmp/data" > "$4"
}

# The text of the first element of that name without attributes, so the
# untranslated <name> and not one of its <name lang="...">.
element() {
	sed -n "s:.*<$1>\([^<]*\)</$1>.*:\1:p" "$2" | sed -n "s/&lt;/</g; s/&gt;/>/g; s/&quot;/\"/g; s/&apos;/'/g; s/&amp;/\&/g; p; q"
}

# restrictable <info.xml>: false when the <types> of the app hold one of
# PROTECTED_APP_TYPES, so the server cannot restrict it to groups, else true.
restrictable() {
	awk -v p="$PROTECTED_APP_TYPES" '
		BEGIN { n = split(p, a, " "); for (i = 1; i <= n; i++) t[a[i]] = 1 }
		{ s = s " " $0 }
		END {
			# A comment may name a type without declaring it.
			while ((i = index(s, "<!--")) > 0 && (j = index(substr(s, i + 4), "-->")) > 0) {
				s = substr(s, 1, i - 1) substr(s, i + j + 6)
			}
			r = "true"
			if (match(s, /<types>.*<\/types>/)) {
				s = substr(s, RSTART + 7, RLENGTH - 15)
				while (match(s, /<[a-z_]+/)) {
					if (substr(s, RSTART + 1, RLENGTH - 1) in t) r = "false"
					s = substr(s, RSTART + RLENGTH)
				}
			}
			print r
		}' "$1"
}

# git ls-remote, repeated up to RETRIES times as every curl request: a single
# connection that times out must not end a run of several hundred requests.
remote() {
	local i
	for ((i = 0; i <= RETRIES; i++)); do
		"$GIT" ls-remote "$@" && return
	done
	return 1
}

# == Archive ==
# previous <url> [<etag>]: the entry of that archive in the previous file, with
# that ETag if one is given, while each of its apps has enabled and restrictable.
previous() {
	"$JQ" -e -c --arg u "$1" --arg e "${2:-}" \
		'.releases[]? | select(.archive == $u and ($e == "" or .etag == $e) and all(.apps[]; has("enabled") and has("restrictable")))' <<<"$prev"
}

# Whether an archive is there; its headers stay in $tmp/head for archive.
available() { curl -fsSIL --retry "$RETRIES" --max-time 60 -o "$tmp/head" "$1" 2>/dev/null; }

# heads <url>: ETag, Last-Modified and size of the archive available just
# looked up, into etag, modified and size.
heads() {
	etag="$(header etag "$tmp/head")"
	modified="$(header last-modified "$tmp/head")"
	size="$(header content-length "$tmp/head")"
	[ -n "$etag" ] || die "$1: no ETag"
	[[ "$size" =~ ^[0-9]+$ ]] || die "$1: no size"
}

# central <url>: the central directory of the archive heads just read into
# $tmp/cd, its offset into cdoff.
central() {
	local first t eocd entries cdsize
	# The end record is 22 bytes and a comment of at most 65535; its
	# signature is the last one in the tail.
	first=$((size > 65557 ? size - 65557 : 0))
	fetch "$1" "$etag" "$first" $((size - 1)) "$tmp/tail"
	t="$(hex "$tmp/tail")"
	case "$t" in *504b0506*) ;; *) die "$1: no end of central directory" ;; esac
	eocd="${t%504b0506*}"
	(( ${#eocd} % 2 == 0 )) || die "$1: misaligned end of central directory"
	eocd=$((${#eocd} / 2))
	entries="$(le "$t" $((eocd + 10)) 2)"
	cdsize="$(le "$t" $((eocd + 12)) 4)"
	cdoff="$(le "$t" $((eocd + 16)) 4)"
	[ "$entries" != 65535 ] && [ "$cdoff" != 4294967295 ] || die "$1: a zip64 archive"
	fetch "$1" "$etag" "$cdoff" $((cdoff + cdsize - 1)) "$tmp/cd"
}

# archive <url> <ref>: the release entry of the archive available just looked
# up, from the previous file while its ETag is unchanged and each of its apps
# has enabled and restrictable. Each archive read counts in reads.
archive() {
	local url="$1" ref="$2" etag modified size cdoff server major id line version name repo path aref probe code enabled restricts
	heads "$url"
	if previous "$url" "$etag" > "$tmp/entry"; then
		cat "$tmp/entry"
		return 0
	fi

	reads=$((reads + 1))
	central "$url"
	directory "$tmp/cd" > "$tmp/dir"

	line="$(awk -v n="$ARCHIVE_ROOT/version.php" '$1 == n' "$tmp/dir")"
	[ -n "$line" ] || die "$url: no version.php"
	extract "$url" "$etag" "$line" "$tmp/version.php"
	server="$(sed -n "s/^\$OC_VersionString = '\(.*\)';.*/\1/p" "$tmp/version.php")"
	major="${server%%.*}"
	[[ "$major" =~ ^[0-9]+$ ]] || die "$url: no server version in version.php"
	line="$(awk -v n="$ARCHIVE_ROOT/core/shipped.json" '$1 == n' "$tmp/dir")"
	[ -n "$line" ] || die "$url: no core/shipped.json"
	extract "$url" "$etag" "$line" "$tmp/shipped.json"

	: > "$tmp/apps"
	for id in $("$JQ" -r '.shippedApps[]' "$tmp/shipped.json"); do
		line="$(awk -v n="$ARCHIVE_ROOT/apps/$id/appinfo/info.xml" '$1 == n' "$tmp/dir")"
		[ -n "$line" ] || continue
		extract "$url" "$etag" "$line" "$tmp/info.xml"
		version="$(element version "$tmp/info.xml")"
		name="$(element name "$tmp/info.xml")"
		restricts="$(restrictable "$tmp/info.xml")"
		enabled="$("$JQ" -r --arg id "$id" 'if (.alwaysEnabled | type) != "array" or (.defaultEnabled | type) != "array" then ""
			elif any(.alwaysEnabled[]; . == $id) then "always" elif any(.defaultEnabled[]; . == $id) then "default"
			else "optional" end' "$tmp/shipped.json")"
		probe="$GITHUB_RAW_URL/$SERVER_REPO/$ref/apps/$id/appinfo/info.xml"
		code="$(curl -sSI --retry "$RETRIES" --max-time 60 -o /dev/null -w '%{http_code}' "$probe")" || die "$probe: no answer"
		case "$code" in
		200)
			repo="$SERVER_REPO" path="apps/$id" aref="$ref"
			;;
		404)
			repo="$SERVER_APPS_OWNER/$id" path=""
			# A lookup that fails would drop the app from a release whose
			# archive later runs take over unread, so only a repository that
			# is absent or private may leave it out.
			if [ "$ref" = master ]; then
				aref="$(remote --symref "$GITHUB_URL/$repo" HEAD 2>/dev/null \
					| awk '$1 == "ref:" && $3 == "HEAD" { sub(/^refs\/heads\//, "", $2); print $2 }')" || aref="-"
			else
				aref="$(remote --tags --refs "$GITHUB_URL/$repo" "refs/tags/$ref" 2>/dev/null \
					| awk '{ sub(/^refs\/tags\//, "", $2); print $2 }')" || aref="-"
			fi
			if [ "$aref" = - ]; then
				code="$(curl -sS --retry "$RETRIES" --max-time 60 -o /dev/null -w '%{http_code}' "$GITHUB_URL/$repo")" \
					|| die "$GITHUB_URL/$repo: no answer"
				[ "$code" = 404 ] || die "$repo: git ls-remote failed (HTTP $code)"
				continue
			fi
			# Only an app whose source is public gets a line.
			[ -n "$aref" ] || continue
			;;
		*) die "$probe: HTTP $code" ;;
		esac
		"$JQ" -n -c --arg id "$id" --arg name "$name" --arg version "$version" \
			--arg repo "$repo" --arg path "$path" --arg ref "$aref" --arg enabled "$enabled" --argjson restrictable "$restricts" \
			'{id: $id, name: (if $name == "" then $id else $name end), version: $version, repo: $repo, path: $path, ref: $ref,
			  enabled: (if $enabled == "" then null else $enabled end), restrictable: $restrictable}' >> "$tmp/apps"
	done

	"$JQ" -n -c --argjson major "$major" --arg version "$server" --arg ref "$ref" \
		--arg archive "$url" --arg etag "$etag" \
		--arg published "$([ -z "$modified" ] || date -u -d "$modified" +%Y-%m-%dT%H:%M:%SZ)" \
		--slurpfile apps "$tmp/apps" \
		'{major: $major, version: $version, ref: $ref, archive: $archive, etag: $etag,
		  published: (if $published == "" then null else $published end), apps: $apps}'
}

# == Extraction ==
# unpack <url> <id> <dir>: apps/<id>/ of the archive into <dir>/<id>/. The files
# of an app lie one after the other in the archive, so one range from its first
# local header to the entry after its last one carries all of them, and each is
# cut out of that locally; were they scattered, the range would only be longer.
unpack() {
	local url="$1" id="$2" dest="$3" etag modified size cdoff first end method csize off crc isize hname s i name rel lh start n=0
	heads "$url"
	central "$url"
	directory "$tmp/cd" "$id" "$tmp/next" > "$tmp/dir"
	[ -s "$tmp/dir" ] || die "$url: no $ARCHIVE_ROOT/apps/$id/"
	first="$(awk 'NR == 1 || $3 < m { m = $3 } END { printf "%.0f", m }' "$tmp/dir")"
	end="$(cat "$tmp/next")"
	fetch "$url" "$etag" "$first" $((${end:-$cdoff} - 1)) "$tmp/span"
	while read -r method csize off crc isize hname; do
		s=""
		for ((i = 0; i < ${#hname}; i += 2)); do s+="\\x${hname:i:2}"; done
		printf -v name '%b' "$s"
		name="${name#"$ARCHIVE_ROOT/apps/"}"
		case "/${name%/}/" in */../*|*/./*|*//*) die "$url: unsafe path $name" ;; esac
		if [[ "$name" == */ ]]; then
			mkdir -p "$dest/$name"
			continue
		fi
		mkdir -p "$dest/${name%/*}"
		rel=$((off - first))
		dd if="$tmp/span" of="$tmp/local" iflag=skip_bytes,count_bytes skip="$rel" count=30 status=none
		lh="$(hex "$tmp/local")"
		[ "${lh:0:8}" = 504b0304 ] || die "$url: no local header for $name"
		start=$((rel + 30 + $(le "$lh" 26 2) + $(le "$lh" 28 2)))
		if [ "$csize" = 0 ]; then
			: > "$dest/$name"
		else
			dd if="$tmp/span" of="$tmp/data" bs=1M iflag=skip_bytes,count_bytes skip="$start" count="$csize" status=none
			inflate "$url" "$name" "$method" "$crc" "$isize" "$tmp/data" > "$dest/$name"
		fi
		n=$((n + 1))
	done < "$tmp/dir"
	echo "$n files of $ARCHIVE_ROOT/apps/$id/ unpacked to $dest/$id" >&2
}

if [ -n "$x_server" ]; then
	[[ "$x_id" =~ ^[A-Za-z0-9_-]+$ ]] || die "not an app id: $x_id"
	if [ "$x_server" = master ]; then
		url="$SERVER_MASTER_ARCHIVE"
	else
		[[ "$x_server" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "not a server release: $x_server"
		url="$SERVER_RELEASES_URL/nextcloud-$x_server.zip"
	fi
	available "$url" || die "no archive at $url"
	mkdir -p "$x_dir"
	unpack "$url" "$x_id" "$x_dir"
	echo "$url"
	exit 0
fi

# == Releases ==
schedule="$(curl -fsS --retry "$RETRIES" --max-time 60 "$SERVER_SCHEDULE_URL")" || die "no maintenance schedule at $SERVER_SCHEDULE_URL"
majors="$(sed -n '/^## Currently supported versions/,/^## /s/^| \*\*\([0-9]*\)\*\*.*/\1/p' <<<"$schedule")"
[ -n "$majors" ] || die "no supported major in $SERVER_SCHEDULE_URL"
eol="$(sed -n '/^## EOL Versions/,/^## /s/^| \*\*\([0-9]*\)\*\*.*/\1/p' <<<"$schedule" | sort -n | tail -n 1)"
[ -n "$eol" ] || die "no end-of-life major in $SERVER_SCHEDULE_URL"
majors="$majors $eol"
tags="$(remote --tags --refs "$GITHUB_URL/$SERVER_REPO" 'v*' \
	| sed -n 's:.*refs/tags/v\([0-9]*\.[0-9]*\.[0-9]*\)$:\1:p' | sort -V)"
[ -n "$tags" ] || die "no release tags in $GITHUB_URL/$SERVER_REPO"

# release <version> [<max>]: the entry of that server release, taken over from
# the previous file or read from its archive, read only while fewer than <max>
# archives are read when <max> is given. kept is 1 when the entry is there.
release() {
	local url="$SERVER_RELEASES_URL/nextcloud-$1.zip"
	kept=1
	previous "$url" >> "$tmp/releases" && return
	if [ -n "${2:-}" ] && [ "$reads" -ge "$2" ]; then
		kept=0 left=$((left + 1))
		return
	fi
	if ! available "$url"; then
		# A tag can come before its archive.
		warn "no archive at $url"
		kept=0
		return
	fi
	archive "$url" "v$1" >> "$tmp/releases"
}

reads=0 left=0
: > "$tmp/releases"
: > "$tmp/older"
for major in $majors; do
	mapfile -t versions < <(awk -F. -v m="$major" '$1 == m' <<<"$tags" | sort -rV)
	if [ "${#versions[@]}" = 0 ]; then
		warn "no release of the major $major"
		continue
	fi
	for ((i = 0; i < ${#versions[@]}; i++)); do
		release "${versions[i]}"
		[ "$kept" = 0 ] || break
	done
	((i + 1 >= ${#versions[@]})) || printf '%s\n' "${versions[@]:i+1}" >> "$tmp/older"
done
if available "$SERVER_MASTER_ARCHIVE"; then
	archive "$SERVER_MASTER_ARCHIVE" master >> "$tmp/releases"
else
	warn "no archive at $SERVER_MASTER_ARCHIVE"
fi
while read -r version; do
	release "$version" "$SHIPPED_MAX_READS"
done < <(sort -rV "$tmp/older")
# Every entry of the previous file not read again stays, master without an
# archive and the releases of a major that has left the schedule among them.
"$JQ" -c '.releases[]?' <<<"$prev" >> "$tmp/releases"

# == Initial lists ==
initial="$("$JQ" -c '.initial // {}' <<<"$prev")"
while read -r major; do
	"$JQ" -e --arg m "$major" 'has($m)' <<<"$initial" >/dev/null && continue
	url="$GITHUB_RAW_URL/$SERVER_REPO/v$major.0.0/core/shipped.json"
	code="$(curl -sS --retry "$RETRIES" --max-time 60 -o "$tmp/initial" -w '%{http_code}' "$url")" || die "$url: no answer"
	case "$code" in
		200) list="$("$JQ" -c '.shippedApps' "$tmp/initial")" ;;
		404) list='[]' ;;
		*) die "$url: HTTP $code" ;;
	esac
	initial="$("$JQ" -c --arg m "$major" --argjson l "$list" '.[$m] = $l' <<<"$initial")"
done < <(sed -n 's/^\([0-9]*\)\.0\.0$/\1/p' <<<"$tags")

# unique_by keeps the first entry of each archive, so one read in this run wins
# over its previous one.
"$JQ" -n --argjson initial "$initial" --argjson majors "$("$JQ" -s -c . <<<"$majors")" --slurpfile releases "$tmp/releases" '
	def rank: if .ref == "master" then [] else .ref | ltrimstr("v") | split(".") | map(-tonumber) end;
	($releases | unique_by(.archive)) as $all
	| [$all[] | select(.ref != "master" and (.major as $m | any($majors[]; . == $m)))]
	| [group_by(.major)[] | min_by(rank) | .archive] as $newest
	| [$all[] | .latest = (.ref == "master" or (.archive as $a | any($newest[]; . == $a)))]
	| sort_by(-.major, .ref != "master", rank) as $r
	| [$r[] | select(.latest)] as $l
	| {releases: $r,
	   since: ([($initial | to_entries[] | (.key | tonumber) as $m | .value[] | {id: ., m: $m}),
	            ($r[] | .major as $m | .apps[] | {id, m: $m})]
	           | group_by(.id) | map({key: .[0].id, value: (map(.m) | min)})
	           | map(select(.key as $id | any($l[].apps[]; .id == $id))) | from_entries),
	   initial: $initial}' > "$SHIPPED_FILE.new"
mv "$SHIPPED_FILE.new" "$SHIPPED_FILE"
echo "shipped apps written to $SHIPPED_FILE ($("$JQ" -r '"\(.releases | length) releases, \(.since | length) apps"' "$SHIPPED_FILE"), $reads archives read, $left left to the next run)"
