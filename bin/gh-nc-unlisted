#!/usr/bin/env -S LC_CTYPE=C.UTF-8 LC_MESSAGES=C bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz <raphael.gradenwitz@googlemail.com>
# SPDX-License-Identifier: MIT
#
# gh-nc-unlisted - list the Nextcloud apps that are neither in the App Store
# catalogue nor shipped by the server. It lists every repository of every owner
# the catalogue and shipped.json name on GitHub or on a Forgejo or Gitea host,
# reads the tree of each one that is no fork, no mirror, not archived and not
# empty, and keeps every tracked appinfo/info.xml that declares a <nextcloud>
# dependency. The result replaces its previous copy, from which a repository not
# pushed since is taken over instead of being read again.

# == Config ==
# Optional site config shared with gh-stats and gh-release-sampler. If
# /etc/gh-stats/gh-stats.env exists it is sourced here, so its assignments feed
# the ${VAR:-default} reads below. Precedence is built-in default <
# gh-stats.env < environment. Point GH_STATS_ENV at another path to use a
# different file.
GH_STATS_ENV="${GH_STATS_ENV:-/etc/gh-stats/gh-stats.env}"
# shellcheck disable=SC1090 # the site config is a run-time path
if [ -r "$GH_STATS_ENV" ]; then
	_env_snapshot="$(export -p)"
	set -a; . "$GH_STATS_ENV"; set +a
	eval "$_env_snapshot"
	unset _env_snapshot
fi

STATE_DIR="${GH_STATS_DIR:-/var/lib/gh-stats}"
UNLISTED_FILE="${UNLISTED_FILE:-${STATE_DIR}/unlisted.json}"
APPSTORE_CACHE="${APPSTORE_CACHE:-${STATE_DIR}/apps.json}"
APPSTORE_APPAPI_CACHE="${APPSTORE_APPAPI_CACHE:-$(dirname "$APPSTORE_CACHE")/appapi_apps.json}"
SHIPPED_CACHE="${SHIPPED_CACHE:-$(dirname "$APPSTORE_CACHE")/shipped.json}"

# More owners or repositories to scan, and owners, repositories or app ids to
# leave out, separated by spaces or line breaks.
UNLISTED_INCLUDE="${UNLISTED_INCLUDE:-}"
UNLISTED_EXCLUDE="${UNLISTED_EXCLUDE:-}"
# How many repositories a run reads before it leaves the rest to the next run;
# one takes about two seconds. The most recently pushed are read first.
UNLISTED_MAX_READS="${UNLISTED_MAX_READS:-3000}"
# How many owners are listed and repositories read at once.
UNLISTED_JOBS="${UNLISTED_JOBS:-8}"
# Of the releases of a repository with an app, how many are looked at for a
# tarball.
UNLISTED_RELEASES="${UNLISTED_RELEASES:-10}"
# Of the tags of a repository with an app, how many are kept, the newest first.
UNLISTED_TAGS="${UNLISTED_TAGS:-20}"
# How often a request that times out or fails transiently is repeated.
RETRIES=3

JQ="${JQ_BIN:-jq}"
GIT="${GIT_BIN:-git}"
GH="${GH_BIN:-gh}"

set -euo pipefail
# A repository that does not exist or is private must fail, not ask for a login.
export GIT_TERMINAL_PROMPT=0

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARNING: $*" >&2; }

usage() {
	cat <<'EOF'
Usage: gh-nc-unlisted [-f <file>]

Writes the Nextcloud apps that are neither in the App Store catalogue nor
shipped by the server to <file>, as JSON:

  {
    "scanned": "2026-10-27T00:20:00Z",
    "apps": [{"id": "files_gcs", "name": "...", "version": "...",
              "nextcloud": {"min": "30", "max": "32"},
              "host": "github.com", "repo": "nextcloud/files_gcs", "path": "",
              "tag": "v1.0.0", "tags": ["v1.0.0", "v0.9.1"], "tarball": true,
              "pushed": "2026-05-04T10:12:00Z"}, ...],
    "repos": {"nextcloud/files_gcs": {"host": "github.com",
              "repo": "nextcloud/files_gcs", "created": "...", "pushed": "...",
              "apps": [{"path": "", "id": "files_gcs", ...}],
              "tag": "v1.0.0", "tags": ["v1.0.0", "v0.9.1"], "tarball": true}, ...}
  }

The owners are every owner the catalogue (apps.json and appapi_apps.json)
names on GitHub, through the download URL of a release, the website or the
issue tracker of an app, every owner of a repository in shipped.json, every
owner it names on another host that answers the Forgejo and Gitea API, and
those UNLISTED_INCLUDE names. Every repository of these owners that is no
fork, no mirror, not archived and not empty is read, as is every repository
UNLISTED_INCLUDE names, whatever it is; those UNLISTED_EXCLUDE names are left
out. Of each, the tree of the default branch is fetched without its blobs and
every tracked appinfo/info.xml, at the root or below it, that declares a
<nextcloud> dependency makes an app. Of a repository with an app, the newest
tag, the newest UNLISTED_TAGS tags, newest first, and whether one of its newest
UNLISTED_RELEASES releases carries a .tar.gz or .tgz asset are kept as well.
The tags are ordered by their name without a leading v, as sort -V orders it,
with an -alpha, -beta or -rc version before its release.

repos holds every repository read, with or without an app, under
[<host>/]<owner>/<repo> in lower case. One whose pushed time is unchanged is
taken over from the previous <file> unread, unless it has an app and its entry
no tags. A run reads at most
UNLISTED_MAX_READS repositories, the most recently pushed first, and leaves the
rest to the next run. The repositories of an owner whose listing fails are
taken over, those of an owner that no longer exists are dropped.

apps holds the apps of repos whose id is neither one of the catalogue nor one
of shipped.json, nor named by UNLISTED_EXCLUDE; of several repositories with
the same id the one created first counts. The time is UTC throughout.

UNLISTED_INCLUDE and UNLISTED_EXCLUDE take owners and repositories as owner,
owner/repo, host/owner or host/owner/repo, separated by spaces or line breaks;
a first part with a dot is a host, without one the host is github.com.
UNLISTED_EXCLUDE also takes app ids, as id:<app-id>.

Options:
  -f, --file <file>  the file to read and replace (default: $GH_STATS_DIR/unlisted.json)
  -h, --help         this text

Environment (or /etc/gh-stats/gh-stats.env):
  UNLISTED_FILE          as -f
  GH_STATS_DIR           state directory (default: /var/lib/gh-stats)
  APPSTORE_CACHE         the App Store catalogue apps.json
                         (default: $GH_STATS_DIR/apps.json)
  APPSTORE_APPAPI_CACHE  the AppAPI catalogue appapi_apps.json
                         (default: next to APPSTORE_CACHE)
  SHIPPED_CACHE          shipped.json of gh-nc-shipped, optional
                         (default: next to APPSTORE_CACHE)
  UNLISTED_INCLUDE       owners and repositories to scan as well
  UNLISTED_EXCLUDE       owners, repositories and app ids to leave out
  UNLISTED_MAX_READS     the repositories a run reads (default: 3000)
  UNLISTED_JOBS          the listings and reads that run at once (default: 8)
  UNLISTED_RELEASES      the releases looked at for a tarball (default: 10)
  UNLISTED_TAGS          the tags kept of a repository with an app (default: 20)
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		-f|--file) [ $# -ge 2 ] || die "$1 needs a file"; UNLISTED_FILE="$2"; shift ;;
		*) echo "unknown argument: $1" >&2; exit 1 ;;
	esac
	shift
done

[[ "$UNLISTED_MAX_READS" =~ ^[0-9]+$ ]] || die "UNLISTED_MAX_READS is $UNLISTED_MAX_READS, it takes a number"
[[ "$UNLISTED_JOBS" =~ ^[1-9][0-9]*$ ]] || die "UNLISTED_JOBS is $UNLISTED_JOBS, it takes a number above 0"
[[ "$UNLISTED_RELEASES" =~ ^[1-9][0-9]*$ ]] || die "UNLISTED_RELEASES is $UNLISTED_RELEASES, it takes a number above 0"
[[ "$UNLISTED_TAGS" =~ ^[1-9][0-9]*$ ]] || die "UNLISTED_TAGS is $UNLISTED_TAGS, it takes a number above 0"
[ -r "$APPSTORE_CACHE" ] || die "no catalogue at $APPSTORE_CACHE"
[ -r "$APPSTORE_APPAPI_CACHE" ] || die "no AppAPI catalogue at $APPSTORE_APPAPI_CACHE"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/list" "$tmp/read" "$tmp/clone"

prev="$tmp/prev.json"
shipped="$tmp/shipped.json"
echo '{}' > "$prev"
echo '{}' > "$shipped"
[ ! -r "$UNLISTED_FILE" ] || cp "$UNLISTED_FILE" "$prev"
[ ! -r "$SHIPPED_CACHE" ] || cp "$SHIPPED_CACHE" "$shipped"

# == Settings ==
# spec: one entry of UNLISTED_INCLUDE or UNLISTED_EXCLUDE as {host, owner, repo}
# or {id}, keyed as the repositories are, or null when it has another form.
SPEC_JQ='
	def spec:
		if startswith("id:") then (.[3:] | if test("^[A-Za-z0-9_-]+$") then {id: .} else null end)
		else split("/") as $p
			| (if $p[0] | test("\\.") then {host: ($p[0] | ascii_downcase), r: $p[1:]} else {host: "github.com", r: $p} end)
			| if (.r | length) < 1 or (.r | length) > 2 or any(.r[]; test("^[A-Za-z0-9_.-]+$") | not) then null
			  else {host, owner: .r[0], repo: .r[1]}
			     | .key = ((if .host == "github.com" then "" else .host + "/" end) + .owner + (if .repo then "/" + .repo else "" end) | ascii_downcase)
			  end
		end;
	[$v | splits("\\s+") | select(. != "") | {entry: ., spec: spec}]'
for var in UNLISTED_INCLUDE UNLISTED_EXCLUDE; do
	"$JQ" -n -c --arg v "${!var}" "$SPEC_JQ" > "$tmp/$var"
	bad="$("$JQ" -r '[.[] | select(.spec == null) | .entry] | join(" ")' "$tmp/$var")"
	[ -z "$bad" ] || die "$var holds $bad, it takes owner, owner/repo, host/owner or host/owner/repo"
done
"$JQ" -e 'all(.[]; .spec.id == null)' "$tmp/UNLISTED_INCLUDE" >/dev/null || die "UNLISTED_INCLUDE takes no app id"
excluded="$("$JQ" -c '[.[].spec.key | strings]' "$tmp/UNLISTED_EXCLUDE")"
excluded_ids="$("$JQ" -c '[.[].spec.id | strings | ascii_downcase]' "$tmp/UNLISTED_EXCLUDE")"

# == Owners ==
# "<host> <owner>" for every owner the catalogue and shipped.json name, and the
# owners of UNLISTED_INCLUDE. A raw file on GitHub names its owner as well.
{
	"$JQ" -r -s '
		[.[][] | (.website, .issueTracker, .releases[]?.download) | strings
		 | capture("^https?://(www\\.)?(?<host>[^/:?#]+)/(?<owner>[^/?#]+)") | .host |= ascii_downcase
		 | if .host == "raw.githubusercontent.com" then .host = "github.com" else . end
		 | select(.host != "github.com" or (.owner | IN("orgs", "apps", "sponsors", "features", "marketplace", "settings", "login") | not))
		 | "\(.host) \(.owner)"] | .[]' "$APPSTORE_CACHE" "$APPSTORE_APPAPI_CACHE"
	"$JQ" -r '.releases[]?.apps[]?.repo | "github.com " + split("/")[0]' "$shipped"
	"$JQ" -r '.[].spec | select(.repo == null) | "\(.host) \(.owner)"' "$tmp/UNLISTED_INCLUDE"
} | awk '{ k = tolower($0) } !(k in seen) { seen[k]; print }' > "$tmp/owners.all"

# A host besides GitHub counts only while its /api/v1/version answers as
# Forgejo and Gitea do.
: > "$tmp/hosts"
while read -r host; do
	if curl -fsS --retry "$RETRIES" --max-time 20 "https://$host/api/v1/version" 2>/dev/null \
		| "$JQ" -e '.version | strings' >/dev/null 2>&1; then
		printf '%s\n' "$host" >> "$tmp/hosts"
	fi
done < <(awk '$1 != "github.com" { print $1 }' "$tmp/owners.all" | sort -u)
awk -v ex="$("$JQ" -r 'join(" ")' <<<"$excluded")" '
	FILENAME == ARGV[1] { forge[$1]; next }
	BEGIN { n = split(ex, e, " "); for (i = 1; i <= n; i++) x[e[i]] }
	{ k = tolower(($1 == "github.com" ? "" : $1 "/") $2) }
	($1 == "github.com" || $1 in forge) && !(k in x)' "$tmp/hosts" "$tmp/owners.all" > "$tmp/owners"

# == Listing and reading ==
# The time of a forge as UTC, which the GitHub API already gives.
# shellcheck disable=SC2089 # a jq definition, never split as words
UTC_JQ='
	def utc: if . == null or test("Z$") then sub("\\.[0-9]+Z$"; "Z")
		else capture("^(?<t>.{19})(\\.[0-9]+)?(?<s>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2})$")
		     | (.t + "Z" | fromdate) - (if .s == "+" then 1 else -1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60)
		     | todate end;'

# list <n> <host> <owner>: every repository of the owner into list/<n>.json as
# {key, host, repo, fork, mirror, archived, empty, private, created, pushed},
# or an empty list/<n>.gone when the owner does not exist; nothing when the
# listing failed.
list() {
	local n="$1" host="$2" owner="$3" out="$tmp/list/$1" page code i
	if [ "$host" = github.com ]; then
		for ((i = 0; i <= RETRIES; i++)); do
			if "$GH" repo list "$owner" --limit 100000 --json nameWithOwner,isFork,isMirror,isArchived,isEmpty,isPrivate,createdAt,pushedAt \
				> "$out.raw" 2> "$out.err"; then
				"$JQ" -c --arg host "$host" "map({key: (.nameWithOwner | ascii_downcase), host: \$host, repo: .nameWithOwner,
					fork: .isFork, mirror: .isMirror, archived: .isArchived, empty: .isEmpty, private: .isPrivate, created: .createdAt, pushed: .pushedAt})" \
					"$out.raw" > "$out.json"
				return 0
			fi
			if grep -q 'not recognized as either a GitHub user or an organization' "$out.err"; then
				: > "$out.gone"
				return 0
			fi
		done
		warn "$host/$owner: $(tail -n 1 "$out.err")"
		return 0
	fi
	: > "$out.raw"
	for ((page = 1; ; page++)); do
		code="$(curl -sS --retry "$RETRIES" --max-time 60 -o "$out.page" -w '%{http_code}' \
			"https://$host/api/v1/users/$owner/repos?limit=50&page=$page")" || code=000
		case "$code" in
			200) ;;
			404) : > "$out.gone"; return 0 ;;
			*) warn "$host/$owner: HTTP $code"; return 0 ;;
		esac
		cat "$out.page" >> "$out.raw"
		[ "$("$JQ" length "$out.page")" -ge 50 ] || break
	done
	"$JQ" -s -c --arg host "$host" "$UTC_JQ"' add // []
		| map({key: ($host + "/" + .full_name | ascii_downcase), host: $host, repo: .full_name,
		       fork, mirror, archived, empty, private, created: (.created_at | utc), pushed: (.updated_at | utc)})' \
		"$out.raw" > "$out.json"
}

# element <name> <file>: the text of the first element of that name without
# attributes, so the untranslated <name> and not one of its <name lang="...">.
element() {
	sed -n "s:.*<$1>\([^<]*\)</$1>.*:\1:p" "$2" | sed -n "s/&lt;/</g; s/&gt;/>/g; s/&quot;/\"/g; s/&apos;/'/g; s/&amp;/\&/g; p; q"
}

# read_repo <n> <key> <host> <owner/repo>: the apps of the repository into
# read/<n>.json as {key, apps, tag, tags, tarball}; nothing when it could not be
# read.
read_repo() {
	local n="$1" key="$2" host="$3" slug="$4" dir="$tmp/clone/$1" f path nc tags tarball i
	local url="https://$host/$slug.git"
	for ((i = 0; i <= RETRIES; i++)); do
		rm -rf "$dir"
		"$GIT" clone -q --depth 1 --filter=blob:none --no-checkout "$url" "$dir" 2> "$dir.err" && break
	done
	if [ "$i" -gt "$RETRIES" ]; then
		warn "$url: $(tail -n 1 "$dir.err")"
		rm -rf "$dir" "$dir.err"
		return 0
	fi
	: > "$dir.apps"
	while IFS= read -r -d '' f; do
		"$GIT" -C "$dir" cat-file -p "HEAD:$f" > "$dir.xml" 2>/dev/null || continue
		grep -q '<nextcloud[[:space:]/>]' "$dir.xml" || continue
		path="${f%appinfo/info.xml}"
		path="${path%/}"
		nc="$(tr '\r\n\t' '   ' < "$dir.xml" | sed -n 's:.*<nextcloud\([[:space:]][^>]*\)\{0,1\}/\{0,1\}>.*:\1:p')"
		"$JQ" -n -c --arg path "$path" --arg id "$(element id "$dir.xml")" --arg name "$(element name "$dir.xml")" \
			--arg version "$(element version "$dir.xml")" \
			--arg min "$(sed -n 's/.*min-version="\([^"]*\)".*/\1/p' <<<"$nc")" \
			--arg max "$(sed -n 's/.*max-version="\([^"]*\)".*/\1/p' <<<"$nc")" \
			'{path: $path, id: $id, name: $name, version: $version, nextcloud: {min: $min, max: $max}}
			 | select(.id != "")' >> "$dir.apps"
	done < <("$GIT" -C "$dir" ls-tree -r -z --name-only HEAD | grep -z -E '(^|/)appinfo/info\.xml$' || true)
	rm -rf "$dir"
	tags="" tarball=false
	if [ -s "$dir.apps" ]; then
		# awk instead of head reads to the end, so sort never meets a closed pipe.
		tags="$("$GIT" ls-remote --tags --refs "$url" 2>/dev/null \
			| awk '{ t = $2; sub(/^refs\/tags\//, "", t); k = t; sub(/^[vV]/, "", k); gsub(/-(alpha|beta|rc)/, "~&", k); print k "\t" t }' \
			| sort -V -r -k1,1 | awk -F '\t' -v n="$UNLISTED_TAGS" 'NR <= n { print $2 }')" || tags=""
		if [ "$host" = github.com ]; then
			"$GH" api "repos/$slug/releases?per_page=$UNLISTED_RELEASES" --jq '.[].assets[].name' > "$dir.rel" 2>/dev/null || :
		else
			curl -fsS --retry "$RETRIES" --max-time 60 "https://$host/api/v1/repos/$slug/releases?limit=$UNLISTED_RELEASES" 2>/dev/null \
				| "$JQ" -r '.[].assets[].name' > "$dir.rel" 2>/dev/null || :
		fi
		! grep -q -E '\.(tar\.gz|tgz)$' "$dir.rel" || tarball=true
	fi
	"$JQ" -n -c --arg key "$key" --slurpfile apps "$dir.apps" --arg tags "$tags" --argjson tarball "$tarball" \
		'($tags | split("\n") | map(select(. != ""))) as $t
		 | {key: $key, apps: $apps, tag: $t[0], tags: $t, tarball: $tarball}' > "$tmp/read/$n.json"
	rm -f "$dir.err" "$dir.apps" "$dir.xml" "$dir.rel"
}

# shellcheck disable=SC2090 # UTC_JQ is a jq definition, never split as words
export tmp JQ GIT GH RETRIES UNLISTED_RELEASES UNLISTED_TAGS UTC_JQ
export -f warn list element read_repo

awk '{ printf "%d\0%s\0%s\0", NR, $1, $2 }' "$tmp/owners" \
	| xargs -0 -r -n 3 -P "$UNLISTED_JOBS" bash -c 'list "$@"' _
# The included repositories, each listed on its own.
"$JQ" -r '.[].spec | select(.repo) | "\(.host) \(.owner)/\(.repo)"' "$tmp/UNLISTED_INCLUDE" > "$tmp/included"
included_n=0
while read -r host slug; do
	n="i$((++included_n))"
	if [ "$host" = github.com ]; then
		"$GH" repo view "$slug" --json nameWithOwner,isFork,isMirror,isArchived,isEmpty,isPrivate,createdAt,pushedAt 2>/dev/null \
			| "$JQ" -c --arg host "$host" '[{key: (.nameWithOwner | ascii_downcase), host: $host, repo: .nameWithOwner,
				fork: .isFork, mirror: .isMirror, archived: .isArchived, empty: .isEmpty, private: .isPrivate, created: .createdAt, pushed: .pushedAt}]' \
			> "$tmp/list/$n.json" || { warn "$slug: not found"; rm -f "$tmp/list/$n.json"; }
	else
		curl -fsS --retry "$RETRIES" --max-time 60 "https://$host/api/v1/repos/$slug" 2>/dev/null \
			| "$JQ" -c --arg host "$host" "$UTC_JQ"'[{key: ($host + "/" + .full_name | ascii_downcase), host: $host, repo: .full_name,
				fork, mirror, archived, empty, private, created: (.created_at | utc), pushed: (.updated_at | utc)}]' \
			> "$tmp/list/$n.json" || { warn "$host/$slug: not found"; rm -f "$tmp/list/$n.json"; }
	fi
done < "$tmp/included"

# The owners whose listing failed, as their keys, so their repositories are
# taken over.
awk '{ print NR "\t" tolower(($1 == "github.com" ? "" : $1 "/") $2) }' "$tmp/owners" \
	| while IFS=$'\t' read -r n k; do
		[ -e "$tmp/list/$n.json" ] || [ -e "$tmp/list/$n.gone" ] || printf '%s\n' "$k"
	done > "$tmp/failed"

# Every repository to consider: those of the listings that are no fork, no
# mirror, not archived, not empty and not private, every included one that is
# not empty and not private, none that UNLISTED_EXCLUDE names. Then the ones
# whose pushed time the previous file holds are taken over, unless they have
# an app and no tags, and of the rest
# the most recently pushed UNLISTED_MAX_READS are read.
find "$tmp/list" -name 'i*.json' -exec cat {} + > "$tmp/included.json"
find "$tmp/list" -name '[0-9]*.json' -exec cat {} + > "$tmp/listed.json"
"$JQ" -n -c --argjson excluded "$excluded" --slurpfile included "$tmp/included.json" --slurpfile listed "$tmp/listed.json" '
	([$listed[][] | select((.fork or .mirror or .archived or .empty or .private) | not)]
	 + [$included[][] | select((.empty or .private) | not)])
	| map(select(.key as $k | any($excluded[]; . as $x | $k == $x or ($k | startswith($x + "/"))) | not))
	| unique_by(.key) | .[]' > "$tmp/repos"
"$JQ" -r --slurpfile prev "$prev" '
	$prev[0].repos[.key] as $o
	| select(($o.pushed // null) != .pushed or (($o.apps // []) != [] and ($o | has("tags") | not)))
	| [.pushed, .key, .host, .repo] | @tsv' "$tmp/repos" \
	| sort -r | cut -f2- > "$tmp/stale"
head -n "$UNLISTED_MAX_READS" "$tmp/stale" | awk -F '\t' '{ printf "%d\0%s\0%s\0%s\0", NR, $1, $2, $3 }' \
	| xargs -0 -r -n 4 -P "$UNLISTED_JOBS" bash -c 'read_repo "$@"' _
find "$tmp/read" -name '*.json' -exec cat {} + > "$tmp/read.json"
reads="$(wc -l < "$tmp/read.json")"
left="$(($(wc -l < "$tmp/stale") - UNLISTED_MAX_READS))"
[ "$left" -gt 0 ] || left=0

# == Result ==
# Each repository read gets its entry, one not pushed since keeps its previous
# one, and so does every repository of an owner whose listing failed. A
# repository that was due but could not be read keeps its previous entry with
# the pushed time it had, so the next run reads it again.
"$JQ" -n --slurpfile prev "$prev" --slurpfile shipped "$shipped" --slurpfile repos "$tmp/repos" --slurpfile read "$tmp/read.json" \
	--rawfile failed "$tmp/failed" --argjson excluded "$excluded_ids" --arg scanned "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
	([inputs[] | .id] + [$shipped[0].releases[]?.apps[]?.id] | map(ascii_downcase)) as $known
	| ($prev[0].repos // {}) as $old
	| ($read | map({(.key): del(.key)}) | add // {}) as $fresh
	| ($failed | split("\n") | map(select(. != ""))) as $f
	| ([$repos[] | if $fresh[.key] then {key, value: ({host, repo, created, pushed} + $fresh[.key])}
	                else {key, value: $old[.key]} | select(.value) end]
	   + [$old | to_entries[] | select(.key as $k | any($f[]; . as $o | $k | startswith($o + "/")))]
	   | unique_by(.key) | from_entries) as $all
	| [$all[] | . as $r | .apps[] | {id, name, version, nextcloud, host: $r.host, repo: $r.repo, path,
	                                tag: $r.tag, tags: $r.tags, tarball: $r.tarball, pushed: $r.pushed, created: $r.created}
	   | select(.id | ascii_downcase | IN($known[], $excluded[]) | not)]
	| group_by(.id | ascii_downcase) | map(min_by(.created, .host, .repo, .path) | del(.created)) | sort_by(.id | ascii_downcase)
	| {scanned: $scanned, apps: ., repos: $all}' "$APPSTORE_CACHE" "$APPSTORE_APPAPI_CACHE" > "$UNLISTED_FILE.new"
mv "$UNLISTED_FILE.new" "$UNLISTED_FILE"
echo "unlisted apps written to $UNLISTED_FILE ($("$JQ" -r '"\(.apps | length) apps in \(.repos | length) repositories"' "$UNLISTED_FILE"), $(wc -l < "$tmp/owners") owners, $(wc -l < "$tmp/failed") not listed, $reads repositories read, $left left to the next run)"
