#!/usr/bin/env -S LC_CTYPE=C.UTF-8 LC_MESSAGES=C bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz <raphael.gradenwitz@googlemail.com>
# SPDX-License-Identifier: MIT
#
# gh-release-sampler - change-only time series of GitHub release asset download
# counters, across the owners/orgs/repos listed in the config. Per run it records
# every asset's cumulative download_count, but writes a new row only when a value
# changed (change-only). Release meta (published, prerelease, major) is stored
# once per release. Every run timestamp is recorded, so a missing sample means
# "unchanged", not "no run". All times are Unix epoch (UTC).
# Every request is conditional on the ETag of its last answer: GitHub answers an
# unchanged one with 304, which does not count against the rate limit. A run
# starts only when the remaining budget covers it, and the requests that fail are
# reported. A server error or a missing answer is repeated a few times first.
# Per repository it also records the current name GitHub answers under, which
# differs from the sampled one after a rename, and the last run that sampled it
# as a target.
# A repository that answers 404 in UNREACHABLE_RUNS runs in a row counts as
# unreachable until it answers again; a repository removed from the database
# keeps its row in repos as a mark, so it is never sampled again.
# A target host/owner/repo is a repository on a Forgejo or Gitea host, sampled
# the same way through its API at https://<host>/api/v1. Every table keys its
# rows by host, github.com for GitHub.

# == Config ==
# Optional site config shared with gh-stats. If /etc/gh-stats/gh-stats.env
# exists it is sourced here, so its assignments feed the ${VAR:-default} reads
# below. Precedence is built-in default < gh-stats.env < environment (a value
# set in the cron drop-in or exported for the run still wins over the file).
# Without the file, behaviour is unchanged. Point GH_STATS_ENV at another path
# to use a different file.
GH_STATS_ENV="${GH_STATS_ENV:-/etc/gh-stats/gh-stats.env}"
# shellcheck disable=SC1090 # the site config is a run-time path
if [ -r "$GH_STATS_ENV" ]; then
	_env_snapshot="$(export -p)"
	set -a; . "$GH_STATS_ENV"; set +a
	eval "$_env_snapshot"
	unset _env_snapshot
fi

CONFIG="${GH_STATS_CONFIG:-/etc/gh-stats/targets.json}"
# Optional drop-in directory. Every targets.d/*.json is merged with the main
# config (its .targets[] appended, then de-duplicated), so a generated list
# (e.g. from gh-nc-appstore-targets) can live beside the hand-curated targets.json.
TARGETS_DIR="${GH_STATS_TARGETS_DIR:-/etc/gh-stats/targets.d}"
STATE_DIR="${GH_STATS_DIR:-/var/lib/gh-stats}"
DB="${GH_STATS_DB:-${STATE_DIR}/downloads.sqlite}"
GH="${GH_BIN:-/usr/bin/gh}"
SQLITE="${SQLITE_BIN:-/usr/bin/sqlite3}"
# Pauses in seconds before each repetition of a request that got a 5xx answer
# or none. Once RETRY_GIVE_UP requests failed through all of them, the run
# repeats no further request: during an outage the pauses would otherwise
# stretch the run past its timeout.
RETRY_DELAYS="${GH_STATS_RETRY_DELAYS:-2 5 10}"
RETRY_GIVE_UP="${GH_STATS_RETRY_GIVE_UP:-5}"
# The runs in a row with a 404 after which a repository counts as unreachable.
# Until then each run lists it in its report; an unreachable one is still asked
# once per run.
UNREACHABLE_RUNS="${GH_STATS_UNREACHABLE_RUNS:-3}"

set -euo pipefail

ts="$(date -u +%s)"
mkdir -p "$STATE_DIR"

# == Schema (idempotent) ==
# A database from before the host column has its tables renamed aside here,
# created anew below and refilled with host github.com, in one transaction.
migrate=0
if [ "$("$SQLITE" "$DB" "SELECT count(*) FROM sqlite_master WHERE name = 'samples'")" = 1 ] \
	&& [ "$("$SQLITE" "$DB" "SELECT count(*) FROM pragma_table_info('samples') WHERE name = 'host'")" = 0 ]; then
	migrate=1
fi
migrate_aside=''
migrate_fill=''
if [ "$migrate" = 1 ]; then
	migrate_aside="
DROP INDEX idx_samples_last;
DROP INDEX idx_repo_stats_last;
ALTER TABLE samples RENAME TO samples_v1;
ALTER TABLE releases RENAME TO releases_v1;
ALTER TABLE repo_stats RENAME TO repo_stats_v1;
ALTER TABLE repos RENAME TO repos_v1;"
	migrate_fill="
INSERT INTO samples (ts, owner, repo, tag, asset, downloads)
SELECT ts, owner, repo, tag, asset, downloads FROM samples_v1;
INSERT INTO releases (owner, repo, tag, published, prerelease, major)
SELECT owner, repo, tag, published, prerelease, major FROM releases_v1;
INSERT INTO repo_stats (ts, owner, repo, stars, forks, watchers)
SELECT ts, owner, repo, stars, forks, watchers FROM repo_stats_v1;
INSERT INTO repos (owner, repo, name, seen)
SELECT owner, repo, name, seen FROM repos_v1;
DROP TABLE samples_v1;
DROP TABLE releases_v1;
DROP TABLE repo_stats_v1;
DROP TABLE repos_v1;"
fi
# A repos table from before the columns of unreachable and removed repositories
# gets them here; the table of a migration is created with them.
repos_add=''
if [ "$migrate" = 0 ] \
	&& [ "$("$SQLITE" "$DB" "SELECT count(*) FROM sqlite_master WHERE name = 'repos'")" = 1 ] \
	&& [ "$("$SQLITE" "$DB" "SELECT count(*) FROM pragma_table_info('repos') WHERE name = 'missing'")" = 0 ]; then
	repos_add="
ALTER TABLE repos ADD COLUMN missing INTEGER NOT NULL DEFAULT 0;
ALTER TABLE repos ADD COLUMN since INTEGER;
ALTER TABLE repos ADD COLUMN unreachable INTEGER NOT NULL DEFAULT 0;
ALTER TABLE repos ADD COLUMN removed INTEGER;"
fi
# PRAGMA journal_mode answers with the mode it set; only errors belong in the output.
"$SQLITE" -bail "$DB" >/dev/null <<SQL
PRAGMA journal_mode=WAL;
BEGIN;
$migrate_aside
CREATE TABLE IF NOT EXISTS samples (
  ts        INTEGER NOT NULL,
  host      TEXT    NOT NULL DEFAULT 'github.com',
  owner     TEXT    NOT NULL,
  repo      TEXT    NOT NULL,
  tag       TEXT    NOT NULL,
  asset     TEXT    NOT NULL,
  downloads INTEGER NOT NULL,
  PRIMARY KEY (ts, host, owner, repo, tag, asset)
) WITHOUT ROWID;
CREATE INDEX IF NOT EXISTS idx_samples_last ON samples(host, owner, repo, tag, asset, ts);
CREATE TABLE IF NOT EXISTS releases (
  host       TEXT    NOT NULL DEFAULT 'github.com',
  owner      TEXT    NOT NULL,
  repo       TEXT    NOT NULL,
  tag        TEXT    NOT NULL,
  published  INTEGER NOT NULL,
  prerelease INTEGER NOT NULL,
  major      INTEGER,
  PRIMARY KEY (host, owner, repo, tag)
) WITHOUT ROWID;
CREATE TABLE IF NOT EXISTS runs (ts INTEGER PRIMARY KEY);
-- Repo-level popularity time series, independent of releases. Change-only like
-- samples: a new row is written only when at least one value changed, and each
-- row is a full snapshot. watchers is GitHub's subscribers_count (the real
-- watch count); the API's watchers_count is a legacy alias of stars and unused.
-- Forgejo and Gitea answer the real watch count as watchers_count.
CREATE TABLE IF NOT EXISTS repo_stats (
  ts       INTEGER NOT NULL,
  host     TEXT    NOT NULL DEFAULT 'github.com',
  owner    TEXT    NOT NULL,
  repo     TEXT    NOT NULL,
  stars    INTEGER NOT NULL,
  forks    INTEGER NOT NULL,
  watchers INTEGER NOT NULL,
  PRIMARY KEY (ts, host, owner, repo)
) WITHOUT ROWID;
CREATE INDEX IF NOT EXISTS idx_repo_stats_last ON repo_stats(host, owner, repo, ts);
-- The ETag of the last 200 answer per request path, and whether that answer
-- linked a next page. A 304 carries no Link header, so the stored flag says
-- whether a release list goes on. The path of a forge request is its URL.
CREATE TABLE IF NOT EXISTS etags (
  path TEXT    PRIMARY KEY,
  etag TEXT    NOT NULL,
  next INTEGER NOT NULL
) WITHOUT ROWID;
-- What GitHub answered for a repository. GitHub redirects the old name of a
-- renamed repository, so name, the full_name of the last 200 answer, is its
-- current owner/repo; NULL after a 404. seen is the last run that sampled it as
-- a target, NULL while it was only asked for its name. A repository gets its row
-- with its first 200 or 404 answer. missing counts the runs in a row that got a
-- 404, since is the first of them, and unreachable is 1 from the
-- UNREACHABLE_RUNS-th on; a 200 or a 304 resets all three. removed is the time
-- the repository was removed from the database, which keeps it from being
-- sampled again.
CREATE TABLE IF NOT EXISTS repos (
  host        TEXT    NOT NULL DEFAULT 'github.com',
  owner       TEXT    NOT NULL,
  repo        TEXT    NOT NULL,
  name        TEXT,
  seen        INTEGER,
  missing     INTEGER NOT NULL DEFAULT 0,
  since       INTEGER,
  unreachable INTEGER NOT NULL DEFAULT 0,
  removed     INTEGER,
  PRIMARY KEY (host, owner, repo)
) WITHOUT ROWID;
$repos_add
$migrate_fill
COMMIT;
SQL
# The copy leaves the pages of the old tables free.
[ "$migrate" = 0 ] || "$SQLITE" -bail "$DB" "VACUUM"

# The slug of a repository: owner/repo on GitHub, host/owner/repo on a forge.
# GitHub names hold no dot, so a first segment with one is a host.
slug_sql="CASE WHEN host = 'github.com' THEN '' ELSE host || '/' END || owner || '/' || repo"

# == Collect current values into a TSV ==
# tsv:  host, owner, repo, tag, asset, downloads, published(ISO), prerelease(0/1), major
# rtsv: host, owner, repo, stars, forks, watchers  (one line per repo, repo_stats)
# esql: one upsert per 200 answer into etags. An ETag starts with a double quote,
#       which .import would take for CSV quoting, so it goes in as an SQL literal.
# nsql: one upsert or update per answer for a repository into repos, as SQL
#       literals for the same reason.
tsv="$(mktemp)"
rtsv="$(mktemp)"
esql="$(mktemp)"
nsql="$(mktemp)"
resp="$(mktemp)"
body="$(mktemp)"
trap 'rm -f "$tsv" "$rtsv" "$esql" "$nsql" "$resp" "$body"' EXIT

declare -A etag=() next_page=() named=() misses=() quiet=()
while IFS=$'\t' read -r p e n; do
	etag["$p"]="$e"; next_page["$p"]="$n"
done < <("$SQLITE" -separator $'\t' "$DB" "SELECT path, etag, next FROM etags")
while read -r slug; do
	named["$slug"]=1
done < <("$SQLITE" "$DB" "SELECT $slug_sql FROM repos")
while IFS=$'\t' read -r slug m; do
	misses["$slug"]="$m"
done < <("$SQLITE" -separator $'\t' "$DB" "SELECT $slug_sql, missing FROM repos WHERE missing > 0")

# Splits a slug into host, owner and repo.
split_slug() {
	local rest="$1"
	case "${1%%/*}" in
		*.*) host="${1%%/*}"; rest="${1#*/}" ;;
		*) host=github.com ;;
	esac
	owner="${rest%%/*}"; repo="${rest#*/}"
}

# The request path of a repository, with the second argument appended: a path
# of the GitHub API, or a URL of the forge's.
api_path() {
	local host owner repo
	split_slug "$1"
	if [ "$host" = github.com ]; then
		printf 'repos/%s/%s%s' "$owner" "$repo" "${2:-}"
	else
		printf 'https://%s/api/v1/repos/%s/%s%s' "$host" "$owner" "$repo" "${2:-}"
	fi
}

# One GET, conditional on the stored ETag of the path. Sets status to the HTTP
# status, empty when no answer came. A 200 leaves its body in $body, sets more to
# whether it links a next page and records its ETag; a 304 takes more from the
# last 200. gh exits non-zero on a 304 too, so the status line decides. A URL
# goes to a forge through curl, which follows redirects as gh does; $resp holds
# the headers either way. A 5xx answer or none is repeated after the pauses of
# RETRY_DELAYS.
failed=() missing=() transient=() unreachable=() given_up=0
request() {
	local path="$1" e n=0 sq="'"
	local -a cond=() pause
	read -ra pause <<<"$RETRY_DELAYS"
	[ -z "${etag[$path]:-}" ] || cond=(-H "If-None-Match: ${etag[$path]}")
	while :; do
		case "$path" in
			https://*)
				status="$(curl -sS -L --max-time 60 "${cond[@]}" -D "$resp" -o "$body" -w '%{http_code}' "$path" 2>/dev/null)" || true
				sed -i 's/\r$//' "$resp"
				[ "$status" != 000 ] || status=''
				;;
			*)
				"$GH" api -i "${cond[@]}" "$path" 2>/dev/null | tr -d '\r' >"$body" || true
				sed -n '1,/^$/p' "$body" >"$resp"
				sed -i '1,/^$/d' "$body"
				status="$(awk 'NR == 1 && /^HTTP\// { print $2 }' "$resp")"
				;;
		esac
		[[ "${status:-5}" == 5* ]] || break
		[ "$given_up" -lt "$RETRY_GIVE_UP" ] || break
		if [ "$n" -ge "${#pause[@]}" ]; then
			given_up=$((given_up + 1))
			break
		fi
		sleep "${pause[n++]}"
	done
	more=0
	case "$status" in
		200)
			grep -qi '^link:.*rel="next"' "$resp" && more=1
			e="$(sed -n 's/^etag: //Ip' "$resp" | head -1)"
			[ -z "$e" ] || printf "INSERT OR REPLACE INTO etags (path, etag, next) VALUES ('%s', '%s', %d);\n" \
				"${path//$sq/$sq$sq}" "${e//$sq/$sq$sq}" "$more" >>"$esql"
			;;
		304)
			more="${next_page[$path]:-0}"
			;;
		404)
			missing+=("$path")
			;;
		5*|'')
			transient+=("$path ${status:-no answer}")
			;;
		*)
			failed+=("$path ${status:-no answer}")
			;;
	esac
}

# The first 20 of the requests given, indented, and how many more there are.
list_requests() {
	printf '  %s\n' "${@:1:20}" >&2
	[ $# -le 20 ] || echo "  ... and $(( $# - 20 )) more" >&2
}

# Records the answer request gave for the repository host, owner, repo in
# repos: a 200 its full_name, a 404 NULL, and seen the run when the fourth
# argument is it, for a target. A 404 counts one more run in a row with a 404,
# a 200 or a 304 ends the count. Any other answer only renews seen of a row
# that exists, and leaves the rest as it was. A 304 carries no name, so a
# repository without a row is asked without its ETag. A repository with a 404
# is reported until it counts as unreachable, and once more as such.
record_repo() {
	local sq="'" seen="$4" n=NULL m=0 since=NULL slug
	local h="${1//$sq/$sq$sq}" o="${2//$sq/$sq$sq}" r="${3//$sq/$sq$sq}"
	if [ "$1" = github.com ]; then slug="$2/$3"; else slug="$1/$2/$3"; fi
	case "$status" in
		200)
			n="$(jq -r '.full_name // empty' "$body")"
			[ -n "$n" ] || return 0
			n="'${n//$sq/$sq$sq}'"
			;;
		404)
			m=$(( ${misses[$slug]:-0} + 1 ))
			since="$ts"
			if [ "$m" -ge "$UNREACHABLE_RUNS" ]; then
				quiet["$slug"]=1
				[ "$m" -gt "$UNREACHABLE_RUNS" ] || unreachable+=("$slug")
			fi
			;;
		304)
			printf "UPDATE repos SET seen = coalesce(%s, seen), missing = 0, since = NULL, unreachable = 0 WHERE host = '%s' AND owner = '%s' AND repo = '%s';\n" \
				"$seen" "$h" "$o" "$r" >>"$nsql"
			return 0
			;;
		*)
			[ "$seen" = NULL ] || printf "UPDATE repos SET seen = %s WHERE host = '%s' AND owner = '%s' AND repo = '%s';\n" \
				"$seen" "$h" "$o" "$r" >>"$nsql"
			return 0
			;;
	esac
	printf "INSERT INTO repos (host, owner, repo, name, seen, missing, since, unreachable) VALUES ('%s', '%s', '%s', %s, %s, %d, %s, %d) ON CONFLICT (host, owner, repo) DO UPDATE SET name = excluded.name, seen = coalesce(excluded.seen, seen), missing = excluded.missing, since = CASE WHEN excluded.missing = 0 THEN NULL ELSE coalesce(since, excluded.since) END, unreachable = excluded.unreachable;\n" \
		"$h" "$o" "$r" "$n" "$seen" "$m" "$since" "$(( m >= UNREACHABLE_RUNS ))" >>"$nsql"
}

# Merge the main config with any targets.d/*.json drop-ins, de-duplicated
# without case, as GitHub resolves names, blank lines dropped, first occurrence
# wins. Both sources are optional; the caller checks that at least one target
# came out.
collect_targets() {
	{
		if [ -f "$CONFIG" ]; then jq -r '.targets[]?' "$CONFIG"; fi
		if [ -d "$TARGETS_DIR" ]; then
			for f in "$TARGETS_DIR"/*.json; do
				[ -e "$f" ] || continue
				jq -r '.targets[]?' "$f"
			done
		fi
	} | awk 'NF && !seen[tolower($0)]++'
}

# Expand a target into slugs: a plain owner lists all its non-archived repos
# on GitHub, an "owner/repo" or "host/owner/repo" passes through unchanged. An
# owner is listed whole on GitHub only.
list_repos() {
	local t="$1"
	if [[ "${t%%/*}" == *.* && "$t" != */*/* ]]; then
		echo "ERROR: $t names no repository; owners are listed whole on GitHub only" >&2
		return 1
	elif [[ "$t" == */* ]]; then
		printf '%s\n' "$t"
	else
		"$GH" repo list "$t" --no-archived --limit 1000 --json nameWithOwner --jq '.[].nameWithOwner'
	fi
}

# Expand every target to owner/repo slugs, then de-duplicate across the whole
# set. This is where a bare owner and an explicit owner/repo pair overlap:
# listing an owner whole (e.g. "ernolf") expands to all its repos, and any of
# those also present as an explicit pair - for instance one carried by the
# generated App Store drop-in - collapses to a single entry, so each repo is
# sampled exactly once. First occurrence wins; order does not matter.
# Slugs are compared without case. A repository the database already holds is
# sampled under the spelling it was sampled first, whatever the targets spell,
# so its series goes on; with several spellings, that is the one gh-stats and
# gh-stats-site-db keep. A repository removed from the database is left out.
# A target that cannot be expanded ends the run before anything is recorded:
# its repositories would otherwise be missing from it and read as unchanged.
known_spellings() {
	"$SQLITE" -separator $'\t' "$DB" "
WITH sp AS (SELECT DISTINCT host, owner, repo FROM releases),
firsts AS (SELECT host, owner, repo,
  (SELECT min(ts) FROM samples s WHERE s.host = sp.host AND s.owner = sp.owner AND s.repo = sp.repo) AS f FROM sp)
SELECT lower($slug_sql), $slug_sql FROM (SELECT host, owner, repo,
  row_number() OVER (PARTITION BY host, lower(owner), lower(repo) ORDER BY f IS NULL, f, owner, repo) AS n
  FROM firsts) WHERE n = 1"
}
removed_slugs() {
	"$SQLITE" "$DB" "SELECT lower($slug_sql) FROM repos WHERE removed IS NOT NULL"
}
collect_slugs() {
	while read -r target; do
		[ -n "$target" ] || continue
		list_repos "$target" || { echo "ERROR: cannot list the repositories of $target" >&2; exit 1; }
	done <<< "$(collect_targets)" \
		| awk -F'\t' 'FILENAME == ARGV[1] { known[$1] = $2; next } FILENAME == ARGV[2] { removed[$1]; next }
			NF && !seen[k = tolower($0)]++ && !(k in removed) { print ((k in known) ? known[k] : $0) }' \
			<(known_spellings) <(removed_slugs) -
}

slugs="$(collect_slugs)"
[ -n "$slugs" ] || { echo "ERROR: no targets found in $CONFIG or $TARGETS_DIR/*.json" >&2; exit 1; }

# A forge host is sampled only when it answers its version as Forgejo and Gitea
# do. Another host, or one that hides its API behind a bot check, cannot be
# sampled; its repositories are reported and left out, so the run goes on.
no_forge=''
while read -r h; do
	curl -sS -L --max-time 30 "https://$h/api/v1/version" 2>/dev/null | jq -e '.version | strings' >/dev/null 2>&1 \
		|| no_forge+="$h"$'\n'
done < <(sed -n 's#^\([^/]*\.[^/]*\)/.*#\1#p' <<<"$slugs" | sort -u)
if [ -n "$no_forge" ]; then
	echo "hosts without a Forgejo or Gitea API, their repositories are not sampled:" >&2
	printf '%s' "$no_forge" | sed 's/^/  /' >&2
	slugs="$(awk -F/ 'FILENAME == ARGV[1] { skip[$0]; next } !($1 in skip)' <(printf '%s' "$no_forge") - <<<"$slugs")"
fi

# The repositories the database holds that are no target and were never asked
# for their name: each is asked once, so one that was renamed is found under
# the name it has now. One on a host without a forge API stays unasked.
unasked="$("$SQLITE" "$DB" "
SELECT DISTINCT $slug_sql FROM releases r
 WHERE NOT EXISTS (SELECT 1 FROM repos n WHERE n.host = r.host AND n.owner = r.owner AND n.repo = r.repo)" \
	| awk -F/ 'FILENAME == ARGV[1] { t[tolower($0)]; next } FILENAME == ARGV[2] { skip[$0]; next }
		NF && !(tolower($0) in t) && !($1 in skip)' <(printf '%s\n' "$slugs") <(printf '%s' "$no_forge") -)"

# A run asks twice per repo, once more for every further page a release list
# had last time and once per repository asked for its name; that a 304 costs
# nothing is known only afterwards. A run that ran out halfway would leave the
# rest of the repos reading as unchanged, so with less budget than that it does
# not start, and records no run. Only the GitHub requests count; a forge
# request its host refuses is reported as failed.
budget="$("$GH" api rate_limit --jq '.resources.core | "\(.remaining) \(.reset)"' 2>/dev/null)" \
	|| { echo "ERROR: cannot read the API budget" >&2; exit 1; }
read -r remaining reset <<<"$budget"
on_github() { grep -v '^[^/]*\.' <<<"$1" | grep -c . || true; }
needed=$(( 2 * $(on_github "$slugs") + $(on_github "$unasked") ))
for p in "${!next_page[@]}"; do
	[[ "$p" == https://* || "${next_page[$p]}" != 1 ]] || needed=$((needed + 1))
done
if [ "$remaining" -lt "$needed" ]; then
	echo "skipped: $remaining API requests left, the run needs up to $needed; the budget resets at $(date -u -d "@$reset" +%H:%M) UTC" >&2
	exit 0
fi

while read -r slug; do
	[ -n "$slug" ] || continue
	split_slug "$slug"
	# One call per repo for the popularity snapshot, before the releases: a
	# repository that answers 404 has no releases to ask for. watchers is
	# subscribers_count on GitHub and watchers_count on a forge (the real watch
	# count of each); the select guards against an error object (no star count)
	# so a failed call adds no row.
	path="$(api_path "$slug")"
	[ -n "${named[$slug]:-}" ] || unset "etag[$path]"
	request "$path"
	[ "$status" != 200 ] || jq -r --arg h "$host" --arg o "$owner" --arg r "$repo" '
		if $h == "github.com" then [.stargazers_count, .forks_count, .subscribers_count]
		else [.stars_count, .forks_count, .watchers_count] end
		| select(.[0] != null)
		| [$h, $o, $r] + .
		| @tsv' "$body" >> "$rtsv" || true
	record_repo "$host" "$owner" "$repo" "$ts"
	[ "$status" != 404 ] || continue
	# One request per page; jq derives major from the tag. Forgejo and Gitea
	# answer the release fields of GitHub, at most 50 items per page.
	if [ "$host" = github.com ]; then per_page="per_page=100"; else per_page="limit=50"; fi
	page=1
	while :; do
		request "$(api_path "$slug" "/releases?${per_page}&page=${page}")"
		[ "$status" != 200 ] || jq -r --arg h "$host" --arg o "$owner" --arg r "$repo" '
			(if type == "array" then .[] else empty end)
			| .tag_name as $rawtag
			# A release published without a git tag gets GitHub auto tag
			# untagged-<sha>; the real version the maintainer typed sits in the
			# release title (.name at release level), so prefer that when present.
			| (if ($rawtag | startswith("untagged-")) and ((.name // "") != "")
			   then .name else $rawtag end) as $tag
			| .published_at as $pub
			| (if .prerelease then 1 else 0 end) as $pre
			| (($tag | capture("^[vV]?(?<m>[0-9]+)") | .m) // "") as $maj
			| .assets[]
			| [$h, $o, $r, $tag, .name, .download_count, $pub, $pre, $maj]
			| @tsv' "$body" >> "$tsv" || true
		[ "$more" = 1 ] || break
		page=$((page + 1))
	done
done <<< "$slugs"

while read -r slug; do
	[ -n "$slug" ] || continue
	split_slug "$slug"
	path="$(api_path "$slug")"
	unset "etag[$path]"
	request "$path"
	record_repo "$host" "$owner" "$repo" NULL
done <<< "$unasked"

# == Apply: release meta (upsert-ignore) + change-only samples + run marker ==
"$SQLITE" "$DB" <<SQL
CREATE TEMP TABLE incoming (
  host TEXT, owner TEXT, repo TEXT, tag TEXT, asset TEXT,
  downloads INTEGER, published TEXT, prerelease INTEGER, major INTEGER
);
CREATE TEMP TABLE incoming_repo (
  host TEXT, owner TEXT, repo TEXT, stars INTEGER, forks INTEGER, watchers INTEGER
);
.mode tabs
.import "$tsv" incoming
.import "$rtsv" incoming_repo

BEGIN;

INSERT OR IGNORE INTO releases (host, owner, repo, tag, published, prerelease, major)
SELECT DISTINCT host, owner, repo, tag,
       CAST(strftime('%s', published) AS INTEGER), prerelease, major
FROM incoming;

INSERT INTO samples (ts, host, owner, repo, tag, asset, downloads)
SELECT $ts, i.host, i.owner, i.repo, i.tag, i.asset, i.downloads
FROM incoming i
WHERE i.downloads <> COALESCE(
        (SELECT s.downloads FROM samples s
         WHERE s.host=i.host AND s.owner=i.owner AND s.repo=i.repo AND s.tag=i.tag AND s.asset=i.asset
         ORDER BY s.ts DESC LIMIT 1), -1);

-- Change-only repo popularity: write a snapshot only when the incoming triple
-- differs from this repo's latest stored one (or none exists yet).
INSERT INTO repo_stats (ts, host, owner, repo, stars, forks, watchers)
SELECT $ts, i.host, i.owner, i.repo, i.stars, i.forks, i.watchers
FROM incoming_repo i
WHERE NOT EXISTS (
        SELECT 1 FROM repo_stats s
         WHERE s.host=i.host AND s.owner=i.owner AND s.repo=i.repo
           AND s.ts=(SELECT max(z.ts) FROM repo_stats z
                     WHERE z.host=i.host AND z.owner=i.owner AND z.repo=i.repo)
           AND s.stars=i.stars AND s.forks=i.forks AND s.watchers=i.watchers);

-- The ETags go in with the data they describe: a run that does not commit keeps
-- the old ones, so its 200 answers are asked for again.
.read "$esql"
.read "$nsql"

INSERT OR IGNORE INTO runs (ts) VALUES ($ts);

COMMIT;
SQL

# A 404 means the repository was deleted, renamed away or made private: there
# is nothing left to sample, so it is reported without failing the run, until it
# counts as unreachable.
if [ ${#missing[@]} -gt 0 ]; then
	mapfile -t gone < <(printf '%s\n' "${missing[@]}" \
		| sed -E 's#^https://([^/]+)/api/v1/repos/([^/]+/[^/?]+).*#\1/\2#; s#^repos/([^/]+/[^/?]+).*#\1#' \
		| sort -u | awk 'FILENAME == ARGV[1] { q[$0]; next } NF && !($0 in q)' <(printf '%s\n' "${!quiet[@]}") -)
	if [ ${#gone[@]} -gt 0 ]; then
		echo "repositories not found (404):" >&2
		printf '  %s\n' "${gone[@]}" >&2
	fi
fi
if [ ${#unreachable[@]} -gt 0 ]; then
	echo "repositories unreachable from now on, after $UNREACHABLE_RUNS runs in a row with a 404:" >&2
	printf '  %s\n' "${unreachable[@]}" >&2
fi

# A request that got neither a 200 nor a 304 left its repo reading as unchanged
# in this run, so it is reported rather than dropped. A server error or a
# missing answer that outlasted its repetitions is mostly a passing fault of the
# host, and the next run asks again, so it does not fail the run; any other
# answer points at the token or the budget, which the next run does not mend.
if [ ${#transient[@]} -gt 0 ]; then
	echo "${#transient[@]} API requests got a server error or no answer, the next run asks again:" >&2
	list_requests "${transient[@]}"
fi
if [ ${#failed[@]} -gt 0 ]; then
	echo "${#failed[@]} API requests failed:" >&2
	list_requests "${failed[@]}"
	exit 1
fi
