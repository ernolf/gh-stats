#!/usr/bin/env -S LC_CTYPE=C.UTF-8 LC_MESSAGES=C bash
# SPDX-FileCopyrightText: 2026 [ernolf] Raphael Gradenwitz <raphael.gradenwitz@googlemail.com>
# SPDX-License-Identifier: MIT
#
# gh-stats-data-prune - thin the measurement results of the data branch to what
# the site reads. The results lie as gh-nc-appsdiag lays out its logs, one run
# directory per measurement below the directory of its version, named by its
# timestamp. A version measured again keeps only its newest run, as the site
# shows no other; the older runs are removed. Of an app, only its newest stable
# version keeps the large reports; every other version keeps the small results
# the site shows for an older release. With --lines, the versions of release
# lines beyond the given number of lines before the newest are removed.
# The tool works on a checkout and commits nothing; the workflows that write
# the data branch run it before they commit.

set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

usage() {
	cat <<'EOF'
Usage: gh-stats-data-prune [--in-place] [--lines <n>] <dir>

Thins the measurement results below <dir>, the directory apps/ of a checkout of
the data branch:

  - of every version measured more than once, only the newest run directory
    stays
  - of every app, only its newest stable version keeps all its results; the
    run of any other version keeps summary.json, changelog-lint.json,
    php-compat.json and release/diff.json, each also as <name>.gz
  - with --lines, of every app only the versions of its newest release line and
    of the <n> lines before it stay; a release line is the major.minor of a
    stable version, and a version that is not stable stays

An app is the directory that holds the version directories. One without a
stable version keeps all its results.

Without --in-place nothing is removed: the tool counts the run directories and
what it would remove, and the size that takes.

      --in-place   remove them
      --lines <n>  remove the release lines beyond <n> before the newest
  -h, --help       this text
EOF
}

dir='' inplace=0 lines=''
while [ $# -gt 0 ]; do
	case "$1" in
		-h|--help) usage; exit 0 ;;
		--in-place) inplace=1 ;;
		--lines)
			[ $# -ge 2 ] || die "$1 needs a number"
			[[ "$2" =~ ^[0-9]+$ ]] || die "not a number of lines: $2"
			lines="$2"; shift ;;
		-*) echo "unknown argument: $1" >&2; exit 1 ;;
		*) [ -z "$dir" ] || die "only one directory"; dir="$1" ;;
	esac
	shift
done

[ -n "$dir" ] || { usage >&2; exit 1; }
[ -d "$dir" ] || die "no directory at $dir"

mib() { awk -v b="$1" 'BEGIN { printf "%.1f MiB", b / 1048576 }'; }

# == Older runs ==
# A run directory is one with a summary.json. Its timestamp name has a fixed
# width, so sorted by path the runs of a version follow one another, oldest
# first, and each run that a newer one of the same version follows is stale.
mapfile -d '' runs < <(find "$dir" -name summary.json -printf '%h\0' | LC_ALL=C sort -z)
stale=() current=() prev=''
for run in "${runs[@]}"; do
	if [ -n "$prev" ] && [ "${prev%/*}" = "${run%/*}" ]; then
		stale+=("$prev")
	elif [ -n "$prev" ]; then
		current+=("$prev")
	fi
	prev="$run"
done
[ -z "$prev" ] || current+=("$prev")

# == Versions ==
# Each current run as "<app>\t<version>\t<run>", the stable versions of an app
# newest first. The first of them is the newest of the app, and each new
# major.minor below it starts the next line. Every other run of an app with a
# stable version is slimmed, and with --lines a stable one beyond the lines is
# removed.
gone=() slim=()
while IFS=$'\t' read -r what run; do
	case "$what" in
		gone) gone+=("$run") ;;
		slim) slim+=("$run") ;;
	esac
done < <(
	for run in "${current[@]}"; do
		version="${run%/*}"
		printf '%s\t%s\t%s\n' "${version%/*}" "${version##*/}" "$run"
	done | LC_ALL=C sort -t $'\t' -k1,1 -k2,2Vr | awk -F '\t' -v lines="$lines" '
		function stable(v) { return v ~ /^[0-9]+(\.[0-9]+)*$/ }
		function line(v,   p) { split(v, p, "."); return p[1] "." p[2] }
		$1 != app { flush(); app = $1; n = 0; newest = ""; seen = ""; count = 0 }
		{ ver[++n] = $2; dir[n] = $3 }
		stable($2) && newest == "" { newest = $2 }
		END { flush() }
		function flush(   i, l) {
			if (newest == "") return
			for (i = 1; i <= n; i++) {
				if (stable(ver[i])) {
					l = line(ver[i])
					if (l != seen) { seen = l; count++ }
					if (lines != "" && count > lines + 1) { print "gone\t" dir[i]; continue }
				}
				if (ver[i] != newest) print "slim\t" dir[i]
			}
		}'
)

# The files of a slimmed run that go: all but the small results.
large() {
	find "$@" -type f ! -name summary.json ! -name 'changelog-lint.json*' \
		! -name 'php-compat.json*' ! -path '*/release/diff.json*'
}

before="$(du -sb "$dir" | cut -f1)"
freed=0
[ ${#stale[@]} -eq 0 ] || freed="$(du -scb "${stale[@]}" | tail -1 | cut -f1)"
echo "${#runs[@]} runs, ${#stale[@]} older runs of a version measured again, $(mib "$freed")"
if [ -n "$lines" ]; then
	freed=0
	[ ${#gone[@]} -eq 0 ] || freed="$(du -scb "${gone[@]}" | tail -1 | cut -f1)"
	echo "${#gone[@]} versions beyond $lines release lines before the newest, $(mib "$freed")"
fi
files=() freed=0
[ ${#slim[@]} -eq 0 ] || mapfile -d '' files < <(large "${slim[@]}" -print0)
[ ${#files[@]} -eq 0 ] || freed="$(du -cb "${files[@]}" | tail -1 | cut -f1)"
echo "${#files[@]} large reports of versions that are not the newest of their app, $(mib "$freed")"

if [ "$inplace" -eq 0 ]; then
	echo "nothing removed; --in-place removes them"
	exit 0
fi
[ ${#stale[@]} -eq 0 ] || rm -rf -- "${stale[@]}"
[ ${#gone[@]} -eq 0 ] || rm -rf -- "${gone[@]}"
[ ${#files[@]} -eq 0 ] || rm -f -- "${files[@]}"
# A directory whose files all went goes with them, up to the app.
find "$dir" -mindepth 1 -type d -empty -delete
echo "$dir: $(mib "$before") before, $(mib "$(du -sb "$dir" | cut -f1)") after"
