#
# Site config shared by all tools in bin/. Install it as
# /etc/gh-stats/gh-stats.env, or point GH_STATS_ENV at another path. Every line
# is optional and shows the built-in default; precedence is built-in default <
# this file < environment.

# -- gh-release-sampler, gh-stats --
#GH_STATS_CONFIG=/etc/gh-stats/targets.json
#GH_STATS_TARGETS_DIR=/etc/gh-stats/targets.d
#GH_STATS_DIR=/var/lib/gh-stats
#GH_STATS_DB=/var/lib/gh-stats/downloads.sqlite
#GH_BIN=/usr/bin/gh
#SQLITE_BIN=/usr/bin/sqlite3

# -- gh-appstore-targets, nc-appslist --
# Where the App Store catalogue comes from: download, appdata or ebtb.
#APPSTORE_SOURCE=download
#APPSTORE_TARGETS_FILE=/etc/gh-stats/targets.d/appstore.json
#APPSTORE_WHOLE_OWNERS=nextcloud-releases
# Keep a repository only if its newest release is from this year or later
# (default: last year).
#APPSTORE_SINCE_YEAR=2025
# download source
#APPSTORE_URL=https://apps.nextcloud.com/api/v1/apps.json
#APPSTORE_CACHE=/var/lib/gh-stats/apps.json
#APPSTORE_INCLUDE_ENTERPRISE=true
# appdata source: the file itself, or a working occ command to derive it from
#APPSTORE_APPDATA_FILE=
#APPSTORE_OCC=
# ebtb source: the nc-apps apps.db
#APPSTORE_EBTB_DB=

# -- nc-appslist --
#APPLIST_RELEASE_REPOS="nextcloud-releases christianlupus-nextcloud/cookbook-releases"
#APPLIST_FILE=$HOME/Projekte/appstorestats/apps-all.txt

# -- nc-appsdiag --
#NC_APPSDIAG_DIR=$HOME/Projekte/appstorestats
#NC_APPSDIAG_CHECKOUTS=$HOME/Projekte/appstorestats/checkouts
#NC_APPSDIAG_LOGS=$HOME/Projekte/appstorestats/logs
#NC_APPSDIAG_NCMAKE_REPO=https://github.com/ernolf/ncmake.git
#NC_APPSDIAG_STUB_URL=https://raw.githubusercontent.com/ernolf/ncmake/main/bootstrap/Makefile
